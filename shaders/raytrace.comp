#version 460
#extension GL_EXT_ray_query : require

// One thread per pixel, in 8x8 tiles.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1, rgba8) uniform writeonly image2D outColor;
layout(binding = 2, r32f) uniform writeonly image2D outDepth;  // hit distance along the ray, 0 = miss

// Must match RayTracingPushConstants in Application.h
layout(push_constant) uniform PushConstants {
    vec4 cameraPosition;
    vec4 cameraForward;
    vec4 cameraRight;
    vec4 cameraUp;
    vec2 jitter;        // sub-pixel offset in pixels, (0,0) until DLSS
    float tanHalfFov;   // tan(verticalFov / 2)
    float aspectRatio;  // width / height
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outColor);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;  // the last tiles can stick out past the image edge
    }

    // Pixel -> [-1, 1] on both axes. Image y goes down, camera up goes up, hence the minus.
    vec2 uv = (vec2(pixel) + 0.5 + pc.jitter) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    vec3 direction = normalize(pc.cameraForward.xyz
                             + ndc.x * pc.tanHalfFov * pc.aspectRatio * pc.cameraRight.xyz
                             - ndc.y * pc.tanHalfFov * pc.cameraUp.xyz);

    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, tlas, gl_RayFlagsOpaqueEXT, 0xFF,
                          pc.cameraPosition.xyz, 0.001, direction, 1000.0);
    while (rayQueryProceedEXT(rayQuery)) {
        // Only needed for non-opaque geometry (alpha cutouts, Phase 6).
    }

    vec3 color;
    float depth = 0.0;
    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        // Barycentrics give the weights of vertex 1 and 2; vertex 0 gets the rest.
        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
        color = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);
        depth = rayQueryGetIntersectionTEXT(rayQuery, true);
    } else {
        color = mix(vec3(0.10, 0.12, 0.18), vec3(0.02, 0.02, 0.04), uv.y);  // dark background gradient
    }

    imageStore(outColor, pixel, vec4(color, 1.0));
    imageStore(outDepth, pixel, vec4(depth));
}
