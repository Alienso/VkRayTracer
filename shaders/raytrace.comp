#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

// One thread per pixel, in 8x8 tiles.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1, rgba8) uniform writeonly image2D outColor;
layout(binding = 2, r32f) uniform writeonly image2D outDepth;     // hit distance along the ray, 0 = miss
layout(binding = 6, rgba32f) uniform image2D accumulationImage;  // running average over frames

// Must match SceneUniforms in Application.h
layout(binding = 3) uniform SceneUniforms {
    vec4 cameraPosition;
    vec4 cameraForward;
    vec4 cameraRight;
    vec4 cameraUp;
    vec2 jitter;            // sub-pixel offset in pixels, (0,0) until DLSS
    float tanHalfFov;       // tan(verticalFov / 2)
    float aspectRatio;      // width / height
    vec4 sunDirection;      // xyz: normalized direction TOWARDS the sun, w: cos(angular radius of the sun disc)
    vec4 sunColor;          // rgb: color * intensity (light arriving at a surface facing the sun)
    vec4 skyZenithColor;    // rgb, already multiplied by the sky intensity
    vec4 skyHorizonColor;
    vec4 groundColor;       // environment below the horizon
    uint samplesPerPixel;
    uint maxBounces;        // number of surfaces a path may hit
    uint frameIndex;        // changes every frame, seeds the random numbers
    uint shadowsEnabled;
    uint accumulatedFrames; // frames already averaged into accumulationImage (0 = start over)
    uint accumulate;        // 0 = show only this frame
    float exposure;         // brightness multiplier applied before tone mapping
    uint toneMapping;       // 0 = clamp, 1 = ACES filmic curve
    uint debugView;         // 0 = path traced, otherwise one property of the first hit, see DebugView in Application.h
    uint emissiveTriangleCount;
    uint emissiveSampling;  // 0 = bounces only, 1 = light sampling only, 2 = both with MIS
} scene;

// Must match SceneVertex in ModelLoader.h. Scalar layout = tightly packed like in C++.
struct Vertex {
    vec3 position;
    vec3 normal;
    vec2 uv;
    vec4 tangent;   // xyz: direction in which U grows, w: +-1 bitangent sign
};

// Must match MeshInfo in Application.h. All meshes share the vertex and index buffers;
// this says where one mesh's part starts. Indices are relative to the mesh's first vertex.
struct MeshInfo {
    uint materialIndex;
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint indexCount;
    uint hasNormals;
    uint hasTangents;
};

layout(binding = 4, scalar) readonly buffer Vertices { Vertex vertices[]; };
layout(binding = 5, scalar) readonly buffer Indices { uint indices[]; };
layout(binding = 7, scalar) readonly buffer MeshInfos { MeshInfo meshInfos[]; };

// Must match GpuMaterial in Application.h. Each value is a constant, multiplied by its texture if the index is >= 0.
struct Material {
    vec4 baseColor;         // linear RGB + alpha
    vec3 emissive;          // light given off, already multiplied by the strength
    float metallic;
    float roughness;
    float transmission;
    float ior;
    float alphaCutoff;
    uint alphaMode;         // 0 opaque, 1 mask, 2 blend
    int baseColorTexture;
    int metallicRoughnessTexture;  // G: roughness, B: metallic
    int transmissionTexture;       // R: transmission
    int emissiveTexture;
    int normalTexture;             // RGB: direction in tangent space (X along U, Y along "up" in the image, Z out)
    float normalScale;
};
layout(binding = 9, scalar) readonly buffer Materials { Material materials[]; };

// Must match EmissiveTriangle in Application.h. Every triangle of every glowing instance, in world space.
struct EmissiveTriangle {
    vec3 p0, p1, p2;
    vec2 uv0, uv1, uv2;
    uint materialIndex;
    float probability;      // chance that light sampling picks this triangle
    float cdf;              // running sum of the probabilities, for the binary search
    float area;
};
layout(binding = 10, scalar) readonly buffer EmissiveTriangles { EmissiveTriangle emissiveTriangles[]; };
// Per TLAS instance: where its triangles start in emissiveTriangles, or -1 if it doesn't glow.
layout(binding = 11, scalar) readonly buffer InstanceFirstLight { int instanceFirstLight[]; };

const uint EMISSIVE_BOUNCES_ONLY = 0;
const uint EMISSIVE_LIGHT_SAMPLING = 1;
const uint EMISSIVE_MIS = 2;

// All textures of all models in one array. Neighboring pixels can hit different materials, so the
// index differs between the threads of a warp: nonuniformEXT tells the compiler to handle that.
layout(binding = 8) uniform sampler2D textures[];

const float PI = 3.14159265359;

// ---------------------------------------------------------------------------------------------
// Random numbers (PCG hash)

uint pcgHash(uint value) {
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) / 4294967295.0;
}

// Uniformly distributed direction on the unit sphere.
vec3 randomUnitVector(inout uint seed) {
    float z = randomFloat(seed) * 2.0 - 1.0;
    float phi = randomFloat(seed) * 2.0 * PI;
    float r = sqrt(max(1.0 - z * z, 0.0));
    return vec3(r * cos(phi), r * sin(phi), z);
}

// Any two vectors perpendicular to n (and to each other).
void buildBasis(vec3 n, out vec3 tangent, out vec3 bitangent) {
    vec3 helper = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    tangent = normalize(cross(helper, n));
    bitangent = cross(n, tangent);
}

// Uniformly distributed direction inside a cone around `axis`. cosMaxAngle = 1 gives `axis` itself.
vec3 randomDirectionInCone(vec3 axis, float cosMaxAngle, inout uint seed) {
    float cosTheta = mix(1.0, cosMaxAngle, randomFloat(seed));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    float phi = randomFloat(seed) * 2.0 * PI;
    vec3 tangent, bitangent;
    buildBasis(axis, tangent, bitangent);
    return normalize(tangent * (sinTheta * cos(phi)) + bitangent * (sinTheta * sin(phi)) + axis * cosTheta);
}

// ---------------------------------------------------------------------------------------------
// Tracing

struct Hit {
    bool found;
    float t;                // distance along the ray
    vec3 position;          // world space
    vec3 normal;            // world space, facing the ray. Smooth (interpolated) if the mesh has normals: use for lighting.
    vec3 geometricNormal;   // world space, facing the ray. The triangle's real plane: use to offset new rays.
    vec3 tangent;           // world space, only for the debug view
    vec2 uv;
    uint meshIndex;
    uint materialIndex;
    int lightIndex;         // this triangle in emissiveTriangles, -1 if it doesn't glow

    // Material at this point (constants * textures)
    vec3 albedo;            // base color
    float alpha;
    float metallic;
    float roughness;
    float transmission;
    float ior;
    vec3 emissive;
};

// A compute shader has no screen-space derivatives to choose a mip level, so always read the full-resolution
// level. Distant textures would alias, but the random pixel offsets + accumulation average that out.
vec4 sampleTexture(int index, vec2 uv) {
    return textureLod(textures[nonuniformEXT(index)], uv, 0.0);
}

void evaluateMaterial(inout Hit hit) {
    Material material = materials[hit.materialIndex];

    vec4 baseColor = material.baseColor;
    if (material.baseColorTexture >= 0) {
        baseColor *= sampleTexture(material.baseColorTexture, hit.uv);
    }
    hit.albedo = baseColor.rgb;
    hit.alpha = baseColor.a;

    hit.metallic = material.metallic;
    hit.roughness = material.roughness;
    if (material.metallicRoughnessTexture >= 0) {
        vec4 metallicRoughness = sampleTexture(material.metallicRoughnessTexture, hit.uv);
        hit.roughness *= metallicRoughness.g;
        hit.metallic *= metallicRoughness.b;
    }

    hit.transmission = material.transmission;
    if (material.transmissionTexture >= 0) {
        hit.transmission *= sampleTexture(material.transmissionTexture, hit.uv).r;
    }
    hit.ior = material.ior;

    hit.emissive = material.emissive;
    if (material.emissiveTexture >= 0) {
        hit.emissive *= sampleTexture(material.emissiveTexture, hit.uv).rgb;
    }
}

Hit traceClosest(vec3 origin, vec3 direction) {
    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, tlas, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.001, direction, 1000.0);
    while (rayQueryProceedEXT(rayQuery)) {
        // Only needed for non-opaque geometry (alpha cutouts, Phase 6).
    }

    Hit hit;
    hit.found = rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
    if (!hit.found) {
        return hit;
    }

    // The ray query only tells us WHICH instance and triangle was hit and WHERE on it (barycentrics).
    // Everything else we look up in our own buffers. The custom index was set to the mesh index in the TLAS.
    hit.meshIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
    MeshInfo mesh = meshInfos[hit.meshIndex];
    int primitive = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);
    uint firstIndex = mesh.indexOffset + uint(primitive) * 3;
    int firstLight = instanceFirstLight[rayQueryGetIntersectionInstanceIdEXT(rayQuery, true)];
    hit.lightIndex = firstLight >= 0 ? firstLight + primitive : -1;
    Vertex v0 = vertices[mesh.vertexOffset + indices[firstIndex + 0]];
    Vertex v1 = vertices[mesh.vertexOffset + indices[firstIndex + 1]];
    Vertex v2 = vertices[mesh.vertexOffset + indices[firstIndex + 2]];

    vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
    vec3 weights = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);

    hit.t = rayQueryGetIntersectionTEXT(rayQuery, true);
    hit.position = origin + direction * hit.t;
    hit.uv = v0.uv * weights.x + v1.uv * weights.y + v2.uv * weights.z;
    hit.materialIndex = mesh.materialIndex;
    evaluateMaterial(hit);

    // Normals are transformed with the inverse transpose of the object's matrix;
    // n * M == transpose(M) * n, and M (world -> object) is already the inverse.
    mat3 worldToObject = mat3(rayQueryGetIntersectionWorldToObjectEXT(rayQuery, true));

    // Flat normal from the triangle's edges
    vec3 objectNormal = cross(v1.position - v0.position, v2.position - v0.position);
    hit.geometricNormal = normalize(objectNormal * worldToObject);

    // Smooth normal: the per-vertex normals from the file, blended across the triangle. Makes a coarse
    // mesh look round. Without them, fall back to the flat one.
    hit.tangent = vec3(0.0);
    if (mesh.hasNormals != 0) {
        vec3 smoothNormal = v0.normal * weights.x + v1.normal * weights.y + v2.normal * weights.z;
        hit.normal = normalize(smoothNormal * worldToObject);

        // Normal map: a texture of small surface directions (bumps, scratches, seams) that don't exist in the
        // geometry. They are stored relative to the surface: X along the tangent, Y along the bitangent, Z along
        // the normal. Tangents are directions ON the surface, so they transform like positions, not like normals.
        Material material = materials[mesh.materialIndex];
        if (mesh.hasTangents != 0) {
            vec4 tangent = v0.tangent * weights.x + v1.tangent * weights.y + v2.tangent * weights.z;
            mat3 objectToWorld = mat3(rayQueryGetIntersectionObjectToWorldEXT(rayQuery, true));
            vec3 t = objectToWorld * tangent.xyz;
            t = normalize(t - hit.normal * dot(hit.normal, t));  // interpolation bends it slightly off the surface
            hit.tangent = t;

            if (material.normalTexture >= 0) {
                // A mirrored instance (negative scale) flips the bitangent as well
                float sign = (tangent.w < 0.0 ? -1.0 : 1.0) * (determinant(objectToWorld) < 0.0 ? -1.0 : 1.0);
                vec3 b = cross(hit.normal, t) * sign;
                vec3 mapped = sampleTexture(material.normalTexture, hit.uv).rgb * 2.0 - 1.0;  // [0,1] -> [-1,1]
                mapped.xy *= material.normalScale;
                hit.normal = normalize(t * mapped.x + b * mapped.y + hit.normal * mapped.z);
            }
        }
        // The vertex normals define which side is "outside"; the winding order may disagree.
        if (dot(hit.geometricNormal, hit.normal) < 0.0) {
            hit.geometricNormal = -hit.geometricNormal;
        }
    } else {
        hit.normal = hit.geometricNormal;
    }

    // Triangles are double-sided: if we hit the back, flip both normals towards the ray.
    if (dot(hit.geometricNormal, direction) > 0.0) {
        hit.geometricNormal = -hit.geometricNormal;
        hit.normal = -hit.normal;
    }
    return hit;
}

// Is anything in the way? Stops at the first hit, which is all a shadow needs.
bool isOccluded(vec3 origin, vec3 direction, float maxDistance) {
    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                          origin, 0.001, direction, maxDistance);
    while (rayQueryProceedEXT(rayQuery)) { }
    return rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// Light coming from the environment in a direction: a sky gradient above the horizon, ground below.
// The sun is NOT part of it, it is handled separately with shadow rays (see main).
vec3 environmentLight(vec3 direction) {
    float skyT = pow(smoothstep(0.0, 0.4, direction.y), 0.35);
    vec3 sky = mix(scene.skyHorizonColor.rgb, scene.skyZenithColor.rgb, skyT);
    float groundToSky = smoothstep(-0.01, 0.0, direction.y);
    return mix(scene.groundColor.rgb, sky, groundToSky);
}

// ---------------------------------------------------------------------------------------------
// Light sampling for glowing surfaces, and multiple importance sampling (MIS)
//
// There are two ways to find the light a glowing triangle sends to a surface point:
//  a) bounce sampling: the bounce ray happens to hit it. Good for big lights, bad for small ones (rarely hit).
//  b) light sampling: pick a random point on a random glowing triangle and send a shadow ray there.
//     Good for small lights, bad for big ones close by (points near the edge get picked at grazing angles).
// Both are correct on their own. MIS uses both and weights each sample by how likely its own method was to
// produce it compared to the other one, so each method mostly contributes where it is strong, and the
// light is still counted exactly once in total.
//
// A "pdf" (probability density) below is: how likely is a method to pick this exact direction. Comparing them
// needs the same unit for both, so both are expressed per solid angle (per unit of direction).

// Power heuristic: the usual MIS weight. Gives the sample almost entirely to the method that was much more
// likely to produce it.
float misWeight(float pdfThis, float pdfOther) {
    float a = pdfThis * pdfThis;
    float b = pdfOther * pdfOther;
    return a + b > 0.0 ? a / (a + b) : 0.0;
}

// pdf (per solid angle) of light sampling choosing the point `distance` away on triangle `light`, seen at
// `cosLight` (angle between the triangle's normal and the direction towards the surface point).
// Per area it is probability / area; a small patch far away or seen edge-on covers a small solid angle,
// hence distance^2 / cos to convert.
float lightPdf(int lightIndex, float distance, float cosLight) {
    EmissiveTriangle light = emissiveTriangles[lightIndex];
    return light.probability / max(light.area, 1e-12) * distance * distance / max(cosLight, 1e-6);
}

vec3 emissionAt(uint materialIndex, vec2 uv) {
    Material material = materials[materialIndex];
    vec3 emission = material.emissive;
    if (material.emissiveTexture >= 0) {
        emission *= sampleTexture(material.emissiveTexture, uv).rgb;
    }
    return emission;
}

// Light sampling at a matte surface point: returns the light from one randomly picked point on the glowing
// triangles, already multiplied by the surface's response (albedo / PI * cos) and its MIS weight.
vec3 sampleEmissiveLight(Hit hit, vec3 surfacePoint, inout uint seed) {
    // 1: pick a triangle: binary search for the first one whose running sum exceeds a random number.
    //    Triangles with a bigger share of the total light cover a bigger stretch of [0, 1], so get picked more.
    float pick = randomFloat(seed);
    uint low = 0, high = scene.emissiveTriangleCount - 1;
    while (low < high) {
        uint middle = (low + high) / 2;
        if (emissiveTriangles[middle].cdf < pick) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    EmissiveTriangle light = emissiveTriangles[low];

    // 2: a uniformly random point on it (the square root keeps points from bunching up in one corner)
    float r1 = sqrt(randomFloat(seed));
    float r2 = randomFloat(seed);
    vec3 weights = vec3(1.0 - r1, r1 * (1.0 - r2), r1 * r2);
    vec3 lightPoint = light.p0 * weights.x + light.p1 * weights.y + light.p2 * weights.z;
    vec2 lightUv = light.uv0 * weights.x + light.uv1 * weights.y + light.uv2 * weights.z;

    vec3 toLight = lightPoint - surfacePoint;
    float distance = length(toLight);
    vec3 direction = toLight / distance;
    float cosSurface = dot(hit.normal, direction);
    vec3 lightNormal = normalize(cross(light.p1 - light.p0, light.p2 - light.p0));
    float cosLight = abs(dot(lightNormal, direction));  // glowing triangles shine from both sides, like everything we hit
    if (cosSurface <= 0.0 || cosLight <= 1e-6 || dot(hit.geometricNormal, direction) <= 0.0) {
        return vec3(0.0);  // the light is behind the surface, or seen exactly edge-on
    }

    vec3 emission = emissionAt(light.materialIndex, lightUv);
    if (all(equal(emission, vec3(0.0)))) {
        return vec3(0.0);  // a dark spot of an emissive texture: no need for a shadow ray
    }
    // Stop just short of the light itself, it would count as a blocker otherwise.
    if (isOccluded(surfacePoint, direction, distance * 0.999)) {
        return vec3(0.0);
    }

    float pdfLight = lightPdf(int(low), distance, cosLight);
    float weight = 1.0;
    if (scene.emissiveSampling == EMISSIVE_MIS) {
        float pdfBounce = cosSurface / PI;  // how likely the cosine-weighted bounce would have picked this direction
        weight = misWeight(pdfLight, pdfBounce);
    }
    // Monte Carlo: (what arrives * how the surface reflects it) / how likely we were to pick this sample
    return emission * (hit.albedo / PI) * cosSurface / pdfLight * weight;
}

// Squeezes unbounded brightness into [0, 1] with a film-like S-curve instead of clipping it.
// (Krzysztof Narkowicz's fit of the ACES curve)
vec3 toneMapACES(vec3 x) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// ---------------------------------------------------------------------------------------------

// Follows one path from the camera through up to maxBounces surfaces and returns the light it carries back.
vec3 tracePath(vec3 origin, vec3 direction, inout uint seed, out float primaryHitDistance) {
    vec3 sunDirection = scene.sunDirection.xyz;
    float sunCosRadius = scene.sunDirection.w;

    vec3 radiance = vec3(0.0);    // light collected along this path
    vec3 throughput = vec3(1.0);  // fraction of light found further along that still reaches the camera
    primaryHitDistance = 0.0;
    float bouncePdf = 0.0;        // pdf of the bounce direction that led to the current hit (for MIS)
    bool sampleLights = scene.emissiveTriangleCount > 0 && scene.emissiveSampling != EMISSIVE_BOUNCES_ONLY;

    // maxBounces surfaces get lit (by light sampling and their bounce ray). The bounce ray leaving the last one
    // is still traced, but only to collect what it sees directly (sky or a glowing surface): light sampling
    // already counts direct light at that last surface, so without this ray, sky and glowing surfaces found
    // by bouncing would be one bounce short, and the methods wouldn't agree.
    for (uint bounce = 0; bounce <= scene.maxBounces; bounce++) {
        Hit hit = traceClosest(origin, direction);

        if (!hit.found) {
            radiance += throughput * environmentLight(direction);
            // Looking straight at the sun shows its disc. Bounced rays skip this: the sun's light was
            // already added through the shadow rays below, counting it here as well would double it.
            // The sun's total light (PI * sunColor, see below) is spread over the disc's solid angle.
            if (bounce == 0 && dot(direction, sunDirection) >= sunCosRadius) {
                float discSolidAngle = 2.0 * PI * (1.0 - sunCosRadius);
                radiance += PI * scene.sunColor.rgb / max(discSolidAngle, 1e-4);
            }
            break;
        }
        if (bounce == 0) {
            primaryHitDistance = hit.t;
        }

        // Light given off by the surface itself. Seen directly by the camera it always counts. Found by a bounce
        // ray, it is the "bounce sampling" half: with light sampling on, it shares the job (MIS) or leaves it
        // entirely to light sampling.
        if (any(greaterThan(hit.emissive, vec3(0.0)))) {
            float weight = 1.0;
            if (bounce > 0 && sampleLights && hit.lightIndex >= 0) {
                if (scene.emissiveSampling == EMISSIVE_LIGHT_SAMPLING) {
                    weight = 0.0;
                } else {
                    float cosLight = abs(dot(hit.geometricNormal, direction));
                    weight = misWeight(bouncePdf, lightPdf(hit.lightIndex, hit.t, cosLight));
                }
            }
            radiance += throughput * hit.emissive * weight;
        }
        if (bounce == scene.maxBounces) {
            break;  // the final ray: only what it sees counts
        }

        // Start new rays slightly above the surface so they don't hit the surface they start on.
        // Uses the real triangle plane: the smooth normal can point a bit into the surface.
        vec3 surfacePoint = hit.position + hit.geometricNormal * 0.001;

        // Direct sunlight: aim at a random point on the sun's disc. Points near a shadow edge see only
        // part of the disc, so averaged over many samples the shadow edge becomes soft (penumbra).
        // A matte surface reflects albedo / PI of the light hitting it; the sun delivers PI * sunColor,
        // so the PIs cancel and sunColor is simply "how bright a white surface facing the sun looks".
        // (skipped entirely when the sun is switched off: its color is then 0)
        if (any(greaterThan(scene.sunColor.rgb, vec3(0.0)))) {
            vec3 towardsSun = randomDirectionInCone(sunDirection, sunCosRadius, seed);
            float cosTheta = dot(hit.normal, towardsSun);
            bool sunAboveTriangle = dot(hit.geometricNormal, towardsSun) > 0.0;
            if (cosTheta > 0.0 && sunAboveTriangle && (scene.shadowsEnabled == 0 || !isOccluded(surfacePoint, towardsSun, 1000.0))) {
                radiance += throughput * hit.albedo * scene.sunColor.rgb * cosTheta;
            }
        }

        // Direct light from glowing surfaces: the same idea, aimed at a random point on a random glowing triangle.
        if (sampleLights) {
            radiance += throughput * sampleEmissiveLight(hit, surfacePoint, seed);
        }

        // Indirect light: continue the path in a random direction. normal + random unit vector gives
        // directions weighted by cos(angle to normal), which is exactly how a matte surface scatters light,
        // so the only thing left to account for is the surface color.
        throughput *= hit.albedo;
        vec3 newDirection = hit.normal + randomUnitVector(seed);
        direction = dot(newDirection, newDirection) > 1e-6 ? normalize(newDirection) : hit.normal;
        // Around the smooth normal, a direction can still point into the actual triangle. Mirror it back out.
        float belowTriangle = dot(direction, hit.geometricNormal);
        if (belowTriangle < 0.0) {
            direction -= 2.0 * belowTriangle * hit.geometricNormal;
        }
        bouncePdf = max(dot(hit.normal, direction), 1e-6) / PI;  // cosine-weighted: cos / PI per solid angle
        origin = surfacePoint;

        // Russian roulette: after a few bounces, randomly stop paths that carry little light and
        // boost the survivors by the same factor, so on average the result stays the same.
        if (bounce >= 2) {
            float survive = max(throughput.r, max(throughput.g, throughput.b));
            if (randomFloat(seed) >= survive) {
                break;
            }
            throughput /= survive;
        }
    }
    return radiance;
}

vec3 cameraRayDirection(vec2 pixelPosition, ivec2 size) {
    vec2 uv = (pixelPosition + scene.jitter) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;  // [-1, 1]; image y goes down, camera up goes up, hence the minus below
    return normalize(scene.cameraForward.xyz
                     + ndc.x * scene.tanHalfFov * scene.aspectRatio * scene.cameraRight.xyz
                     - ndc.y * scene.tanHalfFov * scene.cameraUp.xyz);
}

// A stable, distinct color per number
vec3 randomColor(uint value) {
    uint h = pcgHash(value + 1u);
    return vec3(h & 0xFFu, (h >> 8) & 0xFFu, (h >> 16) & 0xFFu) / 255.0;
}

// Shows one property of the first surface hit, to check that the mesh and material data arrive correctly.
vec3 debugColor(vec3 direction, out float depth) {
    Hit hit = traceClosest(scene.cameraPosition.xyz, direction);
    depth = hit.found ? hit.t : 0.0;
    if (!hit.found) {
        return vec3(0.0);
    }
    switch (scene.debugView) {
        case 1: return hit.normal * 0.5 + 0.5;  // x -> red, y -> green, z -> blue
        case 2: return vec3(fract(hit.uv), 0.0);
        case 3: return randomColor(hit.meshIndex);
        case 4: return randomColor(hit.materialIndex);
        // linear values; the blit to the sRGB swapchain makes them look right
        case 5: return hit.albedo;
        case 6: return vec3(hit.metallic);
        case 7: return vec3(hit.roughness);
        case 8: return vec3(hit.transmission);
        case 9: return hit.emissive;
        case 10: return hit.tangent * 0.5 + 0.5;
    }
    return vec3(1.0, 0.0, 1.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outColor);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;  // the last tiles can stick out past the image edge
    }

    if (scene.debugView != 0) {
        float depth;
        vec3 color = debugColor(cameraRayDirection(vec2(pixel) + 0.5, size), depth);
        imageStore(outColor, pixel, vec4(color, 1.0));
        imageStore(outDepth, pixel, vec4(depth));
        return;
    }

    uint seed = pcgHash(uint(pixel.x) + pcgHash(uint(pixel.y) + pcgHash(scene.frameIndex)));

    // Spread samples randomly over the pixel (anti-aliasing). A single sample without accumulation
    // goes through the pixel center, otherwise edges would flicker from frame to frame.
    bool randomOffset = scene.samplesPerPixel > 1 || scene.accumulate != 0;

    vec3 color = vec3(0.0);
    float depth = 0.0;

    for (uint s = 0; s < scene.samplesPerPixel; s++) {
        vec2 offset = randomOffset ? vec2(randomFloat(seed), randomFloat(seed)) - 0.5 : vec2(0.0);
        vec3 direction = cameraRayDirection(vec2(pixel) + 0.5 + offset, size);

        float hitDistance;
        color += tracePath(scene.cameraPosition.xyz, direction, seed, hitDistance);
        if (s == 0) {
            depth = hitDistance;
        }
    }
    color /= float(scene.samplesPerPixel);

    // Running average: the n-th frame gets weight 1/(n+1), so every frame counts equally.
    if (scene.accumulate != 0 && scene.accumulatedFrames > 0) {
        vec3 previous = imageLoad(accumulationImage, pixel).rgb;
        color = mix(previous, color, 1.0 / float(scene.accumulatedFrames + 1));
    }
    imageStore(accumulationImage, pixel, vec4(color, 1.0));  // stays linear and unbounded

    // Only what is displayed gets exposure and tone mapping, so changing them does not restart accumulation.
    vec3 displayColor = color * scene.exposure;
    if (scene.toneMapping != 0) {
        displayColor = toneMapACES(displayColor);
    }
    imageStore(outColor, pixel, vec4(displayColor, 1.0));  // values above 1 are clamped when stored as 8 bit
    imageStore(outDepth, pixel, vec4(depth));
}
