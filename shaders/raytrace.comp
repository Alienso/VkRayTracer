#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_shader_atomic_float : require
#extension GL_EXT_control_flow_attributes : require

// One thread per pixel, in 8x8 tiles.
layout(local_size_x = 8, local_size_y = 8) in;

// The same shader runs as several pipelines (RayTracer.cpp), told apart by specialization constants, so each
// pipeline only contains the code it needs. Both 0: the image. CACHE_UPDATE_PASS = 1: the radiance cache's update
// paths (a few full-length paths that fill the cache, see "Radiance cache" below). RESTIR_PASS = 1: the camera
// rays, stored for the image pass (see "Primary hits"), and ReSTIR DI's light samples (see "ReSTIR DI").
// RESTIR_PASS = 2: ReSTIR DI's spatial reuse (restirSpatial), between those two. After the image: RESTIR_PASS = 4,
// ReSTIR GI's temporal reuse (restirGiTemporalPass), RESTIR_PASS = 5, its spatial reuse (restirGiSpatial), then
// RESTIR_PASS = 3, its shading (restirGiShade).
layout(constant_id = 0) const uint CACHE_UPDATE_PASS = 0;
layout(constant_id = 1) const uint RESTIR_PASS = 0;
// FOG = 1: some material has fog inside or an invisible surface (see "Fog"). Each pass has a pipeline without the fog's
// code too, for scenes without: it costs registers (168 instead of 128), and with them 12% of the time, fog or not.
layout(constant_id = 2) const uint FOG = 0;
// FEATURES: which of the scene features below the pipeline has the code for (a bit each, all by default). Without one,
// the scene must not use it: the code assumes it away (no portals, lamps, glass, cut-outs or diffuse transmission).
layout(constant_id = 3) const uint FEATURES = ~0u;
const bool FEATURE_PORTALS = (FEATURES & 1u) != 0u;
const bool FEATURE_LAMPS = (FEATURES & 2u) != 0u;
const bool FEATURE_GLASS = (FEATURES & 4u) != 0u;
const bool FEATURE_CUTOUTS = (FEATURES & 8u) != 0u;
const bool FEATURE_DIFFUSE_TRANSMISSION = (FEATURES & 16u) != 0u;
// Rays that stop at the first surface whatever it is can let the hardware decide alone (no candidates for the shader)
const uint PATH_RAY_FLAGS = FEATURE_CUTOUTS || FOG != 0 ? gl_RayFlagsNoneEXT : gl_RayFlagsOpaqueEXT;
const uint SHADOW_RAY_FLAGS = FEATURE_GLASS || FEATURE_CUTOUTS || FOG != 0 ? gl_RayFlagsNoneEXT : gl_RayFlagsOpaqueEXT;

layout(binding = 0) uniform accelerationStructureEXT tlas;
// Linear HDR result: the running average over frames while accumulating, otherwise this frame (or a debug
// view). Exposure and tone mapping happen later, in display.comp.
layout(binding = 1, rgba32f) uniform image2D radianceImage;
// DLSS inputs ("guides"), all about the first surface the camera ray hits; written only if scene.writeGuides
layout(binding = 2, r32f) uniform writeonly image2D linearDepthImage;          // view-space depth, sky = farDistance
layout(binding = 13, rg32f) uniform writeonly image2D motionVectorImage;       // pixels: last frame's position - this
layout(binding = 14, rgba16f) uniform writeonly image2D diffuseAlbedoImage;
layout(binding = 15, rgba16f) uniform writeonly image2D specularAlbedoImage;
layout(binding = 16, rgba16f) uniform writeonly image2D normalRoughnessImage;  // world-space normal, roughness in alpha
layout(binding = 17, r32f) uniform writeonly image2D specularHitDistanceImage; // 0 = unknown
// The share of camera rays that scattered in fog before any reflection (through glass counts), averaged like the
// radiance: on average 1 - the fog's transmittance up to the first surface. For the fog grain (display.comp).
layout(binding = 33, r32f) uniform image2D fogAmountImage;

// Must match SceneUniforms in Application.h
layout(binding = 3) uniform SceneUniforms {
    mat4 viewProjection;          // this frame, without jitter: world -> clip (Vulkan: y down)
    mat4 previousViewProjection;  // last frame's
    vec4 cameraPosition;
    vec4 cameraForward;
    vec4 cameraRight;
    vec4 cameraUp;
    vec2 jitter;            // sub-pixel offset in pixels, (0,0) until DLSS
    float tanHalfFov;       // tan(verticalFov / 2)
    float aspectRatio;      // width / height
    vec4 sunDirection;      // xyz: normalized direction TOWARDS the sun, w: cos(angular radius of the sun disc)
    vec4 sunColor;          // rgb: color * intensity (light arriving at a surface facing the sun)
    vec4 skyZenithColor;    // rgb, already multiplied by the sky intensity
    vec4 skyHorizonColor;
    vec4 groundColor;       // environment below the horizon
    uint environmentMap;    // 1 = the environment is the HDR map (environmentMap below) instead of the gradient
    uint environmentSampling;  // 1 = shadow rays are aimed at the sky too (environmentCdf below)
    uint environmentWidth;  // cells of environmentCdf
    uint environmentHeight;
    float environmentRotation;   // radians around the vertical axis
    float environmentIntensity;  // multiplies the HDR map
    uint punctualLightCount;     // entries in punctualLights
    uint samplesPerPixel;
    uint maxBounces;        // number of surfaces a path may hit
    uint frameIndex;        // changes every frame, seeds the random numbers
    uint shadowsEnabled;
    uint accumulatedFrames; // frames already averaged into radianceImage (0 = start over)
    uint accumulate;        // 0 = show only this frame
    uint debugView;         // 0 = path traced, otherwise one property of the first hit, see DebugView in Application.h
    uint emissiveTriangleCount;
    uint emissiveSampling;  // 0 = bounces only, 1 = light sampling only, 2 = both with MIS
    uint blurCaustics;      // 1 = path regularization, see tracePath
    float farDistance;      // depth written for rays that hit nothing
    uint writeGuides;       // 1 = write the DLSS input images
    uint cacheQuery;        // 1 = paths end in the radiance cache where they can
    uint cacheCapacity;     // entries in the cache (a power of two)
    float cacheCellScale;   // cache cell size per unit of distance from the camera
    float cacheMinWeight;   // samples a cache entry needs before paths use it
    uint cacheUpdateTile;   // update pass: one path per cacheUpdateTile x cacheUpdateTile pixels
    uint lightTree;         // 1 = light sampling picks glowing triangles by walking the light tree (binding 24)
    uint sunOn;             // 1 = the sun gives light (its color isn't 0)
    uint sunMis;            // 1 = the sun has a size: bounce rays find it too, shared with its shadow rays by MIS
    float sunPdf;           // pdf of a shadow ray towards the sun: 1 / the disc's solid angle
    float sunRadianceScale; // sunColor * this = the light of one point of the disc
    uint textureMipmaps;    // 1 = textures are read at the level that fits the hit's footprint (ray cones, see traceClosest)
    float pixelSpreadAngle; // angle between neighboring camera rays (radians): how fast a pixel's footprint grows
    uint normalMapFiltering; // 1 = bumps that a normal map's smaller levels average away widen the reflection (Toksvig)
    uint restirDi;          // 1 = ReSTIR DI: the RESTIR_PASS traced the camera rays and picked a light sample per pixel
    uint restirTriangleCandidates;  // candidates per kind of light (0 when there are none of that kind)
    uint restirPunctualCandidates;
    uint restirSkyCandidates;
    uint restirBrdfCandidates;
    float restirMinRoughness;       // rougher surfaces use ReSTIR (restirSurface)
    uint restirTemporal;            // 1 = reuse last frame's reservoirs (restirTemporal); 2 = also with a shadow ray
    float restirMaxHistory;         // last frame's reservoir counts for at most this many times this frame's candidates
    uint restirHistoryValid;        // 0: last frame's reservoirs are unusable (first frame, lights changed, ...)
    uint restirCurrentHalf;         // which half of the reservoir and surface buffers is this frame's (0/1)
    uint restirPermutation;         // shuffle of last frame's pixels: bit 4 = on, this frame's offset x in bits 0-1, y in 2-3
    uint restirSpatialNeighbors;    // neighbors' reservoirs each pixel resamples (restirSpatial); 0 = no spatial pass
    float restirSpatialRadius;      // within this many render pixels
    uint restirDisocclusionNeighbors;  // as many for pixels that found no history
    uint restirSpatialVisibility;   // 1 = the spatial reuse is unbiased (shadow rays from the neighbors, see restirSpatial)
    float bounceLightClamp;         // 0 = off; else the most one sample of bounce light may add (luminance, see tracePath)
    uint restirGi;                  // 1 = ReSTIR GI: the first bounce's light at ReSTIR surfaces is a sample (see "ReSTIR GI")
    float restirGiMinRoughness;     // second surfaces at least this rough give a sample
    uint restirGiTemporal;          // 1 = reuse last frame's GI reservoirs (restirGiTemporal)
    float restirGiMaxHistory;       // last frame's reservoir counts for at most this many times this frame's samples
    uint restirGiMaxAge;            // samples older than this many frames are dropped
    uint restirGiHistoryValid;      // 0: last frame's GI reservoirs are unusable (first frame, lights changed, ...)
    uint restirGiPermutation;       // 1 = shuffle last frame's pixels (offset in restirPermutation's bits 0-3)
    uint restirGiSpatialNeighbors;  // neighbors' GI reservoirs each pixel resamples; 0 = no spatial pass
    float restirGiSpatialRadius;    // within this many render pixels
    uint restirGiDisocclusionNeighbors;  // as many for pixels that found no history
    uint restirGiSpatialVisibility; // 1 = rays from the neighbors' surfaces for the kept sample (see restirGiSpatial)
    float restirGiBoilingFilter;    // 0 = off; else its strength (see restirGiTemporalPass)
    float restirGiRadianceClamp;    // 0 = off; else the most a GI sample's Lo may be (luminance)
    uint restirGiTemporalVisibility;  // 1 = the temporal reuse is unbiased (a ray from last frame's surface)
    uint pathSampling;              // the path's main decisions (pathSample): 0 = white noise, 1 = Sobol, 2 = + blue noise
    uint emissiveSolidAngle;        // 1 = points on glowing triangles by solid angle (see triangleSolidAngle), 0 = by area
    uint portalCount;               // entries in the portal list (binding 31): two per pair
    float fogTime;                  // seconds of fog drift (Material.fogDrift); 0 while no fog drifts
} scene;

// (0 in a pipeline without the feature, so its code drops out)
uint portalCount() {
    return FEATURE_PORTALS ? scene.portalCount : 0u;
}

uint punctualLightCount() {
    return FEATURE_LAMPS ? scene.punctualLightCount : 0u;
}

// Must match SceneVertex in ModelLoader.h. Scalar layout = tightly packed like in C++.
struct Vertex {
    vec3 position;
    vec3 normal;
    vec2 uv;
    vec4 tangent;   // xyz: direction in which U grows, w: +-1 bitangent sign
};

// Must match MeshInfo in Application.h. All meshes share the vertex and index buffers;
// this says where one mesh's part starts. Indices are relative to the mesh's first vertex.
struct MeshInfo {
    uint materialIndex;
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint indexCount;
    uint hasNormals;
    uint hasTangents;
    float unitScale;        // file units per mesh unit (the glTF node's scale), for absorption distances
    vec3 boundsMin;         // the mesh's box, in its own space
    vec3 boundsMax;
    int distanceField;      // in volumeTextures: the distance to its surface over that box; -1: none (Volumes.cpp)
};

layout(binding = 4, scalar) readonly buffer Vertices { Vertex vertices[]; };
layout(binding = 5, scalar) readonly buffer Indices { uint indices[]; };
layout(binding = 6, scalar) readonly buffer MeshInfos { MeshInfo meshInfos[]; };

// Must match GpuMaterial in Application.h. Each value is a constant, multiplied by its texture if the index is >= 0.
struct Material {
    vec4 baseColor;         // linear RGB + alpha
    vec3 emissive;          // light given off, already multiplied by the strength
    float metallic;
    float roughness;
    float transmission;
    float ior;
    float alphaCutoff;
    uint alphaMode;         // 0 opaque, 1 mask, 2 blend
    int baseColorTexture;
    int metallicRoughnessTexture;  // G: roughness, B: metallic
    int transmissionTexture;       // R: transmission
    int emissiveTexture;
    int normalTexture;             // RGB: direction in tangent space (X along U, Y along "up" in the image, Z out)
    float normalScale;
    uint normalTwoChannel;         // 1 = the texture has X and Y only (BC5 from .dds), Z = sqrt(1 - X^2 - Y^2)
    uint solid;                    // transmissive: 1 = closed volume that refracts, 0 = thin (light passes straight)
    vec3 absorption;               // inside a solid: light left after distance d is exp(-absorption * d)
    // KHR_texture_transform: each texture is read at transform * (mesh UV, 1); identity when the file has none
    mat3x2 baseColorUvTransform;
    mat3x2 metallicRoughnessUvTransform;
    mat3x2 transmissionUvTransform;
    mat3x2 emissiveUvTransform;
    mat3x2 normalUvTransform;
    float diffuseTransmission;           // share of the diffuse layer that leaves on the other side (leaves, paper)
    vec3 diffuseTransmissionColor;       // its tint (not multiplied by the base color)
    int diffuseTransmissionTexture;      // A: diffuse transmission
    int diffuseTransmissionColorTexture; // RGB: tint
    mat3x2 diffuseTransmissionUvTransform;
    mat3x2 diffuseTransmissionColorUvTransform;
    int normalVarianceTexture;     // R: the bumps the normal map's level averages away, as GGX alpha (see traceClosest)
    float fogDensity;              // fog inside the closed mesh, per unit of distance; 0 = none (see "Fog")
    vec3 fogColor;                 // the share of the light it scatters that goes on
    float fogForward;              // Henyey-Greenstein g of its scattering (fogPhase)
    uint invisible;                // 1 = rays pass the surface unchanged (only the fog inside shows)
    uint fogNoise;                 // varying fog (see "Varying density"): 1 = patchy, by the noise
    float fogNoiseScale;           // noise texture repeats per mesh unit
    float fogCoverage;             // 0..1: about the share of the volume with fog
    float fogEdge;                 // fades out over this distance towards the surface (mesh units); 0 = sharp
    vec3 fogNoiseOffset;           // where in the noise texture (from the material's seed)
    vec3 fogDrift;                 // how fast the noise moves through the mesh, in noise texture repeats per second
};
layout(binding = 8, scalar) readonly buffer Materials { Material materials[]; };

// Radiance cache (RadianceCache.cpp, shaders/cache_resolve.comp): a hash table of small cells on the surfaces,
// each with the light that leaves it (reflected, not its own emission), averaged over recent frames.
layout(binding = 18, scalar) buffer CacheKeys { uint cacheKeys[]; };                  // 0 = empty, else the cell's fingerprint
layout(binding = 19, scalar) buffer CacheAccumulators { vec4 cacheAccumulators[]; }; // this frame's samples: rgb sum, count
layout(binding = 20, scalar) readonly buffer CacheValues { vec4 cacheValues[]; };    // rgb: average light, w: sample weight

const uint ALPHA_OPAQUE = 0;
const uint ALPHA_MASK = 1;
const uint ALPHA_BLEND = 2;

// Must match EmissiveTriangle in Application.h. Every triangle of every glowing instance, in world space.
struct EmissiveTriangle {
    vec3 p0, p1, p2;
    vec2 uv0, uv1, uv2;
    uint materialIndex;
    float probability;      // chance that light sampling picks this triangle
    float cdf;              // running sum of the probabilities, for the binary search
    float area;
    uint treeTrail;         // its way down the light tree: bit d = 1 means "right child" at depth d
};
layout(binding = 9, scalar) readonly buffer EmissiveTriangles { EmissiveTriangle emissiveTriangles[]; };
// Per TLAS instance: where its triangles start in emissiveTriangles, or -1 if it doesn't glow.
layout(binding = 10, scalar) readonly buffer InstanceFirstLight { int instanceFirstLight[]; };

// How much light the GGX reflection returns in total (see createSpecularAlbedoTable in Materials.cpp):
// entry [roughness * SIZE + view angle], total for a given F0 = F0 * x + y.
layout(binding = 11, scalar) readonly buffer SpecularAlbedo { vec2 specularAlbedo[]; };

// Per TLAS instance. Must match GpuInstance in Application.h.
struct InstanceData {
    mat4 motion;         // takes a point on it from this frame's world position to last frame's (object motion);
                         // identity for objects that didn't move
    mat4x3 objectToWorld;  // used instead of the ray query's matrices, so a stored hit (see "Primary hits") is
    mat3 worldToObject;    // rebuilt the same way. Without the translation (what normals need)
    uint meshIndex;        // as its custom index in the TLAS (fog volumes are known by their instance, see "Fog")
};
layout(binding = 12, scalar) readonly buffer Instances { InstanceData instances[]; };

// The camera rays' hits (RESTIR_PASS), one per render pixel, row by row. Must match GpuPrimaryHit in Application.h.
struct PrimaryHit {
    uint meshIndex;      // ~0: the camera ray hit nothing, PRIMARY_THROUGH_PORTAL: it crossed a portal (not stored)
    uint instanceIndex;
    int primitive;
    vec2 barycentrics;
    float t;
    uint seed;           // the pixel's random numbers after the ray (cut-outs use some), for the image pass to go on with
    // Seen in mirrors (see "Mirrors and ReSTIR"): the ray's length before its last part (0: no mirror), the last
    // part's direction, and the mirrors' color (half floats)
    float travelled;
    vec3 direction;
    uint tintRG;
    uint tintB;
};
layout(binding = 25, scalar) buffer PrimaryHits { PrimaryHit primaryHits[]; };
// The camera ray went through a portal: the pixel doesn't use ReSTIR (its first surface is not where the camera
// sees it), and the image pass traces the ray again itself
const uint PRIMARY_THROUGH_PORTAL = 0xFFFFFFFDu;
// The first bounce of the image path at a ReSTIR surface, picked and traced by the RESTIR_PASS as its BRDF
// candidate (see restirCandidates), one per render pixel. Must match GpuBounceHit in Application.h.
struct BounceHit {
    uint meshIndex;      // ~0: the ray left the scene, BOUNCE_NONE: no bounce (the path ends at the first surface)
    uint instanceIndex;
    int primitive;
    vec2 barycentrics;
    float t;
    vec3 direction;      // exact: the hit is rebuilt with it (which side was hit, texture footprint)
    uint weightRG;       // the sample's weight (BRDF * cos / pdf), half floats
    uint weightBRoughness;  // weight.b (half), lobe roughness (8 bits), flags (8 bits: 1 transmitted, 2 specular lobe,
                            // 4 the ray crossed a portal: not stored, the image pass traces it itself)
    float pdf;
};
layout(binding = 28, scalar) buffer BounceHits { BounceHit bounceHits[]; };
const uint BOUNCE_NONE = 0xFFFFFFFEu;
const uint BOUNCE_RETRACE = 4u << 24;
const uint SPECULAR_ALBEDO_SIZE = 32;  // must match Application::specularAlbedoSize

const uint EMISSIVE_BOUNCES_ONLY = 0;
const uint EMISSIVE_LIGHT_SAMPLING = 1;
const uint EMISSIVE_MIS = 2;

// All textures of all models in one array. Neighboring pixels can hit different materials, so the
// index differs between the threads of a warp: nonuniformEXT tells the compiler to handle that.
layout(binding = 7) uniform sampler2D textures[];
// The fog's 3D textures (Volumes.cpp): 0 the noise, then the distance fields of meshes with varying fog
layout(binding = 32) uniform sampler3D volumeTextures[];

// The HDR environment map: equirectangular (u: around the horizon, v: from straight up to straight down)
layout(binding = 21) uniform sampler2D environmentMap;
// For picking sky directions in proportion to their brightness (Environment.cpp): the running sums (CDF) over the
// environmentHeight rows, then for each row the running sums over its environmentWidth columns.
layout(binding = 22, scalar) readonly buffer EnvironmentDistribution { float environmentCdf[]; };

// Must match GpuPunctualLight in Application.h. The lights that came with the models (KHR_lights_punctual), in
// world space: points, spots and directional lights without size, so only shadow rays reach them.
struct PunctualLight {
    vec3 position;
    uint type;              // LIGHT_* below
    vec3 direction;         // the way it shines
    float range;            // 0 = no limit
    vec3 intensity;         // candela (point, spot), lux (directional)
    float cosOuterCone;
    float cosInnerCone;
};
layout(binding = 23, scalar) readonly buffer PunctualLights { PunctualLight punctualLights[]; };
const uint LIGHT_DIRECTIONAL = 0;
const uint LIGHT_POINT = 1;
const uint LIGHT_SPOT = 2;

// Must match LightTreeNode in Application.h. A binary tree over the glowing triangles that light sampling can pick,
// node 0 is the root (see buildLightTree in Lights.cpp and pickFromLightTree below).
struct LightTreeNode {
    vec3 boundsMin;
    float power;            // its triangles' summed probability (share of the scene's light)
    vec3 boundsMax;
    int child;              // >= 0: the first of its two children (the second follows); < 0: triangle -child-1
};
layout(binding = 24, scalar) readonly buffer LightTree { LightTreeNode lightTreeNodes[]; };

const float PI = 3.14159265359;
const float RAY_FAR = 1e30;          // how far rays go: no limit, whatever the scene's size
const float SKY_DISTANCE = RAY_FAR;  // shadow rays towards the sun or the sky: anything on the way blocks them

// ---------------------------------------------------------------------------------------------
// Random numbers (PCG hash)

uint pcgHash(uint value) {
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) / 4294967295.0;
}

// ---------------------------------------------------------------------------------------------
// Low-discrepancy samples (Owen-scrambled Sobol points, Burley 2020: "Practical Hash-based Owen Scrambling")
//
// Independent random numbers clump and leave gaps by chance, and a pixel's average only settles as those even out.
// The main decisions of a path take their numbers from a Sobol sequence instead, whose first 2, 4, 8, ... points
// always fill [0,1)^4 evenly: the pixel's samples (one per frame, or several per frame) cover the light, the sun's
// disc, the sky and the bounce directions without clumps, and its average settles faster. Each decision (SAMPLE_*)
// at each bounce takes its own 4D point. Owen scrambling with a seed per decision randomizes the points without
// losing that evenness, and makes the decisions independent of each other ("padding"); the sample index is
// shuffled the same way. Everything else (cut-outs, the punctual lights, ReSTIR's candidates and reuse, the cache's
// update paths) keeps randomFloat.
// Neighboring pixels: with "Sobol", each pixel scrambles with its own seed too, so their errors are unrelated (white
// noise over the screen). With "+ blue noise" all pixels share the scrambled points, each shifted (modulo 1) by
// its texel of a blue-noise texture (Georgiev & Fajardo 2016): in a frame, neighboring pixels then take samples that
// differ evenly, and their errors too, fine-grained noise that DLSS filters more easily than blotches. The shift
// is the same in every frame, so a pixel's own samples stay just as evenly spread.
const uvec4 SOBOL_DIRECTIONS[32] = uvec4[](  // dimensions 0-3: van der Corput, then Joe & Kuo's 2-4
    uvec4(0x80000000u, 0x80000000u, 0x80000000u, 0x80000000u),
    uvec4(0x40000000u, 0xc0000000u, 0xc0000000u, 0xc0000000u),
    uvec4(0x20000000u, 0xa0000000u, 0x60000000u, 0x20000000u),
    uvec4(0x10000000u, 0xf0000000u, 0x90000000u, 0x50000000u),
    uvec4(0x08000000u, 0x88000000u, 0xe8000000u, 0xf8000000u),
    uvec4(0x04000000u, 0xcc000000u, 0x5c000000u, 0x74000000u),
    uvec4(0x02000000u, 0xaa000000u, 0x8e000000u, 0xa2000000u),
    uvec4(0x01000000u, 0xff000000u, 0xc5000000u, 0x93000000u),
    uvec4(0x00800000u, 0x80800000u, 0x68800000u, 0xd8800000u),
    uvec4(0x00400000u, 0xc0c00000u, 0x9cc00000u, 0x25400000u),
    uvec4(0x00200000u, 0xa0a00000u, 0xee600000u, 0x59e00000u),
    uvec4(0x00100000u, 0xf0f00000u, 0x55900000u, 0xe6d00000u),
    uvec4(0x00080000u, 0x88880000u, 0x80680000u, 0x78080000u),
    uvec4(0x00040000u, 0xcccc0000u, 0xc09c0000u, 0xb40c0000u),
    uvec4(0x00020000u, 0xaaaa0000u, 0x60ee0000u, 0x82020000u),
    uvec4(0x00010000u, 0xffff0000u, 0x90550000u, 0xc3050000u),
    uvec4(0x00008000u, 0x80008000u, 0xe8808000u, 0x208f8000u),
    uvec4(0x00004000u, 0xc000c000u, 0x5cc0c000u, 0x51474000u),
    uvec4(0x00002000u, 0xa000a000u, 0x8e606000u, 0xfbea2000u),
    uvec4(0x00001000u, 0xf000f000u, 0xc5909000u, 0x75d93000u),
    uvec4(0x00000800u, 0x88008800u, 0x6868e800u, 0xa0858800u),
    uvec4(0x00000400u, 0xcc00cc00u, 0x9c9c5c00u, 0x914e5400u),
    uvec4(0x00000200u, 0xaa00aa00u, 0xeeee8e00u, 0xdbe79e00u),
    uvec4(0x00000100u, 0xff00ff00u, 0x5555c500u, 0x25db6d00u),
    uvec4(0x00000080u, 0x80808080u, 0x8000e880u, 0x58800080u),
    uvec4(0x00000040u, 0xc0c0c0c0u, 0xc0005cc0u, 0xe54000c0u),
    uvec4(0x00000020u, 0xa0a0a0a0u, 0x60008e60u, 0x79e00020u),
    uvec4(0x00000010u, 0xf0f0f0f0u, 0x9000c590u, 0xb6d00050u),
    uvec4(0x00000008u, 0x88888888u, 0xe8006868u, 0x800800f8u),
    uvec4(0x00000004u, 0xccccccccu, 0x5c009c9cu, 0xc00c0074u),
    uvec4(0x00000002u, 0xaaaaaaaau, 0x8e00eeeeu, 0x200200a2u),
    uvec4(0x00000001u, 0xffffffffu, 0xc5005555u, 0x50050093u));
const uint SAMPLE_CAMERA = 0u;    // the offset in the pixel
const uint SAMPLE_SUN = 1u;       // a point on the sun's disc
const uint SAMPLE_SKY = 2u;       // a direction picked by the sky's brightness
const uint SAMPLE_EMISSIVE = 3u;  // a glowing triangle, and a point on it
const uint SAMPLE_BOUNCE = 4u;    // the bounce: lobe, direction, Russian roulette
const uint SAMPLE_FOG = 5u;       // where the ray scatters in fog, and the lamps' light in it (fogLampLight)
uint sobolPixelSeed = 0u;  // this pixel's scrambling seed (blue noise: the same for all); 0 = off (white noise)
uint sobolIndex = 0u;      // this path's number among its pixel's samples
ivec2 sobolPixel = ivec2(0);

// 64 x 64 texels, tiled; per texel 4 channels of 16 bits, each a blue-noise mask of its own (BlueNoise.cpp)
const uint BLUE_NOISE_SIZE = 64u;
layout(binding = 30, scalar) readonly buffer BlueNoise { uvec2 blueNoise[]; };

// The texture at this pixel, moved by an offset of its own per decision: neighbors in one channel differ evenly,
// and the decisions' shifts are unrelated to each other
vec4 blueNoiseAt(ivec2 pixel, uint seed) {
    uvec2 texel = (uvec2(pixel) + uvec2(seed, seed >> 16u)) & (BLUE_NOISE_SIZE - 1u);
    uvec2 v = blueNoise[texel.y * BLUE_NOISE_SIZE + texel.x];
    return vec4(v.x & 0xffffu, v.x >> 16u, v.y & 0xffffu, v.y >> 16u) / 65536.0;
}

// One random-looking permutation of the 32-bit values that only mixes each bit with lower ones (Laine & Karras;
// the constants are Vegdahl's improved version). Applied to the reversed bits, that is Owen scrambling.
uint laineKarrasPermutation(uint x, uint seed) {
    x ^= x * 0x3d20adeau;
    x += seed;
    x *= (seed >> 16u) | 1u;
    x ^= x * 0x05526c56u;
    x ^= x * 0x53a22864u;
    return x;
}

uint nestedUniformScramble(uint x, uint seed) {
    return bitfieldReverse(laineKarrasPermutation(bitfieldReverse(x), seed));
}

// The pixel's sample number: one sample per frame (several with samplesPerPixel), counted from the start of the
// accumulation, or from the program's start otherwise (DLSS keeps a history of its own)
void startPathSamples(ivec2 pixel, uint sampleInFrame) {
    uint frame = scene.accumulate != 0 ? scene.accumulatedFrames : scene.frameIndex;
    sobolIndex = frame * scene.samplesPerPixel + sampleInFrame;
    sobolPixel = pixel;
    sobolPixelSeed = scene.pathSampling == 0 ? 0u
                   : scene.pathSampling == 2 ? 0x2545f491u  // all pixels alike, shifted by the blue noise
                   : pcgHash(uint(pixel.x) + pcgHash(uint(pixel.y) ^ 0x9e3779b9u)) | 1u;
}

// Four numbers in [0, 1) for one decision of the path (SAMPLE_*) at a bounce: the coordinates of this path's
// Sobol point, or white noise when off
vec4 pathSample(uint bounce, uint decision, inout uint seed) {
    if (sobolPixelSeed == 0u) {
        return vec4(randomFloat(seed), randomFloat(seed), randomFloat(seed), randomFloat(seed));
    }
    uint dimensionSeed = pcgHash(sobolPixelSeed ^ pcgHash(bounce * 8u + decision));
    uint index = nestedUniformScramble(sobolIndex, dimensionSeed);
    uvec4 x = uvec4(0u);
    for (uint bit = 0u; index != 0u; bit++, index >>= 1u) {
        if ((index & 1u) != 0u) {
            x ^= SOBOL_DIRECTIONS[bit];
        }
    }
    x = uvec4(nestedUniformScramble(x.x, pcgHash(dimensionSeed + 1u)), nestedUniformScramble(x.y, pcgHash(dimensionSeed + 2u)),
              nestedUniformScramble(x.z, pcgHash(dimensionSeed + 3u)), nestedUniformScramble(x.w, pcgHash(dimensionSeed + 4u)));
    vec4 u = vec4(x >> 8u) / 16777216.0;  // 24 bits: exactly representable, below 1
    if (scene.pathSampling == 2) {
        u = min(fract(u + blueNoiseAt(sobolPixel, dimensionSeed)), vec4(0.99999994));
    }
    return u;
}

// Any two vectors perpendicular to n (and to each other).
void buildBasis(vec3 n, out vec3 tangent, out vec3 bitangent) {
    vec3 helper = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    tangent = normalize(cross(helper, n));
    bitangent = cross(n, tangent);
}

// Uniformly distributed direction inside a cone around `axis`. cosMaxAngle = 1 gives `axis` itself.
vec3 randomDirectionInCone(vec3 axis, float cosMaxAngle, vec2 u) {
    float cosTheta = mix(1.0, cosMaxAngle, u.x);
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    float phi = u.y * 2.0 * PI;
    vec3 tangent, bitangent;
    buildBasis(axis, tangent, bitangent);
    return normalize(tangent * (sinTheta * cos(phi)) + bitangent * (sinTheta * sin(phi)) + axis * cosTheta);
}

// ---------------------------------------------------------------------------------------------
// Tracing

// Where a new ray leaves a surface point p: just off the surface, on the side n points to (Wachter & Binder, "A
// Fast and Robust Method for Avoiding Self-Intersection", Ray Tracing Gems 2019). p, computed in floats, is off the
// real surface by some rounding error, which grows with p's size: the step is a fixed number of float steps (ulps)
// of each coordinate, so it is as small as it can safely be anywhere: tiny near the origin, larger far out. Near
// the origin, where float steps get extremely small, a fixed tiny distance instead. A fixed distance everywhere
// would be too small far out (the ray hits its own surface: shadow acne) or too big near (it starts behind a
// nearby surface: light leaks through corners and thin walls). The rays then start at t = 0.
// p must come from the triangle (barycentrics, see hitFromIntersection), not origin + t * direction, whose error
// grows with the ray's length too.
vec3 offsetRay(vec3 p, vec3 n) {
    const float nearOrigin = 1.0 / 32.0;
    const float floatScale = 1.0 / 65536.0;
    const float intScale = 256.0;
    ivec3 steps = ivec3(intScale * n);
    vec3 stepped = intBitsToFloat(floatBitsToInt(p) + ivec3(p.x < 0.0 ? -steps.x : steps.x,
                                                            p.y < 0.0 ? -steps.y : steps.y,
                                                            p.z < 0.0 ? -steps.z : steps.z));
    return vec3(abs(p.x) < nearOrigin ? p.x + floatScale * n.x : stepped.x,
                abs(p.y) < nearOrigin ? p.y + floatScale * n.y : stepped.y,
                abs(p.z) < nearOrigin ? p.z + floatScale * n.z : stepped.z);
}

// How far short of a point p on a surface (normal n) a ray must stop not to hit that surface, coming in at cosine
// cosTheta to it: p's rounding error as in offsetRay, along the ray. (Nearly edge-on, at most 100 times that.)
float stopShortOf(vec3 p, vec3 n, float cosTheta) {
    return dot(offsetRay(p, n) - p, n) / max(abs(cosTheta), 0.01);
}

struct Hit {
    bool found;
    float t;                // distance along the ray
    vec3 position;          // world space
    vec3 normal;            // world space, facing the ray. Smooth (interpolated) if the mesh has normals: use for lighting.
    vec3 geometricNormal;   // world space, facing the ray. The triangle's real plane: use to offset new rays.
    vec3 tangent;           // world space, only for the debug view
    vec2 uv;
    vec2 uvFootprintX;      // the hit's footprint in UV space: two axes of the ellipse (see uvFootprint)
    vec2 uvFootprintY;
    uint meshIndex;
    uint instanceIndex;     // which TLAS instance (for its motion)
    uint materialIndex;
    int lightIndex;         // this triangle in emissiveTriangles, -1 if it doesn't glow
    bool frontFace;         // hit from the outside (the side the normals point to)
    float objectScale;      // length of one world unit along the ray in the model file's units (for absorption)

    // Material at this point (constants * textures)
    vec3 albedo;            // base color
    float alpha;
    float metallic;
    float roughness;
    float transmission;
    float ior;
    bool solid;
    vec3 absorption;
    float diffuseTransmission;
    vec3 diffuseTransmissionColor;
    vec3 emissive;
};

// Texture reads at a hit, filtered over the hit's footprint (see uvFootprint): the GPU picks the mip level and
// filters along the footprint's long axis (anisotropic filtering). A footprint of 0 reads the full-size level.
// The texture transform scales and rotates the footprint like the UVs.
vec4 sampleTexture(int index, mat3x2 uvTransform, vec2 uv, vec2 footprintX, vec2 footprintY) {
    mat2 linear = mat2(uvTransform[0], uvTransform[1]);
    return textureGrad(textures[nonuniformEXT(index)], uvTransform * vec3(uv, 1.0), linear * footprintX, linear * footprintY);
}

vec4 sampleTexture(int index, mat3x2 uvTransform, Hit hit) {
    return sampleTexture(index, uvTransform, hit.uv, hit.uvFootprintX, hit.uvFootprintY);
}

// The full-size level, for points that are tested rather than seen: the cut-out test during traversal (averaged
// mip levels would let leaves fade into holes at a distance), and points picked on glowing triangles.
vec4 sampleTextureFull(int index, mat3x2 uvTransform, vec2 uv) {
    return textureLod(textures[nonuniformEXT(index)], uvTransform * vec3(uv, 1.0), 0.0);
}

void evaluateMaterial(inout Hit hit) {
    Material material = materials[hit.materialIndex];

    vec4 baseColor = material.baseColor;
    if (material.baseColorTexture >= 0) {
        baseColor *= sampleTexture(material.baseColorTexture, material.baseColorUvTransform, hit);
    }
    hit.albedo = baseColor.rgb;
    hit.alpha = baseColor.a;

    hit.metallic = material.metallic;
    hit.roughness = material.roughness;
    if (material.metallicRoughnessTexture >= 0) {
        vec4 metallicRoughness = sampleTexture(material.metallicRoughnessTexture, material.metallicRoughnessUvTransform, hit);
        hit.roughness *= metallicRoughness.g;
        hit.metallic *= metallicRoughness.b;
    }

    hit.transmission = FEATURE_GLASS ? material.transmission : 0.0;
    if (FEATURE_GLASS && material.transmissionTexture >= 0) {
        hit.transmission *= sampleTexture(material.transmissionTexture, material.transmissionUvTransform, hit).r;
    }
    hit.ior = material.ior;
    hit.solid = material.solid != 0;
    hit.absorption = material.absorption;

    hit.diffuseTransmission = FEATURE_DIFFUSE_TRANSMISSION ? material.diffuseTransmission : 0.0;
    if (FEATURE_DIFFUSE_TRANSMISSION && material.diffuseTransmissionTexture >= 0) {
        hit.diffuseTransmission *= sampleTexture(material.diffuseTransmissionTexture, material.diffuseTransmissionUvTransform, hit).a;
    }
    hit.diffuseTransmissionColor = material.diffuseTransmissionColor;
    if (hit.diffuseTransmission > 0.0 && material.diffuseTransmissionColorTexture >= 0) {
        hit.diffuseTransmissionColor *= sampleTexture(material.diffuseTransmissionColorTexture,
                                                      material.diffuseTransmissionColorUvTransform, hit).rgb;
    }

    hit.emissive = material.emissive;
    if (material.emissiveTexture >= 0) {
        hit.emissive *= sampleTexture(material.emissiveTexture, material.emissiveUvTransform, hit).rgb;
    }
}

// How solid a material is at a point: 1 = solid, 0 = a hole. Alpha is the base color's alpha (constant *
// texture). Mask is all or nothing at the cutoff; blend is in between. Opaque materials ignore alpha.
float opacityAt(uint materialIndex, vec2 uv) {
    Material material = materials[materialIndex];
    if (!FEATURE_CUTOUTS || material.alphaMode == ALPHA_OPAQUE) {
        return 1.0;
    }
    float alpha = material.baseColor.a;
    if (material.baseColorTexture >= 0) {
        alpha *= sampleTextureFull(material.baseColorTexture, material.baseColorUvTransform, uv).a;
    }
    if (material.alphaMode == ALPHA_MASK) {
        return alpha >= material.alphaCutoff ? 1.0 : 0.0;
    }
    return alpha;
}

// Decides whether a ray hits or passes through a cut-out surface at a candidate hit (see traceClosest).
// A see-through (blend) surface stops a ray with chance alpha. Over many rays, alpha of the light is stopped
// and 1 - alpha passes, which is exactly what blending means: no sorting of transparent layers needed.
bool candidateIsSolid(uint meshIndex, int primitive, vec2 bary, inout uint seed, bool invisibleCounts) {
    MeshInfo mesh = meshInfos[meshIndex];
    if (FOG != 0 && !invisibleCounts && materials[mesh.materialIndex].invisible != 0) {
        return false;
    }
    uint firstIndex = mesh.indexOffset + uint(primitive) * 3;
    vec2 uv0 = vertices[mesh.vertexOffset + indices[firstIndex + 0]].uv;
    vec2 uv1 = vertices[mesh.vertexOffset + indices[firstIndex + 1]].uv;
    vec2 uv2 = vertices[mesh.vertexOffset + indices[firstIndex + 2]].uv;
    vec2 uv = uv0 * (1.0 - bary.x - bary.y) + uv1 * bary.x + uv2 * bary.y;

    float opacity = opacityAt(mesh.materialIndex, uv);
    return opacity >= 1.0 || (opacity > 0.0 && randomFloat(seed) < opacity);
}

// The traversal loop. Hits on opaque instances are accepted by the hardware on its own. Instances with
// cut-out materials are flagged "not opaque" in the TLAS (see updateScene): for those, the traversal stops
// at every hit as a "candidate" and the shader decides whether it counts. Confirmed hits shorten the ray,
// so the closest confirmed one ends up committed. invisibleCounts: surfaces of invisible materials are hits too
// (intersectClosest goes on through them itself, following which fog the ray is in); else they are passed.
// passed: the instance and triangle (x, y) the ray has just gone through (intersectClosest), and the one before (z, w),
// ~0u: none. Two: where two volumes share a surface, the ray goes on from that same distance past one and then the
// other, and must not find the first again.
bool notPassed(rayQueryEXT rayQuery, uvec4 passed) {
    uvec2 triangle = uvec2(rayQueryGetIntersectionInstanceIdEXT(rayQuery, false),
                           rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, false));
    return triangle != passed.xy && triangle != passed.zw;
}

void traverse(rayQueryEXT rayQuery, inout uint seed, bool invisibleCounts, uvec4 passed) {
    while (rayQueryProceedEXT(rayQuery)) {
        if (PATH_RAY_FLAGS == gl_RayFlagsNoneEXT &&
            rayQueryGetIntersectionTypeEXT(rayQuery, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
            (FOG == 0 || notPassed(rayQuery, passed)) &&
            candidateIsSolid(rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, false),
                             rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, false),
                             rayQueryGetIntersectionBarycentricsEXT(rayQuery, false), seed, invisibleCounts)) {
            rayQueryConfirmIntersectionEXT(rayQuery);
        }
    }
}

// Ray cones (Akenine-Moller et al. 2021, "Improved Shader and Texture Level of Detail Using Ray Cones"): every
// ray stands for a thin cone, the part of the scene one pixel sees through it. Its width grows with the distance
// (by the spread angle per unit) and with every bounce (a rough reflection spreads it, see tracePath). Where it
// meets a surface it leaves an ellipse: as wide as the cone across the ray's slant, 1 / cos longer along it.
// Mapped to UV space through the triangle, the ellipse's two axes are what textureGrad needs to pick the mip
// level: a distant or blurry hit reads a small level (fewer texels, which stay in the cache; no shimmering), a
// close one the full size. Ignores how a curved mirror or lens widens or narrows the cone.
// e1, e2: the triangle's edges in world space, uv1, uv2: the same edges in UV space.
void uvFootprint(vec3 e1, vec3 e2, vec2 uv1, vec2 uv2, vec3 direction, float width, out vec2 alongX, out vec2 alongY) {
    alongX = vec2(0.0);
    alongY = vec2(0.0);
    vec3 n = cross(e1, e2);
    float areaSquared = dot(n, n);  // (2 * area)^2
    if (areaSquared < 1e-30 || width <= 0.0) {
        return;
    }
    n *= inversesqrt(areaSquared);
    vec3 across = cross(n, direction);  // on the surface, square to the slant: the ellipse's short axis
    float acrossLength = length(across);
    vec3 a = acrossLength > 1e-6 ? across / acrossLength : normalize(e1);  // straight on: any direction
    vec3 b = cross(n, a);
    vec3 axisA = a * width;
    vec3 axisB = b * (width / max(abs(dot(n, direction)), 0.01));
    // A vector on the triangle as s * e1 + t * e2 (solved with the edges' dot products), then in UV space
    float g11 = dot(e1, e1), g12 = dot(e1, e2), g22 = dot(e2, e2);
    vec2 stA = vec2(g22 * dot(axisA, e1) - g12 * dot(axisA, e2), g11 * dot(axisA, e2) - g12 * dot(axisA, e1)) / areaSquared;
    vec2 stB = vec2(g22 * dot(axisB, e1) - g12 * dot(axisB, e2), g11 * dot(axisB, e2) - g12 * dot(axisB, e1)) / areaSquared;
    alongX = uv1 * stA.x + uv2 * stA.y;
    alongY = uv1 * stB.x + uv2 * stB.y;
}

// What a ray query tells about a hit: WHICH instance and triangle, WHERE on it (barycentrics), and how far.
// Everything else (Hit) we look up in our own buffers, in hitFromIntersection.
struct Intersection {
    uint meshIndex;      // the instance's custom index (set to the mesh index in the TLAS)
    uint instanceIndex;  // which TLAS instance
    int primitive;       // which triangle of the mesh
    vec2 barycentrics;
    float t;             // along the ray's last part (after the last portal it went through)
    float travelled;     // the length of its parts before that (0: no portal). -1: lost in portals (see below)
    uint crossings;      // how many portals it went through
    bool inFog;          // it scattered in fog first, at t along its last part (no hit then, see "Fog")
    uint fogMedium;      // in which (the material)
    // The lamps' light in its fog (fogLampLight): a stretch of the last part inside fog, picked by its majorant times
    // its length among them (lampWeight: theirs in all, 0: none), the fog volumes there and their majorant
    vec2 lampSpan;
    uvec2 lampMedia;
    float lampMajorant;
    float lampWeight;
};

// ---------------------------------------------------------------------------------------------
// Fog
//
// Fog is a material: a closed mesh whose material has a fog thickness (Material.fogDensity) is filled with fog. Of
// light going a distance d through fog of density s, exp(-s * d) gets through; the rest scatters: the share fogColor
// of it goes on in a new direction (fogPhase), the rest is absorbed. Its surface is either invisible (Material.invisible:
// rays pass it unchanged, only the fog shows: haze, smoke, a cloud) or the material's own (solid glass with fog inside:
// murky water, milky glass; thin glass: a bubble of smoke). The built-in "Fog box" is a cube of invisible fog. The
// density is the same throughout ("even"), or varies from point to point (see "Varying density" below).
//
// Media. A path keeps which fog volumes it is in (its "media": up to MAX_MEDIA instances, packed: the first slots taken,
// the free ones after them, so loops over them stop at the first free one; see enterMedium), and changes
// them where it goes through a volume's surface: invisible ones in intersectClosest, glass ones where the path refracts
// (tracePath). A volume is an instance, not a material: the same fog material on two objects is two volumes, each with
// its own part of the noise, and where volumes overlap their densities add up. Where the camera is: mediumAt. A ray that
// leaves fog it didn't know it was in (one too many at once, or one mediumAt didn't see) catches up: the stretch before
// was inside it.
// Where a ray scatters: delta tracking (Woodcock et al. 1965; Novak et al. 2018). It takes tentative steps of random
// length -log(1 - u) / majorant, the majorant being at least the density anywhere (the media's thicknesses added up),
// and at each it scatters with chance density / majorant, else steps on ("null collision"). In even fog the density is
// the majorant, so the first step scatters: the ray query only needs to look that far. The ray's chance of getting past
// a stretch is exactly the share of light that does, so what it hits behind the fog needs no weight. The steps have no
// memory: at every surface it passes (an invisible one, a portal) they start over, as if the ray started there. Of
// overlapping volumes, the one it scatters in is picked by its share of the density there. Where it scatters is a vertex
// of the path like a surface (fogHit): lit by light sampling, the phase function in place of the BRDF, and the path goes
// on from it. Shadow rays add up their length inside even fog, in whatever order its surfaces come
// (shadowTransmittance); varying fog needs its stretches in order (varyingTransmittance).
// The density is the same for every color, so that chance and the light's loss always agree; the color is in the
// scattered light only, not in what passes straight through.
// Not in the fog's light: ReSTIR (its scatter points aren't surfaces), and the radiance cache (paths don't end at
// them).
// Lamps (the punctual lights) are the exception to the light sampling at scatter points. Their light falls off as
// 1 / distance^2, and the points the fog picks land near one only rarely, then very bright: the glow around a lamp
// would sparkle forever. Instead every stretch of a path takes their light along its whole length, at a point picked
// near the lamp (fogLampLight), and scatter points leave them out.
//
// Varying density (FOG = 2). A fog material with noise (Material.fogNoise) or an edge fade (fogEdge) has a density that
// changes from point to point (fogDensityAt): its thickness, times the noise (a tiling 3D texture read in the mesh's own
// space, so it moves, turns and scales with the object; cut down by the coverage), times the fade (from the mesh's
// signed distance field: how far inside its surface). Both are 0..1, so the thickness is the volume's majorant. The
// textures: volumeTextures (Volumes.cpp). Outside the mesh the distance field says so, and the density is 0: a stretch
// of a ray through the volume's bounding box holds all its fog, whatever the mesh's shape. Shadow rays use that
// (varyingTransmittance): ratio tracking (Novak et al. 2014) along the box, the same tentative steps, the light
// multiplied by 1 - density / majorant at each, with no random end; unbiased, and smooth where the fog is thin. Thin
// parts under a high majorant cost steps that find nothing (null collisions): the price of varying fog.

const uint NO_MEDIUM = 0xFFFFu;
const uvec2 OUTSIDE = uvec2(0xFFFFFFFFu);  // media: in no fog (4 slots of 16 bits, each an instance or NO_MEDIUM)
const uint MAX_MEDIA = 4;                   // volumes a path knows it is in at once (more: forgotten, see above)
const uint MAX_VOLUME_CROSSINGS = 8;        // invisible surfaces a ray goes through (beyond: it stops at the next one)
const uint FOG_MASK = 0x02u;                // TLAS groups of the fog volumes (mediumAt): even ones
const uint VARYING_FOG_MASK = 0x04u;        // varying ones
// Tentative steps along one stretch at most. Only a safety net against a stuck GPU: reached, the rest of the stretch
// is passed as if clear. Thickness 10 over 100 units takes ~1000.
const uint MAX_FOG_STEPS = 4096;

uint mediaSlot(uvec2 media, uint slot) {
    return ((slot < 2u ? media.x : media.y) >> ((slot & 1u) * 16u)) & 0xFFFFu;
}

void setMediaSlot(inout uvec2 media, uint slot, uint instance) {
    uint shift = (slot & 1u) * 16u;
    uint word = ((slot < 2u ? media.x : media.y) & ~(0xFFFFu << shift)) | (instance << shift);
    if (slot < 2u) {
        media.x = word;
    } else {
        media.y = word;
    }
}

// Packed media, one after the other: the first, and the others moved down a slot (a loop over them:
// for (uvec2 rest = media; firstMedium(rest) != NO_MEDIUM; rest = otherMedia(rest)), as few steps as there are volumes)
uint firstMedium(uvec2 media) {
    return media.x & 0xFFFFu;
}

uvec2 otherMedia(uvec2 media) {
    return uvec2((media.x >> 16u) | (media.y << 16u), (media.y >> 16u) | 0xFFFF0000u);
}

bool inMedium(uvec2 media, uint instance) {
    for (uvec2 rest = media; firstMedium(rest) != NO_MEDIUM; rest = otherMedia(rest)) {
        if (firstMedium(rest) == instance) {
            return true;
        }
    }
    return false;
}

// Into the volume of an instance: in front of the others (already in it: unchanged; all slots taken: the one entered
// longest ago is forgotten; instances past 16 bits can't be media)
uvec2 enterMedium(uvec2 media, uint instance) {
    if (instance < NO_MEDIUM && !inMedium(media, instance)) {
        media = uvec2((media.x << 16u) | instance, (media.y << 16u) | (media.x >> 16u));
    }
    return media;
}

// Out of it: the others stay, packed
uvec2 leaveMedium(uvec2 media, uint instance) {
    uvec2 kept = OUTSIDE;
    uint count = 0;
    for (uvec2 rest = media; firstMedium(rest) != NO_MEDIUM; rest = otherMedia(rest)) {
        if (firstMedium(rest) != instance) {
            setMediaSlot(kept, count++, firstMedium(rest));
        }
    }
    return kept;
}

uint mediumMaterial(uint instance) {
    return meshInfos[instances[instance].meshIndex].materialIndex;
}

bool fogVaries(uint material) {
    return FOG >= 2 && (materials[material].fogNoise != 0 || materials[material].fogEdge > 0.0);
}

// The density of the fog of volume `instance` at world point p, inside it (see "Varying density")
float fogDensityAt(uint instance, vec3 p) {
    uint material = mediumMaterial(instance);
    float density = materials[material].fogDensity;
    if (!fogVaries(material)) {
        return density;
    }
    vec3 local = instances[instance].worldToObject * (p - instances[instance].objectToWorld[3]);
    if (materials[material].fogNoise != 0) {
        // Drifting fog: the noise is read further back along the drift the longer it has drifted (wrapped: the
        // texture repeats every 1, and the product stays small enough for float precision)
        vec3 drifted = materials[material].fogNoiseOffset - fract(materials[material].fogDrift * scene.fogTime);
        float noise = textureLod(volumeTextures[0], local * materials[material].fogNoiseScale + drifted, 0.0).r;
        // The noise is spread evenly over 0..1 (Volumes.cpp): the top `coverage` of it is fog, rising from 0
        float coverage = materials[material].fogCoverage;
        density *= clamp((noise - (1.0 - coverage)) / max(coverage, 1e-3), 0.0, 1.0);
    }
    // The mesh's signed distance (negative inside): none outside, faded towards the surface inside
    uint mesh = instances[instance].meshIndex;
    int field = meshInfos[mesh].distanceField;
    if (field >= 0 && density > 0.0) {
        vec3 lower = meshInfos[mesh].boundsMin;
        vec3 uvw = (local - lower) / max(meshInfos[mesh].boundsMax - lower, vec3(1e-6));
        float inside = -textureLod(volumeTextures[nonuniformEXT(field)], uvw, 0.0).r;
        float edge = materials[material].fogEdge;
        density *= inside <= 0.0 ? 0.0 : edge > 0.0 ? smoothstep(0.0, 1.0, inside / edge) : 1.0;
    }
    return density;
}

// The media's majorant: their thicknesses added up. uneven: some of them varies.
float mediaMajorant(uvec2 media, out bool uneven) {
    float majorant = 0.0;
    uneven = false;
    for (uvec2 rest = media; firstMedium(rest) != NO_MEDIUM; rest = otherMedia(rest)) {
        uint material = mediumMaterial(firstMedium(rest));
        majorant += materials[material].fogDensity;
        uneven = uneven || fogVaries(material);
    }
    return majorant;
}

// Delta tracking (see "Fog") from the tentative step at t up to end: where the ray scatters, and in which volume
// (medium); end and NO_MEDIUM if it gets through
float deltaTrack(uvec2 media, vec3 origin, vec3 direction, float t, float end, float majorant, inout uint seed,
                 out uint medium) {
    medium = NO_MEDIUM;
    for (uint step = 0; step < MAX_FOG_STEPS && t < end; step++) {
        vec3 p = origin + direction * t;
        float u = randomFloat(seed) * majorant;
        for (uvec2 rest = media; firstMedium(rest) != NO_MEDIUM; rest = otherMedia(rest)) {
            u -= fogDensityAt(firstMedium(rest), p);
            if (u < 0.0) {
                medium = firstMedium(rest);
                return t;
            }
        }
        t -= log(1.0 - randomFloat(seed)) / majorant;
    }
    return end;
}

// The share of light that gets through the fog of one volume from t = a to b along a ray: ratio tracking (see
// "Varying density"). Where little is left, Russian roulette: it goes on with chance transmittance / 0.1, counted as
// 0.1, which keeps the average.
float ratioTrack(uint instance, vec3 origin, vec3 direction, float a, float b, inout uint seed) {
    float majorant = materials[mediumMaterial(instance)].fogDensity;
    float transmittance = 1.0;
    float t = a;
    for (uint step = 0; step < MAX_FOG_STEPS; step++) {
        t -= log(1.0 - randomFloat(seed)) / majorant;
        if (t >= b) {
            break;
        }
        transmittance *= 1.0 - fogDensityAt(instance, origin + direction * t) / majorant;
        if (transmittance < 0.1) {
            if (randomFloat(seed) * 0.1 >= transmittance) {
                return 0.0;
            }
            transmittance = 0.1;
        }
    }
    return transmittance;
}

// Whether a ray along direction crosses a triangle from the outside (the side its vertex normals point to, as in
// hitFromIntersection)
bool entersMesh(MeshInfo mesh, uvec3 corner, vec3 weights, mat3 worldToObject, vec3 direction) {
    vec3 p0 = vertices[corner.x].position;
    vec3 outward = cross(vertices[corner.y].position - p0, vertices[corner.z].position - p0) * worldToObject;
    if (mesh.hasNormals != 0) {
        vec3 smoothNormal = vertices[corner.x].normal * weights.x + vertices[corner.y].normal * weights.y
                            + vertices[corner.z].normal * weights.z;
        if (dot(outward, smoothNormal * worldToObject) < 0.0) {
            outward = -outward;
        }
    }
    return dot(outward, direction) < 0.0;
}

// The next surface of a fog volume along a ray, from tMin up to tMax, among the TLAS groups in mask, leaving out the
// triangles `passed` (the ones the ray just went through, see traverse). false: none. instance, primitive, t: which and
// where; entering: from its outside.
bool nextFogSurface(vec3 origin, vec3 direction, float tMin, float tMax, uint mask, uvec4 passed, out uint instance,
                    out int primitive, out float t, out bool entering) {
    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, tlas, gl_RayFlagsNoneEXT, mask, origin, tMin, direction, tMax);
    while (rayQueryProceedEXT(rayQuery)) {
        // (fog volumes are all "not opaque": for the shadow rays)
        if (notPassed(rayQuery, passed)) {
            rayQueryConfirmIntersectionEXT(rayQuery);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        return false;
    }
    instance = rayQueryGetIntersectionInstanceIdEXT(rayQuery, true);
    primitive = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);
    t = rayQueryGetIntersectionTEXT(rayQuery, true);
    MeshInfo mesh = meshInfos[rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true)];
    uint firstIndex = mesh.indexOffset + uint(primitive) * 3;
    uvec3 corner = mesh.vertexOffset + uvec3(indices[firstIndex + 0], indices[firstIndex + 1], indices[firstIndex + 2]);
    vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
    entering = entersMesh(mesh, corner, vec3(1.0 - bary.x - bary.y, bary.x, bary.y), instances[instance].worldToObject,
                          direction);
    return true;
}

// Going on along a ray from a surface at t: from the same distance (a surface right there, like a floor under a fog
// box, still counts), only that triangle left out (rounding: it may be a hair closer)
float pastSurface(float tMin, float t) {
    return max(tMin, t - max(1e-4, t * 1e-5));
}

// The fog volumes p is in: the fog surfaces straight above it, in order; a volume whose first one is seen from the
// inside holds p. Up to MAX_VOLUME_CROSSINGS surfaces and MAX_MEDIA volumes.
uvec2 mediumAt(vec3 p) {
    uvec2 media = OUTSIDE;
    uvec2 seen = OUTSIDE;
    float tMin = 0.0;
    uvec4 passed = uvec4(~0u);
    for (uint crossing = 0; crossing < MAX_VOLUME_CROSSINGS; crossing++) {
        uint instance;
        int primitive;
        float t;
        bool entering;
        if (!nextFogSurface(p, vec3(0.0, 1.0, 0.0), tMin, RAY_FAR, FOG_MASK | VARYING_FOG_MASK, passed, instance,
                            primitive, t, entering)) {
            break;
        }
        if (!inMedium(seen, instance)) {
            if (mediaSlot(seen, MAX_MEDIA - 1) != NO_MEDIUM) {
                break;  // no room to remember more
            }
            seen = enterMedium(seen, instance);
            if (!entering) {
                media = enterMedium(media, instance);
            }
        }
        tMin = pastSurface(tMin, t);
        passed = uvec4(instance, uint(primitive), passed.xy);
    }
    return media;
}

// The share of scattered light that goes into a direction at cosine cosTheta to the light's own, per solid angle
// (Henyey-Greenstein: g = 0: every way alike, towards 1: mostly on forward)
float fogPhase(float cosTheta, float g) {
    float d = 1.0 + g * g - 2.0 * g * cosTheta;
    return (1.0 - g * g) / (4.0 * PI * d * sqrt(d));
}

// A direction picked by fogPhase around `forward` (the ray's); pdf = fogPhase of it
vec3 sampleFogDirection(vec3 forward, float g, vec2 u, out float pdf) {
    float cosTheta = 1.0 - 2.0 * u.x;
    if (abs(g) > 1e-3) {
        float s = (1.0 - g * g) / (1.0 - g + 2.0 * g * u.x);
        cosTheta = clamp((1.0 + g * g - s * s) / (2.0 * g), -1.0, 1.0);
    }
    pdf = fogPhase(cosTheta, g);
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    float phi = 2.0 * PI * u.y;
    vec3 tangent, bitangent;
    buildBasis(forward, tangent, bitangent);
    return normalize(tangent * (sinTheta * cos(phi)) + bitangent * (sinTheta * sin(phi)) + forward * cosTheta);
}

// A stretch [a, b] of a ray inside fog (the volumes media, their majorant), for the lamps' light (see Intersection):
// kept with a chance of its majorant times its length among all so far
void addLampSpan(inout Intersection hit, float a, float b, uvec2 media, float majorant, inout uint seed) {
    float weight = majorant * (b - a);
    if (CACHE_UPDATE_PASS != 0 || punctualLightCount() == 0 || !(weight > 0.0)) {
        return;
    }
    hit.lampWeight += weight;
    if (randomFloat(seed) * hit.lampWeight < weight) {
        hit.lampSpan = vec2(a, b);
        hit.lampMedia = media;
        hit.lampMajorant = majorant;
    }
}

// The stretch of a ray (up to end) inside the bounding box of an instance's mesh; x >= y: none
vec2 boxSpan(uint instance, vec3 origin, vec3 direction, float end) {
    uint mesh = instances[instance].meshIndex;
    // In the mesh's space: the same t along the ray (the direction isn't normalized there)
    vec3 o = instances[instance].worldToObject * (origin - instances[instance].objectToWorld[3]);
    vec3 d = instances[instance].worldToObject * direction;
    vec3 inverse = 1.0 / mix(d, vec3(1e-30), equal(d, vec3(0.0)));
    vec3 a = (meshInfos[mesh].boundsMin - o) * inverse;
    vec3 b = (meshInfos[mesh].boundsMax - o) * inverse;
    vec3 near = min(a, b), far = max(a, b);
    return vec2(max(max(near.x, near.y), max(near.z, 0.0)), min(min(far.x, far.y), min(far.z, end)));
}

// Varying fog in shadow rays: the share of light that gets through it between origin and origin + direction * end
// (see "Varying density"). Its volumes: the ones the ray starts in (media; the even ones are shadowTransmittance's), and
// the ones whose surfaces it crosses (crossed, noted in shadowTransmittance's traversal). Each is ratio-tracked along the
// ray's stretch through its bounding box: outside the mesh its density is 0, so that holds all its fog, whatever the
// mesh's shape, without knowing where the ray goes in and out.
float varyingTransmittance(vec3 origin, vec3 direction, float end, uvec2 media, uvec2 crossed, inout uint seed) {
    uvec2 volumes = crossed;
    for (uvec2 rest = media; firstMedium(rest) != NO_MEDIUM; rest = otherMedia(rest)) {
        if (fogVaries(mediumMaterial(firstMedium(rest)))) {
            volumes = enterMedium(volumes, firstMedium(rest));
        }
    }
    float transmittance = 1.0;
    for (uvec2 rest = volumes; firstMedium(rest) != NO_MEDIUM; rest = otherMedia(rest)) {
        vec2 span = boxSpan(firstMedium(rest), origin, direction, end);
        if (span.x < span.y) {
            transmittance *= ratioTrack(firstMedium(rest), origin, direction, span.x, span.y, seed);
            if (transmittance <= 0.0) {
                return 0.0;
            }
        }
    }
    return transmittance;
}

// ---------------------------------------------------------------------------------------------
// Portals
//
// Pairs of flat openings (rectangles or ellipses) placed in the editor. A ray that crosses one, from either side,
// goes on from the other one, as if both were the same window: entering the front of one, it leaves the front of
// the other, entering the back, the back. Each end is one entry, the pair's ends are entries 2k and 2k + 1;
// toPartner takes points and directions from an end to its partner. Rigid (no scaling), so a hit's distance along
// the whole bent ray is the sum of its parts.
// They are not in the TLAS: a ray is traced up to the nearest opening it crosses (tested here; there are only a
// few), and if it hits nothing before that, on from the partner. Two portals facing each other (or one that sees
// itself through the other) would send a ray back and forth forever: after MAX_PORTAL_CROSSINGS crossings it is
// lost, and no light comes back along it (black).
// Rays that must go in a straight line to a point (shadow rays, ReSTIR's visibility and reconnections) count an
// opening as blocking. The sun and the punctual lights also shine through portals: light sampling aims at their
// images, where they appear through each end (portalLightImage). Other light through a portal (glowing surfaces,
// the sky, the sun after two portals or more) is only found by bounce rays that happen to go through.
struct Portal {
    vec3 center;
    float halfWidth;
    vec3 normal;         // the side it faces
    float halfHeight;
    vec3 right;          // along its width; its height is along cross(normal, right)
    uint shape;          // PORTAL_RECTANGLE, PORTAL_ELLIPSE
    mat4x3 toPartner;
};
layout(binding = 31, scalar) readonly buffer Portals { Portal portals[]; };
const uint PORTAL_ELLIPSE = 1;
const uint MAX_PORTAL_CROSSINGS = 8;
// A ray stops this far before an opening and starts this far after its partner: geometry in the opening's plane
// is left out, so a portal set flush into a wall shows what is behind its partner, not the wall.
const float PORTAL_GAP = 1e-3;

// The nearest opening a ray crosses before maxT, and its distance t; -1: none. skip: an end to leave out (the one
// the ray just came out of: it starts on that plane).
// Whether a ray crosses end i's opening before maxT, and where (t)
bool portalOpeningHit(uint i, vec3 origin, vec3 direction, float maxT, out float t) {
    vec3 normal = portals[i].normal;
    float facing = dot(direction, normal);
    t = dot(portals[i].center - origin, normal) / facing;
    if (abs(facing) < 1e-8 || !(t > 0.0 && t < maxT)) {
        return false;
    }
    vec3 offset = origin + direction * t - portals[i].center;
    vec3 right = portals[i].right;
    vec2 p = vec2(dot(offset, right) / portals[i].halfWidth, dot(offset, cross(normal, right)) / portals[i].halfHeight);
    return portals[i].shape == PORTAL_ELLIPSE ? dot(p, p) <= 1.0 : max(abs(p.x), abs(p.y)) <= 1.0;
}

int nearestPortal(vec3 origin, vec3 direction, float maxT, int skip, out float t) {
    t = maxT;
    int nearest = -1;
    for (uint i = 0; i < portalCount(); i++) {
        float distance;
        if (int(i) != skip && portalOpeningHit(i, origin, direction, t, distance)) {
            nearest = int(i);
            t = distance;
        }
    }
    return nearest;
}

// Whether a straight ray crosses an opening before distance (it is then blocked, see above)
bool portalBetween(vec3 origin, vec3 direction, float distance) {
    float t;
    return portalCount() > 0 && nearestPortal(origin, direction, distance, -1, t) >= 0;
}

// The closest hit along a ray (cut-outs decided with seed, see traverse), through portals and invisible surfaces:
// origin and direction become the last part's (the hit's t is along it). false: nothing hit, the ray leaves the
// scene along direction; or, with travelled = -1, it was lost in portals; or, with inFog, it scattered in fog first.
// media: the fog volumes it starts in (see "Fog"), changed by the invisible surfaces it goes through. fogU >= 0: it may
// scatter in fog (the first step is picked with fogU, later ones with seed); -1: it passes fog unchanged.
bool intersectClosest(inout vec3 origin, inout vec3 direction, inout uint seed, inout uvec2 media, float fogU,
                      out Intersection hit) {
    hit.travelled = 0.0;
    hit.crossings = 0;
    hit.inFog = false;
    hit.fogMedium = NO_MEDIUM;
    hit.lampSpan = vec2(0.0);
    hit.lampMedia = OUTSIDE;
    hit.lampMajorant = 0.0;
    hit.lampWeight = 0.0;
    bool fog = fogU >= 0.0;
    int skip = -1;
    float tMin = 0.0;
    uint volumes = 0;  // invisible surfaces gone through
    uvec4 passed = uvec4(~0u);  // the last two (see traverse)
    // Where it last went through invisible surfaces (-1: none), and the media before them. A surface at that same
    // distance (a floor under a fog box) counts as in front of them: it is in the fog the ray came through, so its
    // shadow and bounce rays start in that fog. (Before, the floor under a fog box was lit as if outside it: its
    // shadow rays to a light inside crossed no fog surface.)
    float passedT = -1.0;
    uvec2 mediaBefore = media;
    for (uint part = 0; part <= MAX_PORTAL_CROSSINGS + MAX_VOLUME_CROSSINGS; part++) {
        float portalT = RAY_FAR;
        int portal = portalCount() > 0 ? nearestPortal(origin, direction, RAY_FAR, skip, portalT) : -1;
        float tMax = portal >= 0 ? max(portalT - PORTAL_GAP, tMin) : RAY_FAR;
        bool uneven = false;
        float majorant = FOG != 0 && fog ? mediaMajorant(media, uneven) : 0.0;
        // The first tentative step. In even fog it is where the ray scatters, so the ray query only needs to look that
        // far; in varying fog the query finds the surface first, and the steps go on up to it (deltaTrack).
        float fogT = RAY_FAR;
        if (majorant > 0.0) {
            fogT = tMin - log(1.0 - (fogU >= 0.0 ? fogU : randomFloat(seed))) / majorant;
            fogU = -1.0;
        }
        rayQueryEXT rayQuery;
        rayQueryInitializeEXT(rayQuery, tlas, PATH_RAY_FLAGS, 0xFF, origin, tMin, direction,
                              uneven ? tMax : min(tMax, fogT));
        traverse(rayQuery, seed, volumes < MAX_VOLUME_CROSSINGS, passed);
        bool surface = rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
        float end = surface ? rayQueryGetIntersectionTEXT(rayQuery, true) : tMax;
        if (FOG != 0 && fogT < end) {
            uint medium;
            fogT = deltaTrack(media, origin, direction, fogT, end, majorant, seed, medium);
            if (medium != NO_MEDIUM) {
                addLampSpan(hit, tMin, fogT, media, majorant, seed);
                hit.t = fogT;
                hit.inFog = true;
                hit.fogMedium = mediumMaterial(medium);
                return false;
            }
        }
        if (surface) {
            hit.meshIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
            hit.instanceIndex = rayQueryGetIntersectionInstanceIdEXT(rayQuery, true);
            hit.primitive = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);
            hit.barycentrics = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
            hit.t = end;
            MeshInfo mesh = meshInfos[hit.meshIndex];
            uint material = mesh.materialIndex;
            float boundaryDensity = materials[material].fogDensity;
            bool invisible = materials[material].invisible != 0;
            if (FOG != 0 && (invisible || boundaryDensity > 0.0)) {
                // A volume's surface: into it or out of it
                uint firstIndex = mesh.indexOffset + uint(hit.primitive) * 3;
                uvec3 corner = mesh.vertexOffset + uvec3(indices[firstIndex + 0], indices[firstIndex + 1], indices[firstIndex + 2]);
                vec3 weights = vec3(1.0 - hit.barycentrics.x - hit.barycentrics.y, hit.barycentrics.x, hit.barycentrics.y);
                bool entering = entersMesh(mesh, corner, weights, instances[hit.instanceIndex].worldToObject, direction);
                if (!entering && boundaryDensity > 0.0 && !inMedium(media, hit.instanceIndex)) {
                    // Out of fog it didn't know it was in: the stretch before was inside it too (see "Fog"). The others
                    // let the ray through up to here, so only this one's steps decide.
                    media = enterMedium(media, hit.instanceIndex);
                    if (fog) {
                        uint caught;
                        float catchUp = deltaTrack(enterMedium(OUTSIDE, hit.instanceIndex), origin, direction,
                                                   tMin - log(1.0 - (fogU >= 0.0 ? fogU : randomFloat(seed))) / boundaryDensity,
                                                   hit.t, boundaryDensity, seed, caught);
                        fogU = -1.0;
                        addLampSpan(hit, tMin, catchUp, media, majorant + boundaryDensity, seed);
                        if (caught != NO_MEDIUM) {
                            hit.t = catchUp;
                            hit.inFog = true;
                            hit.fogMedium = material;
                            return false;
                        }
                    }
                } else {
                    addLampSpan(hit, tMin, hit.t, media, majorant, seed);
                }
                if (invisible) {
                    // On through it, along the same ray
                    if (passedT < 0.0 || hit.t > passedT + max(1e-4, passedT * 1e-5)) {
                        passedT = hit.t;
                        mediaBefore = media;
                    }
                    if (boundaryDensity > 0.0) {
                        media = entering ? enterMedium(media, hit.instanceIndex) : leaveMedium(media, hit.instanceIndex);
                    }
                    tMin = pastSurface(tMin, hit.t);
                    passed = uvec4(hit.instanceIndex, uint(hit.primitive), passed.xy);
                    volumes++;
                    continue;
                }
            } else {
                addLampSpan(hit, tMin, hit.t, media, majorant, seed);
            }
            if (passedT >= 0.0 && hit.t <= passedT + max(1e-4, passedT * 1e-5)) {
                media = mediaBefore;
            }
            return true;
        }
        if (portal < 0) {
            return false;
        }
        hit.travelled += portalT;
        hit.crossings++;
        mat4x3 toPartner = portals[portal].toPartner;
        origin = toPartner * vec4(origin + direction * portalT, 1.0);
        direction = normalize(mat3(toPartner) * direction);
        skip = portal ^ 1;
        tMin = PORTAL_GAP;
        passedT = -1.0;
        hit.lampWeight = 0.0;  // the lamps' light: only in the last part (see fogLampLight)
        if (FOG != 0 && fog) {
            // The partner may be in other fog (or none): the fog the ray goes on in is the fog there. (Rays that only
            // look pass fog unchanged and skip it.)
            media = mediumAt(origin);
        }
    }
    hit.travelled = -1.0;
    return false;
}

// The same for rays that only look (no fog of their own)
bool intersectClosest(inout vec3 origin, inout vec3 direction, inout uint seed, out Intersection hit) {
    uvec2 media = OUTSIDE;
    return intersectClosest(origin, direction, seed, media, -1.0, hit);
}

// The surface at an intersection of a ray along direction: position, normals, material.
// coneWidth, coneSpread: the ray's cone at its origin (see uvFootprint); 0, 0 reads every texture at full size.
Hit hitFromIntersection(Intersection intersection, vec3 direction, float coneWidth, float coneSpread) {
    Hit hit;
    hit.found = true;
    hit.meshIndex = intersection.meshIndex;
    hit.instanceIndex = intersection.instanceIndex;
    MeshInfo mesh = meshInfos[hit.meshIndex];
    int primitive = intersection.primitive;
    uint firstIndex = mesh.indexOffset + uint(primitive) * 3;
    int firstLight = instanceFirstLight[hit.instanceIndex];
    hit.lightIndex = firstLight >= 0 ? firstLight + primitive : -1;
    // The corners' attributes are read where they are needed, not all at once: normals and tangents read before
    // the material's texture reads would sit in registers meanwhile.
    uvec3 corner = mesh.vertexOffset + uvec3(indices[firstIndex + 0], indices[firstIndex + 1], indices[firstIndex + 2]);

    vec2 bary = intersection.barycentrics;
    vec3 weights = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);

    hit.t = intersection.travelled + intersection.t;  // through portals: the whole way
    vec2 uv0 = vertices[corner.x].uv;
    vec2 uv1 = vertices[corner.y].uv;
    vec2 uv2 = vertices[corner.z].uv;
    hit.uv = uv0 * weights.x + uv1 * weights.y + uv2 * weights.z;
    hit.materialIndex = mesh.materialIndex;

    // Normals are transformed with the inverse transpose of the object's matrix;
    // n * M == transpose(M) * n, and M (world -> object) is already the inverse.
    // The matrices are read from the instance buffer where they are used: kept in registers from the start, they
    // would take 18 of them across the texture reads below.

    // The position from the triangle: as exact as floats allow (offsetRay counts on it), unlike origin + t *
    // direction. Flat normal from the triangle's edges.
    vec3 p0 = vertices[corner.x].position;
    vec3 edge1 = vertices[corner.y].position - p0;
    vec3 edge2 = vertices[corner.z].position - p0;
    hit.position = instances[hit.instanceIndex].objectToWorld * vec4(p0 + edge1 * bary.x + edge2 * bary.y, 1.0);
    hit.geometricNormal = normalize(cross(edge1, edge2) * instances[hit.instanceIndex].worldToObject);

    float footprintWidth = scene.textureMipmaps != 0 ? coneWidth + coneSpread * hit.t : 0.0;
    mat3 objectToWorld = mat3(instances[hit.instanceIndex].objectToWorld);
    uvFootprint(objectToWorld * edge1, objectToWorld * edge2, uv1 - uv0, uv2 - uv0, direction, footprintWidth,
                hit.uvFootprintX, hit.uvFootprintY);
    evaluateMaterial(hit);

    // Smooth normal: the per-vertex normals from the file, blended across the triangle. Makes a coarse
    // mesh look round. Without them, fall back to the flat one.
    hit.tangent = vec3(0.0);
    if (mesh.hasNormals != 0) {
        vec3 smoothNormal = vertices[corner.x].normal * weights.x + vertices[corner.y].normal * weights.y
                            + vertices[corner.z].normal * weights.z;
        hit.normal = normalize(smoothNormal * instances[hit.instanceIndex].worldToObject);

        // Normal map: a texture of small surface directions (bumps, scratches, seams) that don't exist in the
        // geometry. They are stored relative to the surface: X along the tangent, Y along the bitangent, Z along
        // the normal. Tangents are directions ON the surface, so they transform like positions, not like normals.
        Material material = materials[mesh.materialIndex];
        if (mesh.hasTangents != 0) {
            vec4 tangent = vertices[corner.x].tangent * weights.x + vertices[corner.y].tangent * weights.y
                           + vertices[corner.z].tangent * weights.z;
            mat3 objectToWorld = mat3(instances[hit.instanceIndex].objectToWorld);
            vec3 t = objectToWorld * tangent.xyz;
            t -= hit.normal * dot(hit.normal, t);  // interpolation bends it slightly off the surface
            // Broken tangents in the file (along the normal, or corners pointing opposite ways so the blend
            // cancels out) leave nothing to normalize: NaN, which would ruin the pixel for good. Any direction
            // on the surface will do there; the normal map is then just rotated on that tiny spot.
            if (dot(t, t) < 1e-12) {
                t = cross(abs(hit.normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), hit.normal);
            }
            t = normalize(t);
            hit.tangent = t;

            if (material.normalTexture >= 0) {
                // A mirrored instance (negative scale) flips the bitangent as well
                float sign = (tangent.w < 0.0 ? -1.0 : 1.0) * (determinant(objectToWorld) < 0.0 ? -1.0 : 1.0);
                vec3 b = cross(hit.normal, t) * sign;
                vec3 mapped = sampleTexture(material.normalTexture, material.normalUvTransform, hit).rgb * 2.0 - 1.0;  // [0,1] -> [-1,1]
                if (material.normalTwoChannel != 0) {
                    mapped.z = sqrt(max(1.0 - dot(mapped.xy, mapped.xy), 0.0));
                }
                mapped.xy *= material.normalScale;
                // A rotated (or mirrored) texture turns its bumps with it: the map's X/Y follow the texture's axes,
                // the tangent frame follows the mesh UVs. X/Y are a slope (the normal leans away from where the
                // surface rises), and a slope goes from texture to mesh UVs through the transposed matrix. In UV
                // terms the map's Y is -V. The length is kept, so tiling a texture doesn't make its bumps steeper.
                mat2 toTexture = mat2(material.normalUvTransform[0], material.normalUvTransform[1]);
                vec2 slope = transpose(toTexture) * vec2(mapped.x, -mapped.y);
                float slopeLength = length(slope);
                if (slopeLength > 1e-8) {
                    mapped.xy = vec2(slope.x, -slope.y) * (length(mapped.xy) / slopeLength);
                }
                hit.normal = normalize(t * mapped.x + b * mapped.y + hit.normal * mapped.z);

                // Toksvig: the bumps this level averages away widen the reflection by the alpha stored for it
                // (see makeNormalVarianceTexture), added to the material's alpha^2 (as two independent spreads).
                // That texture is half the size: read with the same footprint it gives the right level, except
                // between the normal map's levels 0 and 1, where it fades out (the full size averages nothing).
                if (scene.normalMapFiltering != 0 && material.normalVarianceTexture >= 0 && hit.uvFootprintX != vec2(0.0)) {
                    vec2 texels = vec2(textureSize(textures[nonuniformEXT(material.normalTexture)], 0));
                    // The level the GPU reads: from the footprint's short axis (filtered along the long one)
                    float level = log2(min(length(toTexture * hit.uvFootprintX * texels),
                                           length(toTexture * hit.uvFootprintY * texels)));
                    float bumps = sampleTexture(material.normalVarianceTexture, material.normalUvTransform, hit).r
                                  * clamp(level, 0.0, 1.0) * material.normalScale;
                    float alpha = hit.roughness * hit.roughness;
                    hit.roughness = sqrt(sqrt(alpha * alpha + bumps * bumps));
                }
            }
        }
        // The vertex normals define which side is "outside"; the winding order may disagree.
        if (dot(hit.geometricNormal, hit.normal) < 0.0) {
            hit.geometricNormal = -hit.geometricNormal;
        }
    } else {
        hit.normal = hit.geometricNormal;
    }

    // The normals still point outwards here: tells whether the ray enters or leaves a solid.
    hit.frontFace = dot(hit.geometricNormal, direction) < 0.0;
    hit.objectScale = length(instances[hit.instanceIndex].worldToObject * direction) * mesh.unitScale;

    // Triangles are double-sided: if we hit the back, flip both normals towards the ray.
    if (!hit.frontFace) {
        hit.geometricNormal = -hit.geometricNormal;
        hit.normal = -hit.normal;
    }
    return hit;
}

// The reflection formulas need the viewer above the shading normal. A smooth or normal-mapped normal can tilt
// away from the viewer near silhouettes; tilt it back just far enough.
void tiltTowardsViewer(inout Hit hit, vec3 direction) {
    float cosViewer = dot(hit.normal, -direction);
    if (cosViewer < 1e-3) {
        hit.normal = normalize(hit.normal - direction * (1e-3 - cosViewer));
    }
}

// A path's scatter point in fog (see "Fog") as a Hit, so the path's loop lights it and bounces from it like a
// surface: marked by its material (isFog), the fog's material in meshIndex, facing back along the ray, light from
// every side (two-sided, as diffuse transmission), no ReSTIR and no cache (restirSurface, cacheableSurface). Its
// color is in the throughput.
const uint FOG_MATERIAL = 0xFFFFFFFFu;

Hit fogHit(vec3 position, vec3 direction, float t, uint medium) {
    Hit hit;
    hit.found = true;
    hit.t = t;
    hit.position = position;
    hit.normal = -direction;
    hit.geometricNormal = -direction;
    hit.tangent = vec3(0.0);
    hit.uv = vec2(0.0);
    hit.uvFootprintX = vec2(0.0);
    hit.uvFootprintY = vec2(0.0);
    hit.meshIndex = medium;
    hit.instanceIndex = 0;
    hit.materialIndex = FOG_MATERIAL;
    hit.lightIndex = -1;
    hit.frontFace = true;
    hit.objectScale = 1.0;
    hit.albedo = materials[medium].fogColor;
    hit.alpha = 1.0;
    hit.metallic = 0.0;
    hit.roughness = 1.0;
    hit.transmission = 0.0;
    hit.ior = 1.0;
    hit.solid = false;
    hit.absorption = vec3(0.0);
    hit.diffuseTransmission = 1.0;
    hit.diffuseTransmissionColor = vec3(1.0);
    hit.emissive = vec3(0.0);
    return hit;
}

bool isFog(Hit hit) {
    return FOG != 0 && hit.materialIndex == FOG_MATERIAL;
}

Hit traceClosest(vec3 origin, vec3 direction, inout uint seed, float coneWidth, float coneSpread) {
    Intersection intersection;
    if (!intersectClosest(origin, direction, seed, intersection)) {
        Hit hit;
        hit.found = false;
        return hit;
    }
    return hitFromIntersection(intersection, direction, coneWidth, coneSpread);
}

// Where a direction lands on the environment map, and back. u goes around the horizon (the same way as in
// Blender, so a map looks the same there), v from straight up (0) to straight down (1).
vec2 environmentUv(vec3 direction) {
    float angle = atan(-direction.z, -direction.x) + scene.environmentRotation;
    return vec2(fract(angle / (2.0 * PI) + 0.5), acos(clamp(direction.y, -1.0, 1.0)) / PI);
}

vec3 environmentDirection(float u, float cosTheta) {
    float angle = 2.0 * PI * (u - 0.5) - scene.environmentRotation;
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    return vec3(-sinTheta * cos(angle), cosTheta, -sinTheta * sin(angle));
}

// Light coming from the environment in a direction: the HDR map, or a sky gradient above the horizon and
// ground below. The sun is NOT part of it, it is handled separately with shadow rays (see tracePath).
vec3 environmentLight(vec3 direction) {
    if (scene.environmentMap != 0) {
        return textureLod(environmentMap, environmentUv(direction), 0.0).rgb * scene.environmentIntensity;
    }
    float skyT = pow(smoothstep(0.0, 0.4, direction.y), 0.35);
    vec3 sky = mix(scene.skyHorizonColor.rgb, scene.skyZenithColor.rgb, skyT);
    float groundToSky = smoothstep(-0.01, 0.0, direction.y);
    return mix(scene.groundColor.rgb, sky, groundToSky);
}

// ---------------------------------------------------------------------------------------------
// How a surface reflects light (the BRDF), following the glTF reference model (spec appendix B)
//
// Every surface is a mix of two layers:
//  - diffuse: light enters the material, scatters around and leaves in a random direction, tinted by the
//    base color. Metals don't have it: light that enters a metal is absorbed.
//  - specular: light reflects off the surface itself, like a mirror. A rough surface is modeled as many tiny
//    mirrors (microfacets) with random tilts; the rougher, the more they spread and the blurrier the
//    reflection. GGX is the standard distribution of those tilts.
// How much is reflected by the specular layer is the Fresnel effect: a few percent when looking straight at
// glass or plastic (more for a higher IOR), rising to 100% at grazing angles. Metals reflect a lot at any
// angle, in their own color (gold, copper), which glTF stores as the base color.
//
// Directions here are "local": in a frame where the shading normal is +Z. Both v (towards the viewer) and
// l (towards the light) point away from the surface.

struct ShadingFrame {
    vec3 tangent;
    vec3 bitangent;
    vec3 normal;
};

ShadingFrame makeShadingFrame(vec3 normal) {
    ShadingFrame frame;
    frame.normal = normal;
    buildBasis(normal, frame.tangent, frame.bitangent);
    return frame;
}

vec3 toLocal(ShadingFrame frame, vec3 v) {
    return vec3(dot(v, frame.tangent), dot(v, frame.bitangent), dot(v, frame.normal));
}

vec3 toWorld(ShadingFrame frame, vec3 v) {
    return frame.tangent * v.x + frame.bitangent * v.y + frame.normal * v.z;
}

float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

// glTF's roughness is perceptual; the GGX formulas use alpha = roughness^2. A perfect mirror (alpha 0) would
// need its own special case, a tiny minimum makes it an extremely sharp but still "normal" lobe.
// Bounce light clamp (DLSS modes): light that reached the camera after reflecting off two or more surfaces (the
// first surface's indirect light) adds at most scene.bounceLightClamp per sample. Such light is found by chance
// (a bounce ray that happens to hit a small bright lamp): rare, very bright samples that DLSS can't tell from
// detail, so it keeps them for many frames (ghosting) and the image settles slowly. Direct light at the first
// surface (ReSTIR, the shadow rays, lamps seen in a glossy reflection) is never clamped. The limit is set on screen
// (RayTracer.cpp), so it means the same at night and by day. Biased: the clamped light is lost.
vec3 clampBounceLight(vec3 light, uint reflections) {
    if (CACHE_UPDATE_PASS == 0 && scene.bounceLightClamp > 0.0 && reflections >= 2) {
        float l = luminance(light);
        if (l > scene.bounceLightClamp) {
            light *= scene.bounceLightClamp / l;
        }
    }
    return light;
}

float ggxAlpha(float roughness) {
    return max(roughness * roughness, 1e-6);
}

// Reflectance at normal incidence of a non-metal, from its index of refraction: 0.04 for IOR 1.5.
float dielectricF0(float ior) {
    float r = (ior - 1.0) / (ior + 1.0);
    return r * r;
}

// Schlick's approximation of Fresnel: f0 looking straight at the surface, rising to 1 at grazing angles.
float fresnelSchlick(float f0, float cosTheta) {
    return f0 + (1.0 - f0) * pow(1.0 - clamp(cosTheta, 0.0, 1.0), 5.0);
}

vec3 fresnelSchlick(vec3 f0, float cosTheta) {
    return f0 + (1.0 - f0) * pow(1.0 - clamp(cosTheta, 0.0, 1.0), 5.0);
}

// GGX distribution D: how many microfacets face the half vector h, from the sine^2 and cosine of its angle to the
// normal. The sine^2 is passed instead of 1 - cos^2, which loses all precision for the very sharp lobes of smooth
// surfaces (cos is then 1 to many digits).
float ggxDistribution(float sinSquared, float cosTheta, float alpha) {
    float a2 = alpha * alpha;
    float d = sinSquared + cosTheta * cosTheta * a2;
    return a2 / (PI * d * d);
}

// Smith masking G1: the fraction of microfacets facing h that are visible from a direction at cosTheta
// (the others are hidden behind neighboring bumps).
float smithG1(float cosTheta, float alpha) {
    float a2 = alpha * alpha;
    return 2.0 * cosTheta / (cosTheta + sqrt(a2 + (1.0 - a2) * cosTheta * cosTheta));
}

// Smith visibility V = G2 / (4 * cos_l * cos_v), height-correlated: masking from v and shadowing towards l
// are not independent (a bump that hides one tends to hide the other).
float smithVisibility(float cosL, float cosV, float alpha) {
    float a2 = alpha * alpha;
    float gv = cosL * sqrt(cosV * cosV * (1.0 - a2) + a2);
    float gl = cosV * sqrt(cosL * cosL * (1.0 - a2) + a2);
    return 0.5 / max(gv + gl, 1e-12);
}

// Bilinear lookup in the specular albedo table
vec2 lookupSpecularAlbedo(float cosV, float roughness) {
    float last = float(SPECULAR_ALBEDO_SIZE - 1);
    vec2 p = clamp(vec2(cosV, roughness), 0.0, 1.0) * last;
    uvec2 i = uvec2(min(floor(p), vec2(last - 1.0)));
    vec2 f = p - vec2(i);
    uint row0 = i.y * SPECULAR_ALBEDO_SIZE + i.x;
    uint row1 = row0 + SPECULAR_ALBEDO_SIZE;
    return mix(mix(specularAlbedo[row0], specularAlbedo[row0 + 1], f.x),
               mix(specularAlbedo[row1], specularAlbedo[row1 + 1], f.x), f.y);
}

// Energy bookkeeping of the reflection layer for one view direction.
// The GGX reflection only counts light that reflects off ONE microfacet; light that would hit a neighbouring
// facet next is lost (up to ~70% at roughness 1). In reality it bounces on and mostly escapes. Turquin's fix:
// a white reflection returns E instead of 1, so scale it by 1 / E. For a colored or weak reflection the extra
// bounces return less (each bounce reflects only F0), hence the general factor 1 + F0 * (1 - E) / E.
struct ReflectionEnergy {
    float dielectricCompensation;  // multiplier for the reflection of plastics, glass, ...
    vec3 metalCompensation;        // and of metals (colored: gold gets more saturated with each bounce)
    float dielectricAlbedo;        // total light the (compensated) reflection of a non-metal returns
    vec3 metalAlbedo;              // and of a metal
};

ReflectionEnergy reflectionEnergy(Hit hit, float cosV) {
    vec2 table = lookupSpecularAlbedo(cosV, hit.roughness);
    float e = max(table.x + table.y, 1e-3);  // white reflection, single bounce
    float f0 = dielectricF0(hit.ior);
    ReflectionEnergy energy;
    energy.dielectricCompensation = 1.0 + f0 * (1.0 - e) / e;
    energy.metalCompensation = 1.0 + hit.albedo * (1.0 - e) / e;
    energy.dielectricAlbedo = min((f0 * table.x + table.y) * energy.dielectricCompensation, 1.0);
    energy.metalAlbedo = (hit.albedo * table.x + table.y) * energy.metalCompensation;
    return energy;
}

// Transmission (glass): what passes the reflection layer of a non-metal either scatters inside (diffuse) or
// goes through (transmission), in the ratio given by the transmission value. Light that goes through is
// tinted by the base color.
// Diffuse transmission (leaves, paper): of the diffuse layer, this share comes out on the other side (scattered
// evenly, tinted by its own color) instead of back on the side the light came from.
//
// Sampling picks one layer at random, each with its share of the light it returns. The specular one gets a
// minimum so that a highlight on a dark plastic still gets enough samples.
struct LobeProbabilities {
    float diffuse;
    float specular;
    float transmission;
    float diffuseTransmission;
};

LobeProbabilities lobeProbabilities(Hit hit, ReflectionEnergy energy) {
    float specular = mix(energy.dielectricAlbedo, luminance(energy.metalAlbedo), hit.metallic);
    float base = (1.0 - hit.metallic) * (1.0 - energy.dielectricAlbedo);
    float transmission = base * hit.transmission * luminance(hit.albedo);
    float diffuse = base * (1.0 - hit.transmission) * (1.0 - hit.diffuseTransmission) * luminance(hit.albedo);
    float diffuseTransmission = base * (1.0 - hit.transmission) * hit.diffuseTransmission
                                * luminance(hit.diffuseTransmissionColor);

    LobeProbabilities p;
    float total = specular + diffuse + transmission + diffuseTransmission;
    if (total <= 0.0) {
        p.diffuse = p.specular = p.transmission = p.diffuseTransmission = 0.0;
        return p;
    }
    p.specular = specular / total;
    float rest = diffuse + transmission + diffuseTransmission;
    if (specular > 0.0 && rest > 0.0) {
        p.specular = max(p.specular, 0.1);
    }
    float share = rest > 0.0 ? (1.0 - p.specular) / rest : 0.0;
    p.diffuse = diffuse * share;
    p.transmission = transmission * share;
    p.diffuseTransmission = diffuseTransmission * share;
    return p;
}

// Exact Fresnel reflectance of a smooth boundary between two clear media, eta = n(incident side) / n(other side).
// Unlike Schlick's formula it also works from inside glass, including total internal reflection (returns 1):
// beyond a critical angle no light can leave the denser medium.
float fresnelDielectric(float cosIncident, float eta) {
    float sin2Transmitted = eta * eta * (1.0 - cosIncident * cosIncident);
    if (sin2Transmitted >= 1.0) {
        return 1.0;
    }
    float cosTransmitted = sqrt(1.0 - sin2Transmitted);
    float rs = (eta * cosIncident - cosTransmitted) / (eta * cosIncident + cosTransmitted);
    float rp = (cosIncident - eta * cosTransmitted) / (cosIncident + eta * cosTransmitted);
    return 0.5 * (rs * rs + rp * rp);
}

// Reflected light towards v per unit of light arriving from l (the BRDF value), and the pdf with which
// sampleBrdf would pick l. Covers the reflecting layers (cosL > 0) and diffuse transmission (cosL < 0, light
// arriving from the other side of a thin surface). Light arriving through glass (specular transmission) is never
// evaluated this way (see shadowTransmittance and tracePath).
// Takes only what the formulas need: the cosines of v and l with the shading normal, of v with the half vector h,
// and h's sine^2 and cosine with the normal. These don't depend on the frame, so the light loop in tracePath can
// evaluate it from world-space vectors (evaluateBrdfWorld) without keeping a shading frame in registers.
vec3 evaluateBrdfAngles(Hit hit, float cosV, float cosL, float cosVH, float hSinSquared, float hCos, out float pdf) {
    if (cosL < 0.0) {
        // Diffuse transmission: Lambert on the other side. Only its own lobe produces such directions with a
        // pdf (specular transmission has none, see sampleBrdf).
        ReflectionEnergy energy = reflectionEnergy(hit, cosV);
        LobeProbabilities p = lobeProbabilities(hit, energy);
        pdf = p.diffuseTransmission * -cosL / PI;
        return (1.0 - hit.metallic) * (1.0 - energy.dielectricAlbedo) * (1.0 - hit.transmission)
               * hit.diffuseTransmission * hit.diffuseTransmissionColor / PI;
    }
    float alpha = ggxAlpha(hit.roughness);
    ReflectionEnergy energy = reflectionEnergy(hit, cosV);

    float d = ggxDistribution(hSinSquared, hCos, alpha);
    float specular = d * smithVisibility(cosL, cosV, alpha);
    float fresnelDielectric = fresnelSchlick(dielectricF0(hit.ior), cosVH);
    vec3 fresnelMetal = fresnelSchlick(hit.albedo, cosVH);

    // Dielectric: diffuse below, getting exactly the light the reflection doesn't return. (The glTF reference
    // takes away 1 - F(v.h) instead, which varies with the light direction: at grazing view angles diffuse +
    // reflection then add up to more than 100%, visible as bright rims in the white furnace.)
    vec3 dielectric = (1.0 - energy.dielectricAlbedo) * (1.0 - hit.transmission) * (1.0 - hit.diffuseTransmission)
                      * hit.albedo / PI
                      + fresnelDielectric * specular * energy.dielectricCompensation;
    vec3 metal = fresnelMetal * specular * energy.metalCompensation;
    vec3 brdf = mix(dielectric, metal, hit.metallic);

    // Diffuse: cosine-weighted. Specular: the VNDF pdf of h, converted to a pdf of l (the reflection doubles
    // angles, hence the 1 / (4 cos_vh)); simplifies to G1(v) * D / (4 cos_v). Transmission only produces
    // directions on the other side, so it adds nothing here (nor does diffuse transmission).
    LobeProbabilities p = lobeProbabilities(hit, energy);
    float pdfDiffuse = cosL / PI;
    float pdfSpecular = smithG1(cosV, alpha) * d / (4.0 * cosV);
    pdf = p.diffuse * pdfDiffuse + p.specular * pdfSpecular;
    return brdf;
}

// The same with local directions (the shading normal is +Z), as sampleBrdf has them. v.z > 0.
vec3 evaluateBrdf(Hit hit, vec3 v, vec3 l, out float pdf) {
    vec3 h = normalize(v + l);
    return evaluateBrdfAngles(hit, v.z, l.z, dot(v, h), h.x * h.x + h.y * h.y, h.z, pdf);
}

// The same with world-space directions and the shading normal n. dot(n, v) > 0.
vec3 evaluateBrdfWorld(Hit hit, vec3 n, vec3 v, vec3 l, out float pdf) {
    vec3 h = normalize(v + l);
    vec3 hAcross = cross(n, h);  // its length is the sine
    return evaluateBrdfAngles(hit, dot(n, v), dot(n, l), dot(v, h), dot(hAcross, hAcross), dot(n, h), pdf);
}

// Samples a microfacet normal from the facets visible from v (VNDF), so no samples are wasted on facets that
// face away from the viewer. Dupuy & Benyoub 2023, "Sampling Visible GGX Normals with Spherical Caps".
vec3 sampleGgxVisibleNormal(vec3 v, float alpha, vec2 u) {
    // stretch the view direction so the rough surface becomes a hemisphere of normals
    vec3 vStretched = normalize(vec3(v.xy * alpha, v.z));
    float phi = 2.0 * PI * u.x;
    float z = (1.0 - u.y) * (1.0 + vStretched.z) - vStretched.z;
    float sinTheta = sqrt(clamp(1.0 - z * z, 0.0, 1.0));
    vec3 hStretched = vec3(sinTheta * cos(phi), sinTheta * sin(phi), z) + vStretched;
    // and back
    return normalize(vec3(hStretched.xy * alpha, max(hStretched.z, 0.0)));
}

// Picks the direction the path continues in. Returns false if the sample is unusable (points into the
// surface); otherwise l, its pdf, and weight = BRDF * cos / pdf, the factor the path's throughput changes by.
// lobeRoughness: how spread out the picked layer is (the diffuse layer counts as fully rough).
// transmitted: the path went through glass (l.z < 0). Then pdf is meaningless (not used for MIS) and
// weight is simply the transmitted share of the light: the direction follows the visible microfacets.
// Diffuse transmission also gives l.z < 0, but is an ordinary scattering (transmitted = false, with a pdf).
// specularLobe: a reflection or transmission was picked, not the diffuse layer (for the DLSS hit distance).
// random: x picks the lobe, y and z the direction
bool sampleBrdf(Hit hit, vec3 v, vec3 random, out vec3 l, out vec3 weight, out float pdf,
                out float lobeRoughness, out bool transmitted, out bool specularLobe) {
    float u0 = random.x;
    vec2 u = random.yz;
    ReflectionEnergy energy = reflectionEnergy(hit, v.z);
    LobeProbabilities p = lobeProbabilities(hit, energy);
    transmitted = false;
    specularLobe = u0 < p.transmission + p.specular;

    if (u0 >= 1.0 - p.diffuseTransmission) {
        // Out the other side, cosine-weighted around the reversed normal
        lobeRoughness = 1.0;
        float r = sqrt(u.x);
        float phi = 2.0 * PI * u.y;
        l = vec3(r * cos(phi), r * sin(phi), -sqrt(max(1.0 - u.x, 0.0)));
        if (l.z >= -1e-6) {
            return false;
        }
        vec3 btdf = evaluateBrdf(hit, v, l, pdf);
        if (pdf <= 0.0) {
            return false;
        }
        weight = btdf * -l.z / pdf;
        return true;
    }

    if (u0 < p.transmission) {
        // Through the surface. A rough surface spreads the direction like it spreads reflections.
        transmitted = true;
        lobeRoughness = hit.roughness;
        vec3 h = sampleGgxVisibleNormal(v, ggxAlpha(hit.roughness), u);
        if (hit.solid) {
            // Entering glass: bends towards the normal (Snell's law, n_air / n_glass)
            l = refract(-v, h, 1.0 / hit.ior);
            if (l.z >= 0.0) {
                return false;  // also the zero vector refract() gives for total internal reflection
            }
        } else {
            // Thin: no bending, the way a window pane shifts the view slightly but keeps its direction.
            // Mirror the reflected direction to the other side.
            l = reflect(-v, h);
            if (l.z <= 0.0) {
                return false;
            }
            l.z = -l.z;
        }
        pdf = 0.0;
        weight = (1.0 - hit.metallic) * hit.transmission * (1.0 - energy.dielectricAlbedo) * hit.albedo / p.transmission;
        return true;
    }

    if (u0 < p.transmission + p.specular) {
        vec3 h = sampleGgxVisibleNormal(v, ggxAlpha(hit.roughness), u);
        l = reflect(-v, h);
        lobeRoughness = hit.roughness;
    } else {
        lobeRoughness = 1.0;
        // cosine-weighted around the normal: pick a uniform point on a disc and project it up
        float r = sqrt(u.x);
        float phi = 2.0 * PI * u.y;
        l = vec3(r * cos(phi), r * sin(phi), sqrt(max(1.0 - u.x, 0.0)));
    }
    if (l.z <= 1e-6) {
        return false;
    }
    vec3 brdf = evaluateBrdf(hit, v, l, pdf);
    if (pdf <= 0.0) {
        return false;
    }
    weight = brdf * l.z / pdf;
    return true;
}

// Inside solid glass, at the surface on the way out: either reflect back inside or refract out into the air,
// chosen by the exact Fresnel reflectance of the visible microfacet. Light isn't lost or tinted here (the tint
// was applied on the way in; absorption on the way through), so the weight is 1 either way.
// random: x chooses reflection or refraction, y and z the microfacet
bool sampleGlassExit(Hit hit, vec3 v, vec3 random, out vec3 l) {
    vec3 h = sampleGgxVisibleNormal(v, ggxAlpha(hit.roughness), random.yz);
    float fresnel = fresnelDielectric(dot(v, h), hit.ior);  // n_glass / n_air
    if (random.x < fresnel) {
        l = reflect(-v, h);
        return l.z > 0.0;
    }
    l = refract(-v, h, hit.ior);
    return l.z < 0.0;
}

// ---------------------------------------------------------------------------------------------
// Shadow rays

// How much light gets from origin to origin + direction * maxDistance: 0 if something opaque is in the way,
// otherwise the tint of the glass on the way. Glass is passed in a straight line, without bending: following
// the bent path to a light is what caustics would need, which we skip on purpose. crossedGlass tells the caller
// that this light can't also be found by a bounce ray (those are bent by the glass), so no MIS for it.
// crossedSolidGlass: some of it was solid. Thin panes don't bend rays, so for the sky the bounce rays through
// them do find the same light, and MIS stays on (see tracePath).
//
// Candidates on glass come in no particular order. Absorption inside a solid depends on the length inside,
// which is (sum of the distances where the ray leaves) - (sum where it enters) for any number of crossings,
// so it can be summed in any order.
// A portal's opening on the way blocks the light, except with throughEnd >= 0: a light image (portalLightImage),
// whose ray must go through that end's opening first and then on from its partner, maxDistance being the whole way.
// Fog (see "Fog"): invisible surfaces let the light through; its length inside even fog counts like the absorption,
// plus the fog it starts in (media) and ends in. Not knowing it started in fog, it learns it where it leaves it. Varying
// fog: varyingTransmittance, after the surfaces have let the light through.
vec3 shadowTransmittance(vec3 origin, vec3 direction, float maxDistance, int throughEnd, inout uint seed, uvec2 media,
                         out bool crossedGlass, out bool crossedSolidGlass) {
    crossedGlass = false;
    crossedSolidGlass = false;
    vec3 tint = vec3(1.0);
    int skip = -1;
    float tMin = 0.0;
    // The even fog's density where the part starts (and, after the loop, where it ends)
    float fogInside = 0.0;
    for (uvec2 rest = media; FOG != 0 && firstMedium(rest) != NO_MEDIUM; rest = otherMedia(rest)) {
        uint material = mediumMaterial(firstMedium(rest));
        fogInside += fogVaries(material) ? 0.0 : materials[material].fogDensity;
    }
    // (Cache update paths have no light images: a second part made them take 168 registers instead of 128)
    [[dont_unroll]] for (uint part = 0; part < (CACHE_UPDATE_PASS != 0 || !FEATURE_PORTALS ? 1u : 2u); part++) {
        // Up to the opening it must go through (part 0 of a light image), or to the end; any other opening blocks
        float portalT = maxDistance;
        int portal = portalCount() > 0 ? nearestPortal(origin, direction, maxDistance, skip, portalT) : -1;
        if (portal != (part == 0 ? throughEnd : -1)) {
            return vec3(0.0);
        }
        rayQueryEXT rayQuery;
        rayQueryInitializeEXT(rayQuery, tlas, gl_RayFlagsTerminateOnFirstHitEXT | SHADOW_RAY_FLAGS, 0xFF, origin, tMin,
                              direction, portal >= 0 ? max(portalT - PORTAL_GAP, tMin) : max(maxDistance, tMin));
        vec3 opticalDepth = vec3(0.0);
        float fogDepth = 0.0;  // even fog: density * (leaving distance - entering distance) over its surfaces
        uvec2 crossed = OUTSIDE;  // varying fog volumes whose surfaces it crosses
        while (rayQueryProceedEXT(rayQuery)) {
            if (SHADOW_RAY_FLAGS != gl_RayFlagsNoneEXT ||
                rayQueryGetIntersectionTypeEXT(rayQuery, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
                continue;
            }
            // Only what the next test needs is read at each step (the UVs first, the triangle's shape only for glass):
            // whatever is read early stays in registers through the tests, on top of the whole path's state.
            MeshInfo mesh = meshInfos[rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, false)];
            uint firstIndex = mesh.indexOffset + uint(rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, false)) * 3;
            uvec3 corner = mesh.vertexOffset + uvec3(indices[firstIndex + 0], indices[firstIndex + 1], indices[firstIndex + 2]);
            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rayQuery, false);
            vec3 weights = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);
            vec2 uv = vertices[corner.x].uv * weights.x + vertices[corner.y].uv * weights.y + vertices[corner.z].uv * weights.z;

            // through a hole of a cut-out
            float opacity = opacityAt(mesh.materialIndex, uv);
            if (opacity < 1.0 && (opacity <= 0.0 || randomFloat(seed) >= opacity)) {
                continue;
            }

            Material material = materials[mesh.materialIndex];
            if (FOG != 0 && (material.fogDensity > 0.0 || material.invisible != 0)) {
                if (fogVaries(mesh.materialIndex)) {
                    // Varying fog: only which volume (see varyingTransmittance, after this)
                    crossed = enterMedium(crossed, rayQueryGetIntersectionInstanceIdEXT(rayQuery, false));
                } else if (material.fogDensity > 0.0) {
                    bool entering = entersMesh(mesh, corner, weights,
                                               mat3(rayQueryGetIntersectionWorldToObjectEXT(rayQuery, false)), direction);
                    float t = rayQueryGetIntersectionTEXT(rayQuery, false);
                    fogDepth += material.fogDensity * (entering ? -t : t);
                    fogInside += entering ? material.fogDensity : -material.fogDensity;
                }
                if (material.invisible != 0) {
                    continue;
                }
            }
            float transmission = FEATURE_GLASS ? material.transmission : 0.0;
            if (transmission > 0.0 && material.transmissionTexture >= 0) {
                transmission *= sampleTextureFull(material.transmissionTexture, material.transmissionUvTransform, uv).r;
            }
            float metallic = material.metallic;
            if (transmission > 0.0 && material.metallicRoughnessTexture >= 0) {
                metallic *= sampleTextureFull(material.metallicRoughnessTexture, material.metallicRoughnessUvTransform, uv).b;
            }
            if (transmission <= 0.0 || metallic >= 1.0) {
                rayQueryConfirmIntersectionEXT(rayQuery);  // opaque: in shadow (and with TerminateOnFirstHit, done)
                break;
            }

            // Glass: the share that passes is what neither the reflection nor the opaque part takes,
            // tinted by the base color when entering (or crossing a thin pane).
            crossedGlass = true;
            mat3 worldToObject = mat3(rayQueryGetIntersectionWorldToObjectEXT(rayQuery, false));
            vec3 p0 = vertices[corner.x].position;
            vec3 outward = cross(vertices[corner.y].position - p0, vertices[corner.z].position - p0) * worldToObject;
            if (mesh.hasNormals != 0) {
                vec3 smoothNormal = vertices[corner.x].normal * weights.x + vertices[corner.y].normal * weights.y
                                    + vertices[corner.z].normal * weights.z;
                if (dot(outward, smoothNormal * worldToObject) < 0.0) {
                    outward = -outward;  // as in traceClosest: the vertex normals define the outside
                }
            }
            float cosTheta = dot(normalize(outward), direction);
            bool entering = cosTheta < 0.0;
            vec3 color = material.baseColor.rgb;
            if (material.baseColorTexture >= 0) {
                color *= sampleTextureFull(material.baseColorTexture, material.baseColorUvTransform, uv).rgb;
            }
            float fresnel = fresnelSchlick(dielectricF0(material.ior), abs(cosTheta));
            tint *= (1.0 - metallic) * transmission * (1.0 - fresnel);
            if (entering || material.solid == 0) {
                tint *= color;
            }
            if (material.solid != 0) {
                crossedSolidGlass = true;
                float distance = rayQueryGetIntersectionTEXT(rayQuery, false) * length(worldToObject * direction) * mesh.unitScale;
                opticalDepth += material.absorption * (entering ? -distance : distance);
            }
            if (all(lessThan(tint, vec3(1e-4)))) {
                rayQueryConfirmIntersectionEXT(rayQuery);  // practically black: no need to look further
                break;
            }
        }
        if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            return vec3(0.0);
        }
        tint *= exp(-max(opticalDepth, vec3(0.0)));
        // The fog it is in at the end goes on to there (inside < 0: it left fog it didn't know it was in)
        fogInside = max(fogInside, 0.0);
        tint *= exp(-max(fogDepth + fogInside * (portal >= 0 ? portalT : maxDistance), 0.0));
        if (FOG >= 2 && any(greaterThan(tint, vec3(0.0)))) {
            // (after a portal: from the media it started in, as if the partner's side were the same place)
            tint *= varyingTransmittance(origin, direction, portal >= 0 ? portalT : maxDistance, media, crossed, seed);
        }
        if (portal < 0) {
            break;
        }
        // On from the partner, for the rest of the way
        mat4x3 toPartner = portals[portal].toPartner;
        origin = toPartner * vec4(origin + direction * portalT, 1.0);
        direction = normalize(mat3(toPartner) * direction);
        maxDistance -= portalT;
        skip = portal ^ 1;
        tMin = PORTAL_GAP;
    }
    return tint;
}

// ---------------------------------------------------------------------------------------------
// Light sampling for glowing surfaces, and multiple importance sampling (MIS)
//
// There are two ways to find the light a glowing triangle sends to a surface point:
//  a) bounce sampling: the bounce ray happens to hit it. Good for big lights, bad for small ones (rarely hit).
//  b) light sampling: pick a random point on a random glowing triangle and send a shadow ray there.
//     Good for small lights, bad for big ones close by (points near the edge get picked at grazing angles).
// Both are correct on their own. MIS uses both and weights each sample by how likely its own method was to
// produce it compared to the other one, so each method mostly contributes where it is strong, and the
// light is still counted exactly once in total.
//
// A "pdf" (probability density) below is: how likely is a method to pick this exact direction. Comparing them
// needs the same unit for both, so both are expressed per solid angle (per unit of direction).

// Power heuristic: the usual MIS weight. Gives the sample almost entirely to the method that was much more
// likely to produce it.
float misWeight(float pdfThis, float pdfOther) {
    float a = pdfThis * pdfThis;
    float b = pdfOther * pdfOther;
    return a + b > 0.0 ? a / (a + b) : 0.0;
}

// Where on a picked glowing triangle the shadow ray goes. Evenly by area is simple, but a large triangle close to
// the point looks very different from there: its near part fills most of the point's view of it, its far part is a
// sliver, and yet the far part gets most of the samples (more area). Picking directions evenly over the triangle's
// solid angle (the patch of the point's sky it covers) instead puts the samples where the light comes from (Arvo
// 1995, "Stratified Sampling of Spherical Triangles"; as in pbrt-v4). Its pdf is 1 / solid angle, the same in every
// direction. (It ignores the cosine at the surface, which Peters 2021 also accounts for, at more cost.)
// Tiny triangles (most of them, seen from afar) are sampled by area: the same result there, and the spherical
// formulas lose precision; so are huge ones (nearly around the point). The limits are pbrt-v4's.
const float SPHERICAL_MIN = 3e-4;  // steradians
const float SPHERICAL_MAX = 6.22;

// The solid angle of a triangle seen from p, if it is to be sampled by solid angle; 0: by area
float sphericalSolidAngle(EmissiveTriangle light, vec3 p) {
    if (scene.emissiveSolidAngle == 0) {
        return 0.0;
    }
    vec3 a = light.p0 - p, b = light.p1 - p, c = light.p2 - p;
    float la = length(a), lb = length(b), lc = length(c);
    if (min(la, min(lb, lc)) <= 0.0) {
        return 0.0;
    }
    a /= la;
    b /= lb;
    c /= lc;
    // Van Oosterom & Strackee 1983
    float solidAngle = abs(2.0 * atan(dot(a, cross(b, c)), 1.0 + dot(a, b) + dot(a, c) + dot(b, c)));
    return solidAngle > SPHERICAL_MIN && solidAngle < SPHERICAL_MAX ? solidAngle : 0.0;
}

// The angle between unit vectors, precise near 0 and PI too (unlike acos of the dot product)
float angleBetween(vec3 x, vec3 y) {
    return dot(x, y) < 0.0 ? PI - 2.0 * asin(min(length(x + y) * 0.5, 1.0)) : 2.0 * asin(min(length(y - x) * 0.5, 1.0));
}

// A point on the triangle (v0, v1, v2) whose direction from p is spread evenly over the triangle's solid angle
// (Arvo 1995, written as in pbrt-v4's SampleSphericalTriangle), as barycentric weights. u.x picks how much of the
// solid angle lies on one side of the direction (a sub-triangle of that area, sharing the corner at v0), u.y
// where along the sub-triangle's far edge. false: too thin to tell.
bool sampleSphericalTriangle(vec3 v0, vec3 v1, vec3 v2, vec3 p, vec2 u, out vec3 weights) {
    weights = vec3(1.0 / 3.0);
    vec3 a = normalize(v0 - p), b = normalize(v1 - p), c = normalize(v2 - p);
    // the planes through p and each edge, and the triangle's angles between them
    vec3 nab = cross(a, b), nbc = cross(b, c), nca = cross(c, a);
    if (dot(nab, nab) == 0.0 || dot(nbc, nbc) == 0.0 || dot(nca, nca) == 0.0) {
        return false;
    }
    nab = normalize(nab);
    nbc = normalize(nbc);
    nca = normalize(nca);
    float alpha = angleBetween(nab, -nca);
    float beta = angleBetween(nbc, -nab);
    float gamma = angleBetween(nca, -nbc);
    // the sub-triangle's area (+ PI), and its corner c' on the edge from a to c
    float subArea = mix(PI, alpha + beta + gamma, u.x);
    float cosAlpha = cos(alpha), sinAlpha = sin(alpha);
    float sinPhi = sin(subArea) * cosAlpha - cos(subArea) * sinAlpha;
    float cosPhi = cos(subArea) * cosAlpha + sin(subArea) * sinAlpha;
    float k1 = cosPhi + cosAlpha;
    float k2 = sinPhi - sinAlpha * dot(a, b);
    float cosB = clamp((k2 + (k2 * cosPhi - k1 * sinPhi) * cosAlpha) / ((k2 * sinPhi + k1 * cosPhi) * sinAlpha), -1.0, 1.0);
    vec3 cPrime = cosB * a + sqrt(max(1.0 - cosB * cosB, 0.0)) * normalize(c - dot(c, a) * a);
    // a direction between b and c', evenly over the arc's share of the solid angle
    float cosTheta = 1.0 - u.y * (1.0 - dot(cPrime, b));
    vec3 w = cosTheta * b + sqrt(max(1.0 - cosTheta * cosTheta, 0.0)) * normalize(cPrime - dot(cPrime, b) * b);
    // where that direction meets the triangle (Moller-Trumbore)
    vec3 e1 = v1 - v0, e2 = v2 - v0;
    vec3 s1 = cross(w, e2);
    float divisor = dot(s1, e1);
    if (divisor == 0.0) {
        return false;
    }
    vec3 s = p - v0;
    vec2 bary = clamp(vec2(dot(s, s1), dot(w, cross(s, e1))) / divisor, 0.0, 1.0);
    bary /= max(bary.x + bary.y, 1.0);
    if (any(isnan(bary))) {
        return false;
    }
    weights = vec3(1.0 - bary.x - bary.y, bary);
    return true;
}

// A point on glowing triangle `light` for the surface point p: by solid angle or by area (see above). u: two
// random numbers. false: none (a degenerate triangle).
bool pointOnTriangle(EmissiveTriangle light, vec3 p, vec2 u, out vec3 weights) {
    if (sphericalSolidAngle(light, p) > 0.0) {
        return sampleSphericalTriangle(light.p0, light.p1, light.p2, p, u, weights);
    }
    float r1 = sqrt(u.x);  // evenly over the area (the square root keeps points from bunching up in one corner)
    weights = vec3(1.0 - r1, r1 * (1.0 - u.y), r1 * u.y);
    return true;
}

// pdf (per solid angle) of light sampling choosing the point `distance` away from p on triangle `light`, seen at
// `cosLight` (angle between the triangle's normal and the direction towards p). By solid angle it is
// 1 / solid angle. By area it is 1 / area per area; a small patch far away or seen edge-on covers a small solid
// angle, hence distance^2 / cos to convert.
// pickProbability: the chance that this triangle was picked (lightPickProbability).
float lightPdf(int lightIndex, float pickProbability, vec3 p, float distance, float cosLight) {
    EmissiveTriangle light = emissiveTriangles[lightIndex];
    float solidAngle = sphericalSolidAngle(light, p);
    if (solidAngle > 0.0) {
        return pickProbability / solidAngle;
    }
    return pickProbability / max(light.area, 1e-12) * distance * distance / max(cosLight, 1e-6);
}

// ---------------------------------------------------------------------------------------------
// The light tree. Picking by power alone sends most shadow rays of a point under a street lamp to lamps a block
// away. The tree groups nearby triangles; walking down from the root, each step goes into one of the two children
// with a chance proportional to a rough guess of how much light it could send to the point (lightTreeImportance).
// The chance of picking a triangle is the product of the chances along its way down. The guess only steers where
// the samples go: every triangle that could light the point keeps a chance above 0, so the result stays correct.
//
// p, n: the shading point and its (shading) normal. twoSided: light from behind counts too (diffuse transmission).
// These must be the same when sampling and when computing the pdf of a triangle a bounce ray hit (for MIS).

// Power / distance^2, times the largest cosine any point of the node's bounding sphere could have with the normal.
// The distance: the distance to the box's center underrates a long box (a string of lamps along the street) for a
// point near one of its ends, where the light from the nearest lamp is strong: those rare samples come out very
// bright (fireflies). Instead, distance^2 = (to the box's nearest point) * (to its farthest corner). Inside the box (or very
// close) the nearest distance is clamped to a twentieth of its radius, the light can't grow without limit there.
float lightTreeImportance(LightTreeNode node, vec3 p, vec3 n, bool twoSided) {
    vec3 center = 0.5 * (node.boundsMin + node.boundsMax);
    float radius2 = 0.25 * dot(node.boundsMax - node.boundsMin, node.boundsMax - node.boundsMin);
    vec3 toCenter = center - p;
    float distance2 = dot(toCenter, toCenter);
    vec3 nearest = clamp(p, node.boundsMin, node.boundsMax);
    vec3 farthest = mix(node.boundsMax, node.boundsMin, step(center, p));  // per axis, the side away from p
    float nearestDistance = max(length(nearest - p), 0.05 * sqrt(radius2) + 1e-4);
    float importance = node.power / (nearestDistance * length(farthest - p));
    if (twoSided || distance2 <= radius2) {
        return importance;  // every direction may bring light / the sphere surrounds the point
    }
    // The sphere is seen within an angle thetaU of its center's direction (at thetaI from the normal); the
    // closest direction to the normal is at max(0, thetaI - thetaU). Nothing below the horizon reaches the point.
    float cosI = dot(n, toCenter) * inversesqrt(distance2);
    float sinU2 = radius2 / distance2;
    float cosU = sqrt(1.0 - sinU2);
    if (cosI >= cosU) {
        return importance;  // the normal points into the sphere
    }
    float sinI = sqrt(max(1.0 - cosI * cosI, 0.0));
    float cosBound = cosI * cosU + sinI * sqrt(sinU2);  // cos(thetaI - thetaU)
    return importance * max(cosBound, 0.0);
}

// Chance of going into the left child of `node` (a node with children), -1 if neither child can light the point
float lightTreeLeftChance(LightTreeNode node, vec3 p, vec3 n, bool twoSided) {
    float left = lightTreeImportance(lightTreeNodes[node.child], p, n, twoSided);
    float right = lightTreeImportance(lightTreeNodes[node.child + 1], p, n, twoSided);
    return left + right > 0.0 ? left / (left + right) : -1.0;
}

// Walks down the tree with one random number (rescaled at every step to stay evenly distributed).
// Returns the triangle, or -1 when nothing can light the point.
int pickFromLightTree(vec3 p, vec3 n, bool twoSided, float u, out float probability) {
    probability = 1.0;
    LightTreeNode node = lightTreeNodes[0];
    while (node.child >= 0) {
        float leftChance = lightTreeLeftChance(node, p, n, twoSided);
        if (leftChance < 0.0) {
            return -1;
        }
        if (u < leftChance) {
            u /= leftChance;
            probability *= leftChance;
            node = lightTreeNodes[node.child];
        } else {
            u = (u - leftChance) / (1.0 - leftChance);
            probability *= 1.0 - leftChance;
            node = lightTreeNodes[node.child + 1];
        }
        u = min(u, 0.99999994);  // rounding could reach 1
    }
    return -node.child - 1;
}

// The chance that light sampling at p picks this triangle: its share of the light, or the way down the tree
float lightPickProbability(int lightIndex, vec3 p, vec3 n, bool twoSided) {
    EmissiveTriangle light = emissiveTriangles[lightIndex];
    if (scene.lightTree == 0 || light.probability <= 0.0) {
        return light.probability;  // probability 0: not in the tree, never picked
    }
    float probability = 1.0;
    LightTreeNode node = lightTreeNodes[0];
    for (uint depth = 0; node.child >= 0; depth++) {
        float leftChance = lightTreeLeftChance(node, p, n, twoSided);
        if (leftChance < 0.0) {
            return 0.0;
        }
        bool right = (light.treeTrail & (1u << depth)) != 0u;
        probability *= right ? 1.0 - leftChance : leftChance;
        node = lightTreeNodes[node.child + (right ? 1 : 0)];
    }
    return -node.child - 1 == lightIndex ? probability : 0.0;
}

// Light sampling for the sky (see Environment.cpp): the sphere of directions in cells, rows from straight up to
// straight down, each row cut into columns. A cell is picked with a chance proportional to its brightness times
// its solid angle, then a direction evenly inside it.

// The first entry of environmentCdf[first .. first + count) that reaches u
uint searchEnvironmentCdf(uint first, uint count, float u) {
    uint low = 0, high = count - 1;
    while (low < high) {
        uint middle = (low + high) / 2;
        if (environmentCdf[first + middle] < u) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

// pdf (per solid angle) of a direction in this cell
float environmentCellPdf(uint row, uint column) {
    uint width = scene.environmentWidth, height = scene.environmentHeight;
    uint rowStart = height + row * width;
    float rowChance = environmentCdf[row] - (row > 0 ? environmentCdf[row - 1] : 0.0);
    float columnChance = environmentCdf[rowStart + column] - (column > 0 ? environmentCdf[rowStart + column - 1] : 0.0);
    float cos0 = cos(PI * float(row) / float(height));
    float cos1 = cos(PI * float(row + 1) / float(height));
    float solidAngle = 2.0 * PI / float(width) * (cos0 - cos1);
    return rowChance * columnChance / max(solidAngle, 1e-12);
}

// How likely sampleEnvironment is to pick this direction (for MIS)
float environmentPdf(vec3 direction) {
    vec2 uv = environmentUv(direction);
    uint row = min(uint(uv.y * float(scene.environmentHeight)), scene.environmentHeight - 1);
    uint column = min(uint(uv.x * float(scene.environmentWidth)), scene.environmentWidth - 1);
    return environmentCellPdf(row, column);
}

vec3 sampleEnvironment(vec4 random, out float pdf) {
    uint height = scene.environmentHeight, width = scene.environmentWidth;
    uint row = searchEnvironmentCdf(0, height, random.x);
    uint column = searchEnvironmentCdf(height + row * width, width, random.y);
    // Evenly over the cell's solid angle: evenly in cos(angle from straight up) and around
    float cos0 = cos(PI * float(row) / float(height));
    float cos1 = cos(PI * float(row + 1) / float(height));
    float cosTheta = mix(cos0, cos1, random.z);
    float u = (float(column) + random.w) / float(width);
    pdf = environmentCellPdf(row, column);  // 0 for a black cell hit by a random number exactly on its boundary
    return environmentDirection(u, cosTheta);
}

// Light given off at a point of a glowing triangle. A hole in a cut-out doesn't glow, and a see-through
// surface glows in proportion to how often rays stop on it (a bounce ray that hits it sees it with chance alpha).
vec3 emissionAt(uint materialIndex, vec2 uv) {
    Material material = materials[materialIndex];
    vec3 emission = material.emissive;
    if (material.emissiveTexture >= 0) {
        emission *= sampleTextureFull(material.emissiveTexture, material.emissiveUvTransform, uv).rgb;
    }
    return emission * opacityAt(materialIndex, uv);
}

// ---------------------------------------------------------------------------------------------
// Light sampling ("next event estimation"): at every surface, one shadow ray towards each kind of light (the sun,
// the sky, the glowing triangles, the punctual lights). Each kind only picks its sample here: a direction, how far
// the shadow ray goes, and how much light arrives from there divided by the chance of picking it. The rest is the
// same for all of them and done once, in tracePath's light loop (the surface's response, the shadow ray, MIS).
// Keeping that part in one place keeps the shader small: GLSL inlines every call, and four copies of the shadow
// ray and the BRDF made it so large that it ran much slower, even where those lights were switched off.

const uint MIS_NONE = 0;          // nothing else finds this light (punctual lights, the sun without size)
const uint MIS_UNLESS_GLASS = 1;  // bounce rays find it too, except through glass or when the path ends in the cache
const uint MIS_UNLESS_SOLID = 2;  // bounce rays find it too, also through thin panes, except through solid glass (sky)

struct LightSample {
    vec3 direction;   // world space, from the surface towards the light
    float distance;   // how far the shadow ray goes
    vec3 light;       // light arriving at a surface facing it, divided by the pdf of picking this sample; 0 = none
    float pdf;        // per solid angle, for MIS
    uint mis;         // MIS_*
    bool shadowed;    // false: no shadow ray (the sun with "Shadows" off)
};

// Where a shadow ray towards light sample s starts: just off the surface (offsetRay), on the side the light is
// (behind: the far side, light passing through a thin surface). s.distance is measured from the hit itself, so the
// ray gets shorter by how much closer to the light it starts.
vec3 shadowRayStart(Hit hit, bool behind, inout LightSample s) {
    vec3 origin = offsetRay(hit.position, behind ? -hit.geometricNormal : hit.geometricNormal);
    s.distance -= dot(origin - hit.position, s.direction);
    return origin;
}

LightSample noLightSample() {
    LightSample s;
    s.direction = vec3(0.0, 1.0, 0.0);
    s.distance = 0.0;
    s.light = vec3(0.0);
    s.pdf = 0.0;
    s.mis = MIS_NONE;
    s.shadowed = false;
    return s;
}

// Picks a glowing triangle for the point p (normal n), with the light tree (by what it could send to this
// point), or by its share of all light: binary search for the first one whose running sum exceeds a random
// number. Triangles with a bigger share cover a bigger stretch of [0, 1], so get picked more.
// -1: none (all glowing triangles are behind the surface, or a triangle with probability 0, see below).
int pickEmissiveTriangle(vec3 p, vec3 n, bool twoSided, float pick, out float pickProbability) {
    int lightIndex;
    if (scene.lightTree != 0) {
        lightIndex = pickFromLightTree(p, n, twoSided, pick, pickProbability);
        if (lightIndex < 0) {
            return -1;
        }
    } else {
        uint low = 0, high = scene.emissiveTriangleCount - 1;
        while (low < high) {
            uint middle = (low + high) / 2;
            if (emissiveTriangles[middle].cdf < pick) {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        lightIndex = int(low);
        pickProbability = emissiveTriangles[low].probability;
    }
    // Triangles with probability 0 (a black part of an emissive texture) have no stretch of [0, 1] of their own,
    // but the search can still land on one when the random number is exactly a boundary (e.g. 0). Dividing by
    // its pdf of 0 would give infinity, which would stick in the pixel's running average forever.
    return pickProbability > 0.0 ? lightIndex : -1;
}

// One randomly picked point on the glowing triangles, seen from surfacePoint. random: x picks the
// triangle, y and z the point.
LightSample sampleEmissiveLight(Hit hit, vec3 shadingNormal, vec3 surfacePoint, vec3 random) {
    LightSample s = noLightSample();
    // 1: pick a triangle
    float pickProbability;
    int lightIndex = pickEmissiveTriangle(hit.position, shadingNormal, hit.diffuseTransmission > 0.0, random.x,
                                          pickProbability);
    if (lightIndex < 0) {
        return s;
    }
    EmissiveTriangle light = emissiveTriangles[lightIndex];

    // 2: a point on it
    vec3 weights;
    if (!pointOnTriangle(light, surfacePoint, random.yz, weights)) {
        return s;
    }
    vec3 lightPoint = light.p0 * weights.x + light.p1 * weights.y + light.p2 * weights.z;
    vec2 lightUv = light.uv0 * weights.x + light.uv1 * weights.y + light.uv2 * weights.z;

    vec3 toLight = lightPoint - surfacePoint;
    float distance = length(toLight);
    s.direction = toLight / distance;
    vec3 lightNormal = normalize(cross(light.p1 - light.p0, light.p2 - light.p0));
    float cosLight = abs(dot(lightNormal, s.direction));  // glowing triangles shine from both sides, like everything we hit
    if (cosLight <= 1e-6) {
        return s;  // seen exactly edge-on
    }
    s.distance = distance - stopShortOf(lightPoint, lightNormal, cosLight);  // the light itself would count as a blocker
    s.pdf = lightPdf(lightIndex, pickProbability, surfacePoint, distance, cosLight);
    s.light = emissionAt(light.materialIndex, lightUv) / s.pdf;
    s.mis = scene.emissiveSampling == EMISSIVE_MIS ? MIS_UNLESS_GLASS : MIS_NONE;
    s.shadowed = true;
    return s;
}

// ---------------------------------------------------------------------------------------------
// Punctual lights
//
// A point light of intensity I (candela) lights a surface facing it from distance d with I / d^2 (lux): the light
// spreads over a sphere. A spot does the same inside its cone, fading out between the inner and the outer cone; a
// directional light gives its intensity (lux) everywhere, like the sun. They have no size: bounce rays never hit
// them (no MIS needed), and their shadows are sharp.

LightSample punctualLightSample(PunctualLight light, vec3 position) {
    LightSample s = noLightSample();
    s.shadowed = true;
    if (light.type == LIGHT_DIRECTIONAL) {
        s.direction = -light.direction;
        s.distance = SKY_DISTANCE;
        s.light = light.intensity;
        return s;
    }
    vec3 toLight = light.position - position;
    float distanceSquared = dot(toLight, toLight);
    float distance = sqrt(distanceSquared);
    if (distance < 1e-4) {
        return noLightSample();
    }
    s.direction = toLight / distance;
    s.distance = distance * 0.999;
    s.light = light.intensity / distanceSquared;
    if (light.range > 0.0) {
        // glTF's recommended fade-out: smooth, and exactly 0 at the range
        float ratio = distance / light.range;
        float window = clamp(1.0 - ratio * ratio * ratio * ratio, 0.0, 1.0);
        s.light *= window * window;
    }
    if (light.type == LIGHT_SPOT) {
        float cosAxis = dot(-s.direction, light.direction);
        float t = clamp((cosAxis - light.cosOuterCone) / (light.cosInnerCone - light.cosOuterCone), 0.0, 1.0);
        s.light *= t * t;
    }
    return s;
}

// Up to MAX_PUNCTUAL_LIGHTS_PER_HIT lights: a shadow ray to each (exact). More: one picked at random, counted
// punctualLightCount times (correct on average, noisy with many lights).
const uint MAX_PUNCTUAL_LIGHTS_PER_HIT = 8;
uint punctualLightSamples() {
    uint count = punctualLightCount();
    return count <= MAX_PUNCTUAL_LIGHTS_PER_HIT ? count : 1;
}
LightSample samplePunctualLight(uint index, vec3 position, inout uint seed) {
    uint count = punctualLightCount();
    if (count <= MAX_PUNCTUAL_LIGHTS_PER_HIT) {
        return punctualLightSample(punctualLights[index], position);
    }
    uint picked = min(uint(randomFloat(seed) * float(count)), count - 1);
    LightSample s = punctualLightSample(punctualLights[picked], position);
    s.light *= float(count);
    return s;
}

// The light fog scatters into a ray from the punctual lights along its stretches inside fog (Intersection.lampSpan):
// one stretch, picked by its majorant times its length, one light picked at random, at one point picked by equi-angular sampling
// (Kulla & Fajardo 2012, "Importance Sampling Techniques for Path Tracing in Participating Media"): evenly by the
// angle under which the lamp sees the ray, i.e. as densely as its 1 / distance^2. A directional light: evenly along
// the stretch.
// No loss on the way from origin to that point: the stretch ends where the path scatters, if it does, and a point
// gets onto it exactly as often as light from it would get through (see "Fog"); averaged, that is the loss.
// Portals: only the ray's last part (origin, direction), the one it scattered or hit something in.
vec3 fogLampLight(vec3 origin, vec3 direction, Intersection stretch, uint bounce, inout uint seed) {
    vec2 span = stretch.lampSpan;
    vec4 u = pathSample(bounce, SAMPLE_FOG, seed);  // x: where the ray scatters (intersectClosest)
    uint count = punctualLightCount();
    PunctualLight light = punctualLights[min(uint(u.y * float(count)), count - 1)];
    float t, pdf;
    if (light.type == LIGHT_DIRECTIONAL) {
        t = mix(span.x, span.y, u.z);
        pdf = 1.0 / (span.y - span.x);
    } else {
        float along = dot(light.position - origin, direction);  // the ray's point nearest the lamp
        float height = max(length(light.position - origin - direction * along), 1e-4);  // and its distance
        float angleA = atan((span.x - along) / height);
        float angleB = atan((span.y - along) / height);
        float offset = height * tan(mix(angleA, angleB, u.z));
        t = along + offset;
        pdf = height / ((angleB - angleA) * (height * height + offset * offset));
    }
    vec3 point = origin + direction * t;
    LightSample s = punctualLightSample(light, point);
    if (all(equal(s.light, vec3(0.0))) || !(pdf > 0.0)) {
        return vec3(0.0);
    }
    // What the fog there scatters towards the ray, per unit of length: each volume's density, color and phase
    vec3 scattering = vec3(0.0);
    float cosTheta = dot(direction, s.direction);
    for (uvec2 rest = stretch.lampMedia; firstMedium(rest) != NO_MEDIUM; rest = otherMedia(rest)) {
        uint material = mediumMaterial(firstMedium(rest));
        scattering += fogDensityAt(firstMedium(rest), point) * materials[material].fogColor
                      * fogPhase(cosTheta, materials[material].fogForward);
    }
    if (all(equal(scattering, vec3(0.0)))) {
        return vec3(0.0);  // a clear spot of varying fog
    }
    // The stretch's chance was its majorant * length / lampWeight
    float scale = float(count) * stretch.lampWeight / (stretch.lampMajorant * (span.y - span.x) * pdf);
    bool crossedGlass, crossedSolidGlass;
    return s.light * scale * scattering
           * shadowTransmittance(point, s.direction, s.distance, -1, seed, stretch.lampMedia, crossedGlass,
                                 crossedSolidGlass);
}

// A light seen through portal end `end`: where it appears from this side, moved back through the portal. A shadow
// ray towards it goes through the end's opening and on from the partner to the light itself (shadowTransmittance
// with throughEnd), the same distance in all, so falloff and spot cones come out right. which: 0 = the sun, k =
// the punctual light of slot k - 1 (as samplePunctualLight). Most points don't see a light's image through a given
// opening: no light then (s.light = 0), for the cost of one plane test.
LightSample portalLightImage(uint end, uint which, vec3 position, inout uint seed) {
    mat4x3 toPartner = portals[end].toPartner;
    mat3 back = transpose(mat3(toPartner));  // the partner's side -> this side (a rotation: transposed = inverse)
    LightSample s = noLightSample();
    if (which == 0) {
        // Without "Shadows" the sun isn't blocked by the opening either: it already lights everything directly
        if (scene.sunOn == 0 || scene.shadowsEnabled == 0) {
            return s;
        }
        vec2 u = vec2(randomFloat(seed), randomFloat(seed));
        s.direction = back * randomDirectionInCone(scene.sunDirection.xyz, scene.sunDirection.w, u);
        s.distance = SKY_DISTANCE;
        s.light = PI * scene.sunColor.rgb;
        s.pdf = scene.sunPdf;
        s.mis = scene.sunMis != 0 ? MIS_UNLESS_GLASS : MIS_NONE;
        s.shadowed = true;
    } else {
        uint count = punctualLightCount();
        uint index = which - 1;
        float scale = 1.0;
        if (count > MAX_PUNCTUAL_LIGHTS_PER_HIT) {
            index = min(uint(randomFloat(seed) * float(count)), count - 1);
            scale = float(count);
        }
        PunctualLight light = punctualLights[index];
        light.position = back * (light.position - toPartner[3]);
        light.direction = back * light.direction;
        s = punctualLightSample(light, position);
        s.light *= scale;
    }
    float t;
    if (!portalOpeningHit(end, position, s.direction, s.distance, t)) {
        s.light = vec3(0.0);
    }
    return s;
}

// ---------------------------------------------------------------------------------------------
// ReSTIR DI (see RESTIR_DI_PLAN.md)
//
// Direct light at the first surface the camera sees, if it is rough enough (restirSurface). Instead of a shadow
// ray per kind of light, the RESTIR_PASS draws several candidate light samples per pixel (glowing triangles,
// punctual lights, the sky) and keeps one of them, picked with a chance proportional to how much light it would
// bring if nothing blocked it (its "target", restirTarget): resampled importance sampling (RIS, Talbot et al.
// 2005). The kept sample and its weight W go into the pixel's reservoir. The image pass traces one shadow ray to
// it and counts its light times W. W = (sum of the candidates' weights) / (the kept sample's target) keeps the
// result correct on average, whatever the target is; the closer the target is to the real light (shadows aside),
// the less noise. The sun is not in it: it keeps its own shadow ray (slot 0 of the light loop).
//
// The candidates come from two kinds of strategies: light sampling (each kind of light has its own candidates) and
// BRDF sampling (a direction picked by the surface's reflection, whatever light its ray finds). The light ones
// find small and distant lights; the BRDF ones the light a glossy surface reflects in a narrow cone, or a large
// light very close by. A candidate's weight is target / (sum over the strategies that could have produced it of
// their number of candidates * their pdf of it): generalized RIS with the balance heuristic (Lin et al. 2022).
// A light the BRDF rays can't find (punctual lights, or one whose triangles are left out of light sampling, which
// the bounce ray counts instead) only has its light-sampling term.
//
// A sample is stored as which light and where on it, so that another pixel or the next frame can use it too. Its
// light, target and W are per unit of the light's own measure: per area of a glowing triangle, per solid angle of
// the sky, per punctual light. These don't depend on the point being lit, so a sample moves between pixels without
// a change of variables (a Jacobian). The light loop's solid-angle quantities differ from them by cos / distance^2.
//
// Temporal reuse (restirTemporal): last frame's reservoir of the same surface point is merged in. With a still
// scene, a pixel's reservoir soon stands for the candidates of many frames (up to restirMaxHistory times this
// frame's), and the shadow ray in the RESTIR_PASS (visibility reuse) keeps blocked samples from being passed on.
//
// Spatial reuse (restirSpatial): each pixel also resamples a few nearby pixels' reservoirs, in a pass of its own.
//
// Buffers: reservoirs and surfaces have two halves, this frame's and last frame's, swapped every frame. Reservoirs
// have a third part with the spatial pass: the RESTIR_PASS's result (restirTemporalIndex), which the spatial pass
// reads, writing this frame's half.

const uint RESTIR_NOT_USED = 0xFFFFFFFFu;  // Reservoir.light: this pixel's first surface does its own light sampling
const uint LIGHT_KIND_NONE = 0;            // nothing could light the surface
const uint LIGHT_KIND_TRIANGLE = 1;        // a glowing triangle; point: barycentrics (2 x 16 bits)
const uint LIGHT_KIND_PUNCTUAL = 2;        // a punctual light
const uint LIGHT_KIND_SKY = 3;             // the sky; point: see encodeSkyPoint

// Must match GpuReservoir in Application.h
struct Reservoir {
    uint light;   // kind << 30 | index
    uint point;   // where on the light
    float W;      // the kept sample's weight: its light * W estimates the direct light (0: nothing)
    float M;      // how many candidates it stands for
};
layout(binding = 26, scalar) buffer Reservoirs { Reservoir reservoirs[]; };  // 3 parts of one per render pixel

// What the reuse needs to know about a pixel's first surface: enough for its target (restirTarget) without its
// textures. 48 bytes; the material in 8 bits per value. Must match GpuRestirSurface in Application.h.
struct RestirSurface {
    vec3 position;
    uint normal;             // octahedral, 2 x 16 bits
    uint geometricNormal;
    uint albedoRoughness;    // 4 x 8 bits
    uint material;           // metallic, (ior - 1) / 2, diffuse transmission (8 bits each)
    uint diffuseTransmissionColor;
    // Where the camera sees it (its position, or in mirrors its image: see "Mirrors and ReSTIR") and the way
    // towards the viewer (octahedral): for view directions and depths, and to find it on last frame's image
    vec3 seenAt;
    uint view;
};
layout(binding = 27, scalar) buffer RestirSurfaces { RestirSurface restirSurfaces[]; };  // 2 halves, as above

uint restirPixelCount() {
    uvec2 size = uvec2(imageSize(radianceImage));
    return size.x * size.y;
}

// Where a pixel's reservoir and surface are, in this frame's half (previousFrame: last frame's)
uint restirIndex(ivec2 pixel, bool previousFrame) {
    uint part = previousFrame ? 1u - scene.restirCurrentHalf : scene.restirCurrentHalf;
    return part * restirPixelCount() + uint(pixel.y) * uint(imageSize(radianceImage).x) + uint(pixel.x);
}

// Whether the spatial pass runs (restirSpatial)
bool restirSpatialOn() {
    return scene.restirSpatialNeighbors + scene.restirDisocclusionNeighbors > 0;
}

// Where the RESTIR_PASS leaves a pixel's reservoir for the spatial pass (reservoirs only)
uint restirTemporalIndex(ivec2 pixel) {
    return 2u * restirPixelCount() + uint(pixel.y) * uint(imageSize(radianceImage).x) + uint(pixel.x);
}

// Unit vectors in 32 bits: the octahedron folded flat (Cigolle et al. 2014)
uint encodeDirection(vec3 n) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return packSnorm2x16(e);
}

vec3 decodeDirection(uint packed) {
    vec2 e = unpackSnorm2x16(packed);
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    float t = max(-n.z, 0.0);
    n.xy += vec2(n.x >= 0.0 ? -t : t, n.y >= 0.0 ? -t : t);
    return normalize(n);
}

// seenAt: where the camera sees it, v: towards the viewer
RestirSurface packRestirSurface(Hit hit, vec3 seenAt, vec3 v) {
    RestirSurface surface;
    surface.position = hit.position;
    surface.seenAt = seenAt;
    surface.view = encodeDirection(v);
    surface.normal = encodeDirection(hit.normal);
    surface.geometricNormal = encodeDirection(hit.geometricNormal);
    surface.albedoRoughness = packUnorm4x8(vec4(hit.albedo, hit.roughness));
    surface.material = packUnorm4x8(vec4(hit.metallic, (hit.ior - 1.0) * 0.5, hit.diffuseTransmission, 0.0));
    surface.diffuseTransmissionColor = packUnorm4x8(vec4(hit.diffuseTransmissionColor, 0.0));
    return surface;
}

// A Hit with what restirTarget reads (the rest stays unset)
Hit unpackRestirSurface(RestirSurface surface) {
    Hit hit;
    hit.found = true;
    hit.position = surface.position;
    hit.normal = decodeDirection(surface.normal);
    hit.geometricNormal = decodeDirection(surface.geometricNormal);
    vec4 albedoRoughness = unpackUnorm4x8(surface.albedoRoughness);
    hit.albedo = albedoRoughness.rgb;
    hit.roughness = albedoRoughness.a;
    vec4 material = unpackUnorm4x8(surface.material);
    hit.metallic = material.x;
    hit.ior = 1.0 + 2.0 * material.y;
    hit.diffuseTransmission = FEATURE_DIFFUSE_TRANSMISSION ? material.z : 0.0;
    hit.diffuseTransmissionColor = unpackUnorm4x8(surface.diffuseTransmissionColor).rgb;
    hit.transmission = 0.0;  // ReSTIR surfaces have none
    return hit;
}

// The way from a stored surface towards whoever saw it (the camera, or in mirrors its mirror image)
vec3 restirSurfaceView(RestirSurface surface) {
    return decodeDirection(surface.view);
}

// A stored surface's view depth with this frame's camera: of where the camera sees it
float restirSurfaceDepth(RestirSurface surface) {
    return dot(surface.seenAt - scene.cameraPosition.xyz, scene.cameraForward.xyz);
}

// Where a stored surface (this frame's) was on last frame's image: its point moved back by its object's motion,
// or its image in mirrors, which stands still with the mirrors (moving mirrors aren't followed)
vec4 restirPreviousPoint(RestirSurface surface, uint instanceIndex) {
    return surface.seenAt != surface.position ? vec4(surface.seenAt, 1.0)
                                              : instances[instanceIndex].motion * vec4(surface.position, 1.0);
}

// Surfaces that use ReSTIR: rough enough that a picked light sample finds the light they reflect. A near-mirror
// reflects a light in a tiny cone that a bounce ray finds far better; those keep the usual light sampling + MIS.
bool restirSurface(Hit hit) {
    return hit.roughness >= scene.restirMinRoughness && hit.transmission <= 0.0 && !isFog(hit);
}

// ---------------------------------------------------------------------------------------------
// ReSTIR GI (RESTIR_GI_PLAN.md)
//
// The light that reaches a ReSTIR surface x1 (the first one, restirSurface) via another surface x2. The image path
// bounces off x1 as usual and finds x2; at a surface that can be reused (restirGiSampleSurface) everything the path
// collects from x2 on (x2's direct light, the radiance cache, deeper bounces) is the light leaving x2 towards x1,
// Lo. That sample (x2, its normal, Lo) goes into the pixel's GI reservoir with W = 1 / pdf of the bounce direction,
// instead of into the image. x2's own glow and what the bounce ray finds without hitting a surface (the sky, the
// sun) stay x1's: they depend on x1 (MIS with its light sampling), and ReSTIR DI or the light sampling count them.
// After the image pass, the samples are reused like ReSTIR DI's (restirGiTemporal), and a last pass (restirGiShade)
// adds BRDF(x1) * cos * Lo * W of each pixel's kept sample.
//
// A sample moved to another first surface keeps its x2 and Lo ("reconnection", Ouyang et al. 2021): only the
// direction and distance from x1 change. Its W is per solid angle at the first surface it came from, so it is
// scaled by the Jacobian, how much larger x2 looks from the new surface: J = G(new) / G(old) with
// G = cos at x2 / distance^2 (restirGiGeometry). Next to x2, J grows without bound: a sample found from far away,
// reused right next to its surface, would get a huge weight. As RTXDI, a reuse with J outside 1/10..10 is skipped,
// and J is clamped to 1/3..3 (a bias: some light lost near corners, for fewer fireflies).

// Must match GpuGiReservoir in Application.h
struct GiReservoir {
    vec3 position;   // x2
    uint normal;     // x2's geometric normal, towards x1 (octahedral)
    vec3 radiance;   // Lo: the light leaving x2 towards x1
    float W;         // the sample's weight: BRDF(x1) * cos * Lo * W estimates the light (0: no sample)
    float M;         // how many samples it stands for (0: not a GI pixel)
    uint age;        // frames since the sample was found (bits 0-15); GI_SEEN: found by this pixel's own path
};
const uint GI_SEEN = 0x10000u;  // x1 is known to see x2: shading needs no visibility ray
// 3 parts of one per render pixel: this frame's and last frame's (as restirIndex), and the image pass's fresh samples
layout(binding = 29, scalar) buffer GiReservoirs { GiReservoir giReservoirs[]; };

// Where the image pass leaves a pixel's fresh GI sample
uint restirGiFreshIndex(ivec2 pixel) {
    return 2u * restirPixelCount() + uint(pixel.y) * uint(imageSize(radianceImage).x) + uint(pixel.x);
}

// Second surfaces whose light can be reused from another first surface: not glass (its light depends on where it
// is seen from through it), and not too smooth (likewise; restirGiMinRoughness, 0 = any).
bool restirGiSampleSurface(Hit hit) {
    return hit.transmission <= 0.0 && !hit.solid && hit.roughness >= scene.restirGiMinRoughness && !isFog(hit);
}

// A sky direction in 32 bits: the cell of the sky's sampling (see environmentCellPdf) and 32 x 32 places within
// it. The cell is kept exactly: rounded across a cell's edge, a direction would be weighted with the wrong cell's
// pdf, a bias where the sky's brightness jumps (a sun in the map). Evenly spread directions within a cell stay
// evenly spread over its places, so the cell's pdf stays right for them.
uint encodeSkyPoint(vec3 direction) {
    uint height = scene.environmentHeight, width = scene.environmentWidth;
    vec2 uv = environmentUv(direction);
    uint row = min(uint(uv.y * float(height)), height - 1);
    uint column = min(uint(uv.x * float(width)), width - 1);
    // within the cell: around evenly, and evenly in cos (as sampleEnvironment picks)
    float cos0 = cos(PI * float(row) / float(height));
    float cos1 = cos(PI * float(row + 1) / float(height));
    vec2 within = clamp(vec2(uv.x * float(width) - float(column), (direction.y - cos0) / (cos1 - cos0)), 0.0, 1.0);
    uvec2 place = min(uvec2(within * 32.0), uvec2(31));
    return ((row * width + column) << 10) | (place.x << 5) | place.y;
}

vec3 decodeSkyPoint(uint point) {
    uint height = scene.environmentHeight, width = scene.environmentWidth;
    uint cell = point >> 10;
    uint row = cell / width, column = cell % width;
    vec2 within = (vec2((point >> 5) & 31u, point & 31u) + 0.5) / 32.0;
    float cos0 = cos(PI * float(row) / float(height));
    float cos1 = cos(PI * float(row + 1) / float(height));
    return environmentDirection((float(column) + within.x) / float(width), mix(cos0, cos1, within.y));
}

// The sample a stored light and point stand for, seen from surfacePoint. s.light: the light arriving at
// a surface facing it per unit of the light's measure (see above; not divided by any pdf). s.pdf: per unit of that
// measure, the chance of picking this point once the light is picked (triangles: by solid angle cos / (distance^2 *
// solid angle), or by area 1 / area, see pointOnTriangle;
// the sky: its sampling; punctual lights: 1). toSolidAngle: solid angle per unit of the measure (triangles:
// cos / distance^2, else 1), to turn a pdf per solid angle (BRDF sampling) into one per unit of the measure.
LightSample restirLightSample(uint light, uint point, vec3 surfacePoint, out float toSolidAngle) {
    toSolidAngle = 1.0;
    uint kind = light >> 30;
    uint index = light & 0x3FFFFFFFu;
    LightSample s = noLightSample();
    if (kind == LIGHT_KIND_TRIANGLE) {
        EmissiveTriangle triangle = emissiveTriangles[index];
        vec2 bary = unpackUnorm2x16(point);
        vec3 weights = vec3(max(1.0 - bary.x - bary.y, 0.0), bary);
        vec3 lightPoint = triangle.p0 * weights.x + triangle.p1 * weights.y + triangle.p2 * weights.z;
        vec2 lightUv = triangle.uv0 * weights.x + triangle.uv1 * weights.y + triangle.uv2 * weights.z;
        vec3 toLight = lightPoint - surfacePoint;
        float distance = length(toLight);
        s.direction = toLight / distance;
        vec3 lightNormal = normalize(cross(triangle.p1 - triangle.p0, triangle.p2 - triangle.p0));
        float cosLight = abs(dot(lightNormal, s.direction));
        if (cosLight <= 1e-6) {
            return noLightSample();  // seen exactly edge-on
        }
        s.distance = distance - stopShortOf(lightPoint, lightNormal, cosLight);  // the light itself would block it
        toSolidAngle = cosLight / (distance * distance);
        float solidAngle = sphericalSolidAngle(triangle, surfacePoint);
        s.pdf = solidAngle > 0.0 ? toSolidAngle / solidAngle : 1.0 / max(triangle.area, 1e-12);
        s.light = emissionAt(triangle.materialIndex, lightUv) * toSolidAngle;
    } else if (kind == LIGHT_KIND_PUNCTUAL) {
        s = punctualLightSample(punctualLights[index], surfacePoint);
        s.pdf = 1.0;
    } else if (kind == LIGHT_KIND_SKY) {
        s.direction = decodeSkyPoint(point);
        s.distance = SKY_DISTANCE;
        s.pdf = environmentPdf(s.direction);
        s.light = environmentLight(s.direction);
    }
    s.mis = MIS_NONE;
    s.shadowed = true;
    return s;
}

// The target: how bright the sample would make the surface (seen from direction v) if nothing blocked it.
// Same rules as the light loop: in front of the surface, or behind one that lets light through.
// brdfPdf: the chance (per solid angle) of BRDF sampling picking the sample's direction.
float restirTarget(Hit hit, vec3 v, LightSample s, out float brdfPdf) {
    brdfPdf = 0.0;
    float cosLight = dot(hit.normal, s.direction);
    float side = dot(hit.geometricNormal, s.direction);
    bool behind = cosLight < 0.0 && side < 0.0 && hit.diffuseTransmission > 0.0;
    if (!((cosLight > 0.0 && side > 0.0) || behind)) {
        return 0.0;
    }
    return luminance(s.light * evaluateBrdfWorld(hit, hit.normal, v, s.direction, brdfPdf) * abs(cosLight));
}

bool isGlassAt(uint materialIndex, vec2 uv);
uint primaryHitIndex(ivec2 pixel);

// Whether a candidate hit stops a ray the way it stops shadow rays (see shadowTransmittance): holes of cut-outs
// (by chance, for see-through ones) and glass let it through.
bool blocksLight(uint meshIndex, int primitive, vec2 bary, inout uint seed) {
    MeshInfo mesh = meshInfos[meshIndex];
    uint firstIndex = mesh.indexOffset + uint(primitive) * 3;
    vec2 uv0 = vertices[mesh.vertexOffset + indices[firstIndex + 0]].uv;
    vec2 uv1 = vertices[mesh.vertexOffset + indices[firstIndex + 1]].uv;
    vec2 uv2 = vertices[mesh.vertexOffset + indices[firstIndex + 2]].uv;
    vec2 uv = uv0 * (1.0 - bary.x - bary.y) + uv1 * bary.x + uv2 * bary.y;
    float opacity = opacityAt(mesh.materialIndex, uv);
    if (opacity < 1.0 && (opacity <= 0.0 || randomFloat(seed) >= opacity)) {
        return false;
    }
    return !isGlassAt(mesh.materialIndex, uv);
}

// Glass: lets light through without being metal (shadow rays and the BRDF candidates' rays pass it)
bool isGlassAt(uint materialIndex, vec2 uv) {
    Material material = materials[materialIndex];
    if (FOG != 0 && material.invisible != 0) {
        return true;  // (fog: invisible surfaces)
    }
    float transmission = FEATURE_GLASS ? material.transmission : 0.0;
    if (transmission > 0.0 && material.transmissionTexture >= 0) {
        transmission *= sampleTextureFull(material.transmissionTexture, material.transmissionUvTransform, uv).r;
    }
    float metallic = material.metallic;
    if (transmission > 0.0 && material.metallicRoughnessTexture >= 0) {
        metallic *= sampleTextureFull(material.metallicRoughnessTexture, material.metallicRoughnessUvTransform, uv).b;
    }
    return transmission > 0.0 && metallic < 1.0;
}

bool isGlassHit(Intersection hit) {
    MeshInfo mesh = meshInfos[hit.meshIndex];
    if ((!FEATURE_GLASS || materials[mesh.materialIndex].transmission <= 0.0)
        && (FOG == 0 || materials[mesh.materialIndex].invisible == 0)) {
        return false;  // almost every hit: no vertex or texture reads
    }
    uint firstIndex = mesh.indexOffset + uint(hit.primitive) * 3;
    vec2 uv0 = vertices[mesh.vertexOffset + indices[firstIndex + 0]].uv;
    vec2 uv1 = vertices[mesh.vertexOffset + indices[firstIndex + 1]].uv;
    vec2 uv2 = vertices[mesh.vertexOffset + indices[firstIndex + 2]].uv;
    vec2 uv = uv0 * (1.0 - hit.barycentrics.x - hit.barycentrics.y) + uv1 * hit.barycentrics.x
              + uv2 * hit.barycentrics.y;
    return isGlassAt(mesh.materialIndex, uv);
}

// The image path's first bounce at this pixel's ReSTIR surface (see BounceHit). bounces = false: the path ends.
void storeBounceHit(bool bounces, bool found, Intersection hit, vec3 direction, vec3 weight, float pdf,
                    float lobeRoughness, bool transmitted, bool specularLobe, bool throughPortal) {
    BounceHit stored;
    stored.meshIndex = !bounces ? BOUNCE_NONE : found ? hit.meshIndex : ~0u;
    stored.instanceIndex = hit.instanceIndex;
    stored.primitive = hit.primitive;
    stored.barycentrics = hit.barycentrics;
    stored.t = hit.t;
    stored.direction = direction;
    stored.weightRG = packHalf2x16(weight.rg);
    stored.weightBRoughness = (packHalf2x16(vec2(weight.b, 0.0)) & 0xFFFFu)
                              | (uint(round(clamp(lobeRoughness, 0.0, 1.0) * 255.0)) << 16)
                              | ((transmitted ? 1u : 0u) << 24) | ((specularLobe ? 2u : 0u) << 24)
                              | (throughPortal ? BOUNCE_RETRACE : 0u);
    stored.pdf = pdf;
    bounceHits[primaryHitIndex(ivec2(gl_GlobalInvocationID.xy))] = stored;
}

// The BRDF candidates' ray: the first surface that isn't glass. Through glass like the shadow rays, so the BRDF
// candidates find exactly the lights that light candidates can reach: the MIS weights count on that (a light
// behind a window would otherwise get the BRDF share of its weight but never be found by a BRDF ray).
// Stops at a portal's opening, as shadow rays do: false with travelled = -1 then (no light).
bool intersectTowardsLight(vec3 origin, vec3 direction, inout uint seed, out Intersection hit) {
    float portalT = RAY_FAR;
    int portal = portalCount() > 0 ? nearestPortal(origin, direction, RAY_FAR, -1, portalT) : -1;
    hit.travelled = 0.0;
    hit.crossings = 0;
    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, tlas, SHADOW_RAY_FLAGS, 0xFF, origin, 0.0, direction,
                          portal >= 0 ? max(portalT - PORTAL_GAP, 0.0) : RAY_FAR);
    while (rayQueryProceedEXT(rayQuery)) {
        if (SHADOW_RAY_FLAGS == gl_RayFlagsNoneEXT &&
            rayQueryGetIntersectionTypeEXT(rayQuery, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
            blocksLight(rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, false),
                        rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, false),
                        rayQueryGetIntersectionBarycentricsEXT(rayQuery, false), seed)) {
            rayQueryConfirmIntersectionEXT(rayQuery);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        hit.travelled = portal >= 0 ? -1.0 : 0.0;
        return false;
    }
    hit.meshIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
    hit.instanceIndex = rayQueryGetIntersectionInstanceIdEXT(rayQuery, true);
    hit.primitive = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);
    hit.barycentrics = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
    hit.t = rayQueryGetIntersectionTEXT(rayQuery, true);
    return true;
}

// The RESTIR_PASS's candidates for a surface seen from direction v. Streaming RIS: each candidate replaces the
// kept one with a chance of its weight / the sum of the weights so far.
Reservoir restirCandidates(Hit hit, vec3 v, inout uint seed) {
    vec3 surfacePoint = hit.position;
    bool twoSided = hit.diffuseTransmission > 0.0;
    uint triangles = scene.restirTriangleCandidates;
    uint punctual = scene.restirPunctualCandidates;
    uint sky = scene.restirSkyCandidates;
    uint lightCandidates = triangles + punctual + sky;
    uint total = lightCandidates + scene.restirBrdfCandidates;
    Reservoir r;
    r.light = LIGHT_KIND_NONE << 30;
    r.point = 0;
    r.M = float(total);
    float weightSum = 0.0;
    float keptTarget = 0.0;
    [[dont_unroll]] for (uint i = 0; i < total; i++) {
        uint light;
        uint point = 0;
        float pickProbability = 0.0;  // triangles: the chance that light sampling picks this one
        if (i < triangles) {
            int index = pickEmissiveTriangle(hit.position, hit.normal, twoSided, randomFloat(seed), pickProbability);
            if (index < 0) {
                continue;
            }
            vec3 weights;  // as in sampleEmissiveLight
            if (!pointOnTriangle(emissiveTriangles[index], surfacePoint, vec2(randomFloat(seed), randomFloat(seed)),
                                 weights)) {
                continue;
            }
            point = packUnorm2x16(weights.yz);
            light = (LIGHT_KIND_TRIANGLE << 30) | uint(index);
        } else if (i < triangles + punctual) {
            uint count = punctualLightCount();
            uint index = min(uint(randomFloat(seed) * float(count)), count - 1);
            light = (LIGHT_KIND_PUNCTUAL << 30) | index;
        } else if (i < lightCandidates) {
            float pdf;
            point = encodeSkyPoint(sampleEnvironment(vec4(randomFloat(seed), randomFloat(seed), randomFloat(seed),
                                                          randomFloat(seed)), pdf));
            light = LIGHT_KIND_SKY << 30;
        } else {
            // BRDF sampling: a direction as the bounce ray would pick it, and the light its ray finds (if light
            // sampling could have picked it too; otherwise the bounce ray counts that light, see tracePath)
            ShadingFrame frame = makeShadingFrame(hit.normal);
            vec3 l, weight;
            float pdf, lobeRoughness;
            bool transmitted, specularLobe;
            Intersection none = Intersection(0u, 0u, 0, vec2(0.0), 0.0, 0.0, 0u, false, NO_MEDIUM, vec2(0.0), OUTSIDE, 0.0,
                                             0.0);
            vec3 random = vec3(randomFloat(seed), randomFloat(seed), randomFloat(seed));
            if (!sampleBrdf(hit, toLocal(frame, v), random, l, weight, pdf, lobeRoughness, transmitted, specularLobe)) {
                if (i == lightCandidates) {
                    storeBounceHit(false, false, none, vec3(0.0), vec3(0.0), 0.0, 0.0, false, false, false);
                }
                continue;
            }
            vec3 direction = toWorld(frame, l);
            float side = dot(direction, hit.geometricNormal);
            // The first BRDF candidate's ray is also the image path's first bounce: traced like a path ray (it
            // stops at glass) and stored, so the image pass doesn't trace its own (part C4)
            bool pathBounce = i == lightCandidates;
            if (l.z < 0.0 ? side >= 0.0 : side <= 0.0) {
                if (pathBounce) {
                    storeBounceHit(false, false, none, direction, weight, pdf, lobeRoughness, transmitted, specularLobe,
                                   false);
                }
                continue;  // on the wrong side of the real triangle (see tracePath)
            }
            Intersection found;
            vec3 origin = offsetRay(hit.position, side < 0.0 ? -hit.geometricNormal : hit.geometricNormal);
            bool foundSurface;
            if (pathBounce) {
                vec3 rayOrigin = origin;
                vec3 rayDirection = direction;
                foundSurface = intersectClosest(rayOrigin, rayDirection, seed, found);
                bool throughPortal = found.travelled != 0.0;
                storeBounceHit(true, foundSurface, found, direction, weight, pdf, lobeRoughness, transmitted,
                               specularLobe, throughPortal);
                if (throughPortal) {
                    continue;  // not a light candidate: light sampling can't reach through a portal
                }
                // The candidate goes on through glass, as shadow rays do (rare: one more ray)
                if (foundSurface && isGlassHit(found)) {
                    foundSurface = intersectTowardsLight(origin + direction * found.t, direction, seed, found);
                }
            } else {
                foundSurface = intersectTowardsLight(origin, direction, seed, found);
            }
            if (foundSurface) {
                int firstLight = instanceFirstLight[found.instanceIndex];
                if (triangles == 0 || firstLight < 0) {
                    continue;
                }
                int index = firstLight + found.primitive;
                pickProbability = lightPickProbability(index, hit.position, hit.normal, twoSided);
                if (pickProbability <= 0.0) {
                    continue;
                }
                point = packUnorm2x16(found.barycentrics);
                light = (LIGHT_KIND_TRIANGLE << 30) | uint(index);
            } else {
                if (sky == 0 || found.travelled < 0.0) {
                    continue;  // (or the ray went into a portal)
                }
                point = encodeSkyPoint(direction);
                light = LIGHT_KIND_SKY << 30;
            }
        }
        // Evaluated from the stored (rounded) point, so the pdfs and the target are exactly the kept sample's
        float toSolidAngle;
        LightSample s = restirLightSample(light, point, surfacePoint, toSolidAngle);
        float brdfPdf;
        float target = restirTarget(hit, v, s, brdfPdf);
        uint kind = light >> 30;
        float sourcePdf;  // sum over the strategies of (number of candidates * pdf), per unit of the light's measure
        if (kind == LIGHT_KIND_PUNCTUAL) {
            sourcePdf = float(punctual) / float(punctualLightCount());
        } else {
            sourcePdf = (kind == LIGHT_KIND_TRIANGLE ? float(triangles) * pickProbability : float(sky)) * s.pdf
                        + float(scene.restirBrdfCandidates) * brdfPdf * toSolidAngle;
        }
        if (target <= 0.0 || !(sourcePdf > 0.0)) {
            continue;
        }
        float weight = target / sourcePdf;
        weightSum += weight;
        if (randomFloat(seed) * weightSum < weight) {
            r.light = light;
            r.point = point;
            keptTarget = target;
        }
    }
    r.W = keptTarget > 0.0 ? weightSum / keptTarget : 0.0;
    return r;
}

// The image pass's light sample at a ReSTIR surface: the reservoir's, its light times W
LightSample restirReservoirSample(ivec2 pixel, vec3 surfacePoint) {
    Reservoir r = reservoirs[restirIndex(pixel, false)];
    if (!(r.W > 0.0)) {
        return noLightSample();
    }
    float toSolidAngle;
    LightSample s = restirLightSample(r.light, r.point, surfacePoint, toSolidAngle);
    s.light *= r.W;
    return s;
}

// The target of a reservoir's sample at a surface (0 for none)
float restirTargetOf(Reservoir r, Hit hit, vec3 v) {
    if ((r.light >> 30) == LIGHT_KIND_NONE) {
        return 0.0;
    }
    float toSolidAngle, brdfPdf;
    LightSample s = restirLightSample(r.light, r.point, hit.position, toSolidAngle);
    return restirTarget(hit, v, s, brdfPdf);
}

// A reservoir's sample without the surface it lights: what restirLightSample looks up (the triangle, its emission
// texture, the sky map), once, for targets at several surfaces (restirTargetAt). The spatial pass needs 3k + 1
// targets of only k + 1 samples.
struct RestirLightPoint {
    uint kind;        // LIGHT_KIND_*
    uint index;       // punctual lights: which
    vec3 position;    // triangles: the point; the sky: the direction towards it
    vec3 normal;      // triangles'
    vec3 emission;    // triangles: the emitted light; the sky: its light
};

RestirLightPoint restirLightPoint(Reservoir r) {
    RestirLightPoint p;
    p.kind = r.light >> 30;
    p.index = r.light & 0x3FFFFFFFu;
    p.position = vec3(0.0);
    p.normal = vec3(0.0, 1.0, 0.0);
    p.emission = vec3(0.0);
    if (p.kind == LIGHT_KIND_TRIANGLE) {
        EmissiveTriangle triangle = emissiveTriangles[p.index];
        vec2 bary = unpackUnorm2x16(r.point);
        vec3 weights = vec3(max(1.0 - bary.x - bary.y, 0.0), bary);
        p.position = triangle.p0 * weights.x + triangle.p1 * weights.y + triangle.p2 * weights.z;
        p.normal = normalize(cross(triangle.p1 - triangle.p0, triangle.p2 - triangle.p0));
        p.emission = emissionAt(triangle.materialIndex,
                                triangle.uv0 * weights.x + triangle.uv1 * weights.y + triangle.uv2 * weights.z);
    } else if (p.kind == LIGHT_KIND_SKY) {
        p.position = decodeSkyPoint(r.point);
        p.emission = environmentLight(p.position);
    }
    return p;
}

// restirTargetOf from a looked-up sample (the same value)
float restirTargetAt(RestirLightPoint p, Hit hit, vec3 v) {
    vec3 surfacePoint = hit.position;
    LightSample s = noLightSample();
    if (p.kind == LIGHT_KIND_TRIANGLE) {
        vec3 toLight = p.position - surfacePoint;
        float distance = length(toLight);
        s.direction = toLight / distance;
        float cosLight = abs(dot(p.normal, s.direction));
        if (cosLight <= 1e-6) {
            return 0.0;
        }
        s.light = p.emission * (cosLight / (distance * distance));
    } else if (p.kind == LIGHT_KIND_PUNCTUAL) {
        s = punctualLightSample(punctualLights[p.index], surfacePoint);
    } else if (p.kind == LIGHT_KIND_SKY) {
        s.direction = p.position;
        s.light = p.emission;
    } else {
        return 0.0;
    }
    float brdfPdf;
    return restirTarget(hit, v, s, brdfPdf);
}

// ---------------------------------------------------------------------------------------------

// DLSS inputs

// What DLSS needs to know about the first surface a camera ray hits (see the images at the top). Stored as soon as
// they are known, not at the end of the path: carried along, they would take registers through every bounce.

// Pixel position of a world-space point (w = 1) or direction (w = 0, a point infinitely far away) on the image
vec2 projectToPixel(mat4 viewProjection, vec4 point) {
    vec4 clip = viewProjection * point;
    vec2 ndc = clip.xy / clip.w;
    return (ndc * 0.5 + 0.5) * vec2(imageSize(radianceImage));
}

// Motion vector: where the point was on the image last frame minus where it is now, both without jitter.
// A point behind last frame's camera has no sensible position: no motion then.
vec2 motionVector(vec4 current, vec4 previous) {
    if ((scene.previousViewProjection * previous).w <= 0.0) {
        return vec2(0.0);
    }
    return projectToPixel(scene.previousViewProjection, previous) - projectToPixel(scene.viewProjection, current);
}

// Rays that hit nothing: far away, moving only with the camera's rotation. The other guides as DLSS RR's guide
// recommends for the sky: albedo 0.5, no specular, normal and roughness 0, the largest half float as hit distance.
void storeSkyGuides(ivec2 pixel, vec3 direction) {
    imageStore(linearDepthImage, pixel, vec4(scene.farDistance));
    imageStore(motionVectorImage, pixel, vec4(motionVector(vec4(direction, 0.0), vec4(direction, 0.0)), 0.0, 0.0));
    imageStore(diffuseAlbedoImage, pixel, vec4(0.5, 0.5, 0.5, 1.0));
    imageStore(specularAlbedoImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    imageStore(normalRoughnessImage, pixel, vec4(0.0));
    imageStore(specularHitDistanceImage, pixel, vec4(65504.0));
}

// The first surface. The albedos split its response the way evaluateBrdf does: the diffuse layer gets what the
// (energy compensated) reflection doesn't return; light going through glass counts as specular (it stays sharp,
// like a reflection). The specular hit distance is 0 (unknown) unless the bounce from here reflects (tracePath).
// direction: the ray's last part (after portals), cameraDirection: the camera ray's own. Seen through a portal, the
// surface is where it appears: `distance` (the whole length) along the camera ray (portals don't move with the
// camera), not where it is. Seen through mirrors (storeMirrorGuides) likewise, its normal turned the way the
// mirrors turn it (toCamera) and its albedos tinted by their color (tint).
void storeSurfaceGuides(ivec2 pixel, Hit hit, vec3 direction, vec3 cameraDirection, bool virtualPosition,
                        float distance, mat3 toCamera, vec3 tint) {
    // A point on an object that moved is reprojected with the object's own motion as well
    vec4 position = vec4(virtualPosition ? scene.cameraPosition.xyz + cameraDirection * distance : hit.position, 1.0);
    vec4 previousPosition = virtualPosition ? position : instances[hit.instanceIndex].motion * position;
    imageStore(linearDepthImage, pixel, vec4(distance * dot(cameraDirection, scene.cameraForward.xyz)));
    imageStore(motionVectorImage, pixel, vec4(motionVector(position, previousPosition), 0.0, 0.0));
    ReflectionEnergy energy = reflectionEnergy(hit, dot(hit.normal, -direction));
    vec3 base = (1.0 - hit.metallic) * (1.0 - energy.dielectricAlbedo) * hit.albedo;
    vec3 diffuseAlbedo = (1.0 - hit.metallic) * (1.0 - energy.dielectricAlbedo) * (1.0 - hit.transmission)
                         * mix(hit.albedo, hit.diffuseTransmissionColor, hit.diffuseTransmission);
    vec3 specularAlbedo = mix(vec3(energy.dielectricAlbedo), energy.metalAlbedo, hit.metallic) + base * hit.transmission;
    // Glowing surfaces: white, no specular. DLSS divides the light by the albedo and multiplies it back; a lamp's
    // own light divided by its (often dark) material color became a huge, noisy value. Bistro at night (DLAA):
    // 54% less error after 8 frames, 23% after 64, the fairy lights less smeared in motion.
    if (luminance(hit.emissive) > 0.0) {
        diffuseAlbedo = vec3(1.0);
        specularAlbedo = vec3(0.0);
    }
    imageStore(diffuseAlbedoImage, pixel, vec4(diffuseAlbedo * tint, 1.0));
    imageStore(specularAlbedoImage, pixel, vec4(specularAlbedo * tint, 1.0));
    imageStore(normalRoughnessImage, pixel, vec4(toCamera * hit.normal, hit.roughness));
    imageStore(specularHitDistanceImage, pixel, vec4(0.0));
}

// A perfect mirror for the guides: smooth (roughness 0) metal. A smooth non-metal isn't one: what it shows is
// mostly its own color (or what is behind it, glass), the reflection only a few percent.
bool guideMirror(Hit hit) {
    return hit.roughness <= 0.0 && hit.metallic >= 0.99 && hit.transmission <= 0.0 && luminance(hit.emissive) <= 0.0;
}

// Mirrors and the guides (primary surface replacement, as NVIDIA recommends for DLSS RR). DLSS keeps edges and
// texture by the guides of the surface the camera sees; a mirror's are flat and plain, so DLSS can't tell what it
// shows from noise and smudges it. When the camera sees a mirror, this follows the reflection to the first surface
// that isn't one and writes the guides again, for that surface as it appears in the mirrors: at the whole length
// along the camera ray (the reflections are rigid, so the image of a still point stands still), its normal
// mirrored back by each mirror's plane, its albedo tinted by the mirrors' color. The sky: as seen directly.
// A chain longer than maxBounces keeps the first mirror's guides.
// Its own trace from the camera, after the path (see main), rather than following the path's bounces: anything
// the path's loop keeps, or traces in it, costs registers in every pixel (that took the trace shader from 128 to
// 168). The path only notes that the camera sees a mirror (guidesRetrace).
// The same when the camera ray scattered in the fog (see "Fog"): the path never got to the surface, and it changes
// from frame to frame which pixels do; the guides stay those of what the camera sees behind the fog.
bool guidesRetrace = false;

void storeMirrorGuides(ivec2 pixel, vec3 cameraDirection, uint seed) {
    mat3 toCamera = mat3(1.0);
    vec3 tint = vec3(1.0);
    float distance = 0.0;
    vec3 origin = scene.cameraPosition.xyz;
    vec3 direction = cameraDirection;
    float coneSpread = scene.pixelSpreadAngle;  // the camera ray's cone, which the mirrors don't widen
    for (uint i = 0; i <= scene.maxBounces; i++) {
        Intersection intersection;
        if (!intersectClosest(origin, direction, seed, intersection)) {
            if (intersection.travelled >= 0.0) {
                storeSkyGuides(pixel, cameraDirection);
            }
            return;
        }
        Hit hit = hitFromIntersection(intersection, direction, coneSpread * distance, coneSpread);
        tiltTowardsViewer(hit, direction);
        distance += hit.t;
        if (!guideMirror(hit)) {
            storeSurfaceGuides(pixel, hit, direction, cameraDirection, i > 0 || intersection.travelled != 0.0,
                               distance, toCamera, tint);
            return;
        }
        toCamera = toCamera * (mat3(1.0) - 2.0 * outerProduct(hit.normal, hit.normal));
        tint *= fresnelSchlick(hit.albedo, dot(hit.normal, -direction));
        direction = reflect(direction, hit.normal);
        origin = offsetRay(hit.position, hit.geometricNormal);
    }
}

// Mirrors and ReSTIR. ReSTIR works on the first surface the camera sees; in a mirror that is the mirror, too smooth
// for it, and what the mirror shows got none: plain light sampling, far noisier than the same surface seen directly.
// So the RESTIR_PASS follows the camera ray through mirrors (guideMirror) to the first surface that isn't one, and
// that becomes the pixel's surface: for ReSTIR DI and GI, and for the image pass, which goes on from it with the
// last part's direction and the mirrors' color as its throughput (loadPrimaryHit). The mirrors themselves aren't
// shaded: a perfect mirror's light sampling finds next to nothing, its light comes with its reflection.
// For the reuse, such a surface is seen from the camera's mirror image: its view direction is the last part's
// (RestirSurface.view), and its depth and last frame's pixel are those of where the camera sees it (seenAt), which
// stands still with the mirrors. Through a portal anywhere on the way: not stored, as before (PRIMARY_THROUGH_PORTAL).
// It also writes the guides of pixels that see a mirror (as storeMirrorGuides); the image pass leaves them.
// direction: the camera ray's, then its last part's. travelled: the length before the last part (0: no mirror).
// hit: the surface (unset if nothing was hit), its t along the last part.
bool traceCameraRay(ivec2 pixel, inout vec3 direction, inout uint seed, out Intersection intersection, out Hit hit,
                    out vec3 tint, out float travelled, out bool throughPortal) {
    vec3 cameraDirection = direction;
    vec3 origin = scene.cameraPosition.xyz;
    mat3 toCamera = mat3(1.0);
    tint = vec3(1.0);
    travelled = 0.0;
    throughPortal = false;
    float coneSpread = scene.pixelSpreadAngle;  // the camera ray's cone, which the mirrors don't widen
    for (uint i = 0; i <= scene.maxBounces; i++) {
        bool found = intersectClosest(origin, direction, seed, intersection);
        if (intersection.travelled != 0.0) {
            throughPortal = true;
            return found;
        }
        if (found) {
            hit = hitFromIntersection(intersection, direction, coneSpread * travelled, coneSpread);
            tiltTowardsViewer(hit, direction);
        }
        // With fog the image pass decides where the camera ray scatters, along a straight line (tracePath)
        if (!found || !guideMirror(hit) || i == scene.maxBounces || FOG != 0) {
            if (travelled > 0.0 && scene.writeGuides != 0) {
                if (found) {
                    storeSurfaceGuides(pixel, hit, direction, cameraDirection, true, travelled + hit.t, toCamera, tint);
                } else {
                    storeSkyGuides(pixel, cameraDirection);
                }
            }
            return found;
        }
        // A mirror: on along the reflection, its image mirrored by the mirror's plane
        toCamera = toCamera * (mat3(1.0) - 2.0 * outerProduct(hit.normal, hit.normal));
        tint *= fresnelSchlick(hit.albedo, dot(hit.normal, -direction));
        travelled += hit.t;
        origin = offsetRay(hit.position, hit.geometricNormal);
        direction = reflect(direction, hit.normal);
    }
    return false;
}

// ---------------------------------------------------------------------------------------------
// Radiance cache
//
// In a scene lit mostly indirectly (Sponza's shade: sunlight bouncing off the courtyard floor and walls), a path
// needs several random bounces to find the light, and most don't: noise. The cache remembers, for small cells on
// the surfaces, how much indirect light leaves them. A path whose bounce spread out (diffuse or rough) lights the
// surface it lands on directly (shadow rays to the sun and the lamps, as usual), adds the cell's indirect light
// and stops there: one bounce ray instead of many, and an average of many paths instead of one.
// The cells are filled by a few full-length "update paths" per frame (one per cacheUpdateTile^2 pixels): every
// surface they hit gets the light they found from there on, except its own direct light. Direct light has sharp
// shadow edges, and a cell lying across one would spread sunlight into the shade (a path from a dark corner
// mostly lands on the shaded part of such a cell); indirect light is smooth enough for cells.
// Averaged over recent frames, so the cache follows changes (moving objects, the sun) with a short lag. Biased:
// a cell averages its whole area and all directions, which blurs indirect light a little.
//
// Cells: about scene.cacheCellScale * distance wide (a few pixels on screen wherever they are), rounded to a power
// of two so that nearby points agree, and separate per side a surface faces (floor and wall meeting at a corner
// don't mix). Hash table with up to CACHE_PROBES slots tried per cell (linear probing).

const uint CACHE_PROBES = 8;
const uint CACHE_MAX_VERTICES = 8;      // update paths fill the cells of their first 8 surfaces
const float MIRROR_ROUGHNESS = 0.01;    // smoother reflections count as mirrors: no Russian roulette after them
const float CACHE_ROUGHNESS = 0.25;     // smoother surfaces (and glass) reflect too sharply to be cached
const float CACHE_MAX_RADIANCE = 256.0; // one sample's light is clamped to this (rare glints of the sun)
// A cell averages its whole area, so in a corner it holds more light than the corner itself gets (the walls
// further out are brighter). A path that reached the cell with a short ray, i.e. from right next to it (inside
// a corner, under an object), would show that average as light leaking in; only rays longer than this many
// cell sizes end in the cache, the others trace on.
const float CACHE_MIN_RAY_CELLS = 2.0;

bool cacheableSurface(Hit hit) {
    return hit.transmission <= 0.0 && hit.roughness >= CACHE_ROUGHNESS && !isFog(hit);
}

// The cell of a surface point: where the table search starts (slot) and the cell's id (fingerprint, never 0).
// Two different hashes of the same cell coordinates, so two cells sharing a slot are told apart.
void cacheCell(vec3 position, vec3 normal, out uint slot, out uint fingerprint, out float cellSize) {
    float distance = max(length(position - scene.cameraPosition.xyz), 1e-4);
    int level = clamp(int(floor(log2(distance * scene.cacheCellScale))), -14, 10);
    cellSize = exp2(float(level));
    ivec3 cell = ivec3(floor(position / cellSize));
    vec3 a = abs(normal);
    uint axis = a.x >= a.y && a.x >= a.z ? 0u : (a.y >= a.z ? 1u : 2u);
    uint facing = axis * 2u + (normal[axis] < 0.0 ? 1u : 0u);  // which of the 6 main directions it faces
    uint extra = uint(level + 16) | (facing << 8);
    slot = pcgHash(uint(cell.x) + pcgHash(uint(cell.y) + pcgHash(uint(cell.z) + pcgHash(extra))));
    fingerprint = pcgHash((uint(cell.x) * 0x27d4eb2du) ^ pcgHash((uint(cell.y) * 0x165667b1u)
                  ^ pcgHash((uint(cell.z) * 0x85ebca6bu) ^ (extra * 0x9e3779b9u)))) | 1u;
}

int cacheFind(uint slot, uint fingerprint) {
    uint mask = scene.cacheCapacity - 1u;
    for (uint i = 0; i < CACHE_PROBES; i++) {
        uint index = (slot + i) & mask;
        if (cacheKeys[index] == fingerprint) {
            return int(index);
        }
    }
    return -1;
}

// Finds the cell's entry or claims the first empty slot for it. -1: all slots taken by other cells.
int cacheFindOrInsert(uint slot, uint fingerprint) {
    int found = cacheFind(slot, fingerprint);
    if (found >= 0) {
        return found;
    }
    uint mask = scene.cacheCapacity - 1u;
    for (uint i = 0; i < CACHE_PROBES; i++) {
        uint index = (slot + i) & mask;
        uint previous = atomicCompSwap(cacheKeys[index], 0u, fingerprint);
        if (previous == 0u || previous == fingerprint) {  // claimed it, or another path just did for the same cell
            return int(index);
        }
    }
    return -1;
}

// ---------------------------------------------------------------------------------------------
// Primary hits
//
// With ReSTIR DI the camera rays are traced in a pass of their own (RESTIR_PASS), before the image pass: ReSTIR
// needs every pixel's first surface before any pixel gets shaded. The image pass then reads the stored hit instead
// of tracing the ray again.

uint primaryHitIndex(ivec2 pixel) {
    return uint(pixel.y) * uint(imageSize(radianceImage).x) + uint(pixel.x);
}

void storePrimaryHit(ivec2 pixel, bool found, Intersection intersection, uint seed, bool throughPortal,
                     float travelled, vec3 direction, vec3 tint) {
    PrimaryHit stored;
    stored.meshIndex = throughPortal ? PRIMARY_THROUGH_PORTAL : found ? intersection.meshIndex : ~0u;
    stored.travelled = travelled;
    stored.direction = direction;
    stored.tintRG = packHalf2x16(tint.rg);
    stored.tintB = packHalf2x16(vec2(tint.b, 0.0));
    stored.instanceIndex = intersection.instanceIndex;
    stored.primitive = intersection.primitive;
    stored.barycentrics = intersection.barycentrics;
    stored.t = intersection.t;
    stored.seed = seed;
    primaryHits[primaryHitIndex(pixel)] = stored;
}

// false: the camera ray hit nothing. The pixel's random numbers go on from where the RESTIR_PASS left them, so
// the path continues exactly as if the image pass had traced the ray itself. (Not for a ray through a portal: see
// primaryHitStored.) Seen in mirrors: direction becomes the ray's last part, tint the mirrors' color, and the
// intersection's travelled the length before it (crossings stays 0: that tells it from a portal's).
bool loadPrimaryHit(ivec2 pixel, inout uint seed, out Intersection intersection, inout vec3 direction, out vec3 tint) {
    PrimaryHit stored = primaryHits[primaryHitIndex(pixel)];
    seed = stored.seed;
    intersection.travelled = stored.travelled;
    intersection.crossings = 0;
    intersection.inFog = false;
    intersection.lampWeight = 0.0;
    tint = vec3(1.0);
    if (stored.travelled > 0.0) {
        direction = stored.direction;
        tint = vec3(unpackHalf2x16(stored.tintRG), unpackHalf2x16(stored.tintB).x);
    }
    if (stored.meshIndex >= PRIMARY_THROUGH_PORTAL) {
        return false;
    }
    intersection.meshIndex = stored.meshIndex;
    intersection.instanceIndex = stored.instanceIndex;
    intersection.primitive = stored.primitive;
    intersection.barycentrics = stored.barycentrics;
    intersection.t = stored.t;
    return true;
}

// Whether the RESTIR_PASS stored the camera ray's hit: not if it went through a portal
bool primaryHitStored(ivec2 pixel) {
    return primaryHits[primaryHitIndex(pixel)].meshIndex != PRIMARY_THROUGH_PORTAL;
}

// ---------------------------------------------------------------------------------------------

// Follows one path from the camera through up to maxBounces surfaces and returns the light it carries back.
// storeGuides: write the DLSS inputs of this path (the first hit, and the distance to the second if the first
// bounce reflected) for this thread's pixel. usePrimaryHit: the camera ray's hit is this pixel's stored one
// (see "Primary hits"), its direct light comes from the pixel's ReSTIR reservoir (ReSTIR DI), and its first
// bounce's light becomes a GI sample (ReSTIR GI); direction must be the same camera ray.
//
// Keep in mind when adding to this loop: every value that lives from one bounce to the next, or across the light
// loop below (whose shadow ray needs many registers of its own), takes a register in every pixel. The shader is
// near the point where the GPU fits fewer pixels at a time, or moves values out to slow memory (the Debug tab
// shows both: register count and local memory). Recomputing something cheap, reading it from the uniforms, or
// storing it right away is usually faster than keeping it.
// The current path's camera ray scattered in fog (see fogAmountImage)
float cameraRayFog = 0.0;

vec3 tracePath(vec3 origin, vec3 direction, inout uint seed, bool storeGuides, bool usePrimaryHit) {
    // The sun is a small glowing disc in the sky. Its total light (PI * sunColor, see below) is spread evenly
    // over the disc's solid angle. Like glowing triangles, it is found both by shadow rays aimed at it and by
    // bounce rays that happen to hit it, combined with MIS: a mirror finds it through its bounce ray, a matte
    // surface through the shadow ray (scene.sunMis). The sky: found by bounce rays that leave the scene, and (if
    // on) by shadow rays aimed at it, again with MIS (scene.environmentSampling).

    vec3 radiance = vec3(0.0);    // light collected along this path
    vec3 throughput = vec3(1.0);  // fraction of light found further along that still reaches the camera
    // The guides cost a little at the first hit (projections, albedos); skipped when nobody reads them.
    bool wantGuides = storeGuides && scene.writeGuides != 0 && CACHE_UPDATE_PASS == 0;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    // Update paths: the cache entries of the surfaces hit so far, and per surface the light found after it,
    // as seen from that surface (divided by the throughput up to it). Adding to these as the light is found
    // (ADD_LIGHT) keeps dim light found late accurate, instead of subtracting large sums at the end.
    int cacheEntries[CACHE_MAX_VERTICES];
    vec3 cacheInverseThroughput[CACHE_MAX_VERTICES];
    vec3 cacheLight[CACHE_MAX_VERTICES];
    uint cacheVertices = 0;
    bool previousLobeRough = false;  // the bounce that led to this hit spread out (diffuse or rough)
    // The update path's entry of the surface hit in this bounce and in the one before (-1: none): their direct
    // light (shadow rays from there, and the light-sampled lights their bounce ray hits) stays out of their cells.
    int currentVertex = -1;
    int previousVertex = -1;
    bool endInCache = false;     // image paths: the cell of this surface has its indirect light
    vec3 cachedLight = vec3(0.0);
    // Reflections so far (passes through glass don't count): light found at a hit has made this many, light
    // reflected by the current surface one more (clampBounceLight)
    uint reflections = 0;
#define ADD_LIGHT_EXCEPT(light, skipped) { vec3 light_ = (light); radiance += clampBounceLight(light_, clampDepth); \
        if (CACHE_UPDATE_PASS != 0) { for (int i_ = 0; i_ < int(cacheVertices); i_++) { \
            if (i_ != (skipped)) { cacheLight[i_] += light_ * cacheInverseThroughput[i_]; } } } }
#define ADD_LIGHT(light) ADD_LIGHT_EXCEPT(light, -1)
    bool firstBounceSpecular = false;  // the bounce ray leaving the first hit came from a reflection/transmission
    float bouncePdf = 0.0;        // pdf of the bounce direction that led to the current hit (for MIS)
    float pathRoughness = 0.0;    // roughest reflection along the path so far (for blurCaustics)
    // The ray cone (see uvFootprint): its width where the current ray starts, and how fast it grows per unit
    float coneWidth = 0.0;
    float coneSpread = scene.pixelSpreadAngle;
    bool sampleLights = scene.emissiveTriangleCount > 0 && scene.emissiveSampling != EMISSIVE_BOUNCES_ONLY;

    // Light behind glass. Shadow rays pass glass in a straight line (tinted), so the light sampling at a surface
    // already counts lights behind glass, completely (no MIS, see shadowTransmittance). A bounce ray that went
    // through glass and then hits a light must not count it again. That needs two facts about the path:
    bool throughGlass = false;    // went through glass since the last reflection
    bool reflectedOnce = false;   // there was a reflection, i.e. a surface that did light sampling
    // Seen without any reflection before (the camera looking through a window at the sun or a lamp), nothing
    // counted it yet: then it counts fully.
    // The sky (when light-sampled) is the exception for thin panes: they don't bend the ray, so the bounce ray
    // through a window and the shadow ray through it find the same light, and share it by MIS like without glass.
    // Otherwise a glossy table reflecting the window would only get the shadow rays, which rarely hit its narrow
    // reflection: fireflies. So the sky needs to know about solid glass, and the last reflection's pdf.
    bool throughSolidGlass = false;  // went through solid glass since the last reflection
    // Portals gone through since the last reflection. Light sampling reaches the sun through one of them (light
    // images, see "Portals"), nothing else through any: whatever else such a ray finds (a glowing surface, the
    // sky, the sun after two) counts fully, and isn't that surface's direct light for the radiance cache either
    // (paths that end in the cache rely on shadow rays for that).
    uint portalCrossings = 0;
    float reflectionPdf = 0.0;       // bouncePdf of the last reflection (glass passes don't change it)
    // Where the last reflection was: the light tree's chance of picking a glowing triangle depends on the point
    vec3 reflectionPosition = vec3(0.0);
    vec3 reflectionNormal = vec3(0.0, 0.0, 1.0);
    bool reflectionTwoSided = false;
    // The last reflection was the first surface with ReSTIR DI: its reservoir counted all the light that light
    // sampling can find (glowing triangles, punctual lights, the sampled sky), behind glass or not. Its bounce ray
    // then counts only what light sampling can't pick.
    bool restirReflection = false;
    // The first bounce was picked and traced by the RESTIR_PASS (its BRDF candidate, see BounceHit)
    bool sharedBounce = false;
    // ReSTIR GI: 1 = the first surface takes a GI sample, 2 = it did at this path's second surface: from there on
    // radiance collects that sample's Lo (with the throughput starting over at 1), and giImageLight holds what the
    // pixel collected before. 3 = it found no surface that can be one.
    uint giState = 0;
    vec3 giImageLight = vec3(0.0);
    // The fog the path is in (see "Fog")
    uvec2 media = FOG != 0 ? mediumAt(origin) : OUTSIDE;

    // maxBounces surfaces get lit (by light sampling and their bounce ray). The bounce ray leaving the last one
    // is still traced, but only to collect what it sees directly (sky or a glowing surface): light sampling
    // already counts direct light at that last surface, so without this ray, sky and glowing surfaces found
    // by bouncing would be one bounce short, and the methods wouldn't agree.
    for (uint bounce = 0; bounce <= scene.maxBounces; bounce++) {
        // light found at this hit (the sky, the sun, a glowing surface). Not in a GI sample's Lo (see "ReSTIR GI").
        uint clampDepth = giState == 2 ? 0u : reflections;
        // (not traceClosest: one copy of the code that builds a Hit, called once here, keeps the shader smaller)
        Intersection intersection;
        bool found;
        vec3 rayDirection = direction;  // before any portal (the camera ray's, for the guides)
        float fogU = FOG != 0 ? pathSample(bounce, SAMPLE_FOG, seed).x : -1.0;
        bool storedHit = bounce == 0 && usePrimaryHit && primaryHitStored(pixel);
        bool storedBounce = bounce == 1 && sharedBounce
                            && (bounceHits[primaryHitIndex(pixel)].weightBRoughness & BOUNCE_RETRACE) == 0u;
        if (storedHit) {
            vec3 tint;
            found = loadPrimaryHit(pixel, seed, intersection, direction, tint);
            throughput = tint;
        } else if (storedBounce) {
            BounceHit stored = bounceHits[primaryHitIndex(pixel)];
            found = stored.meshIndex != ~0u;
            intersection.meshIndex = stored.meshIndex;
            intersection.instanceIndex = stored.instanceIndex;
            intersection.primitive = stored.primitive;
            intersection.barycentrics = stored.barycentrics;
            intersection.t = stored.t;
            intersection.travelled = 0.0;
            intersection.crossings = 0;
            intersection.inFog = false;
            intersection.lampWeight = 0.0;
        }
        // The ray; with fog also the camera ray to a stored hit again: the RESTIR_PASS's hit is the surface, this decides
        // whether it scatters in fog before it (with fog, no mirrors on the way: see traceCameraRay). One call for both:
        // the compiled shader has one copy of it (two took the varying fog's from 25 ms to 36 in a Cornell box).
        if (!storedBounce && (FOG != 0 || !storedHit)) {
            vec3 tracedOrigin = origin;
            vec3 tracedDirection = direction;
            Intersection traced;
            bool tracedFound = intersectClosest(tracedOrigin, tracedDirection, seed, media, fogU, traced);
            if (FOG == 0 || !storedHit) {
                found = tracedFound;
                intersection = traced;
                origin = tracedOrigin;
                direction = tracedDirection;
            } else if (traced.inFog) {
                found = false;
                intersection = traced;
            } else {
                intersection.lampSpan = traced.lampSpan;
                intersection.lampMedia = traced.lampMedia;
                intersection.lampMajorant = traced.lampMajorant;
                intersection.lampWeight = traced.lampWeight;
            }
        }
        // The lamps' light fog scatters into this stretch (not the final ray's: as at its end, see below). Not in
        // update paths: one more shadow ray took them from 128 registers to 168; their scatter points light-sample
        // the lamps instead (noisier, but the cache averages it).
        if (CACHE_UPDATE_PASS == 0 && intersection.lampWeight > 0.0 && bounce < scene.maxBounces) {
            ADD_LIGHT(throughput * fogLampLight(origin, direction, intersection, bounce, seed));
        }
        bool crossedPortal = intersection.travelled != 0.0;
        portalCrossings += intersection.crossings;
        Hit hit;
        hit.found = found;
        if (found) {
            hit = hitFromIntersection(intersection, direction, coneWidth, coneSpread);
        }
        if (FOG != 0 && intersection.inFog) {
            // Scattered in fog before anything: the path's vertex is there. Its color: the share that goes on; in
            // glass, also what its absorption took on the way (in world units here)
            uint medium = intersection.fogMedium;
            if (reflections == 0 && giState != 2) {
                cameraRayFog = 1.0;  // the camera sees this fog (see fogAmountImage)
            }
            vec3 scatterPoint = origin + direction * intersection.t;
            // The new direction comes out of a frame built around this one, so its rounding error would grow with
            // every scatter: after a few dozen (high Max bounces), cosines above 1 made the phase function NaN
            direction = normalize(direction);
            hit = fogHit(scatterPoint, direction, intersection.travelled + intersection.t, medium);
            throughput *= materials[medium].fogColor * exp(-materials[medium].absorption * intersection.t);
            if (bounce == 0 && wantGuides) {
                guidesRetrace = true;  // the guides: of what is behind the fog
            }
        }
        previousVertex = currentVertex;
        currentVertex = -1;
        if (bounce == 1 && firstBounceSpecular) {
            imageStore(specularHitDistanceImage, pixel, vec4(hit.found ? hit.t : 65504.0));  // the sky: as above
        }

        if (!hit.found) {
            if (bounce == 0 && wantGuides) {
                storeSkyGuides(pixel, rayDirection);  // through portals too: they turn the sky with the camera
            }
            if (intersection.travelled < 0.0) {
                break;  // lost in portals: no light
            }
            vec3 skyLight = throughput * environmentLight(direction);
            if (scene.environmentSampling == 0 || !reflectedOnce || portalCrossings > 0) {
                ADD_LIGHT(skyLight);  // nothing else finds it (the camera sees the sky, maybe through glass)
            } else if (!throughSolidGlass && !restirReflection) {
                // The bounce-sampling share of the last surface's direct skylight, also through thin panes. Unlike
                // the sun's, it goes into that surface's cache cell as well: a path ending there takes it from the
                // cache (see the shadow ray below). A smooth sky is mostly found this way, so its light comes
                // averaged; a bright spot (a map's sun) is almost entirely the shadow rays' share, so its shadows
                // stay sharp.
                ADD_LIGHT(skyLight * misWeight(reflectionPdf, environmentPdf(direction)));
            }
            // The sun's disc: always visible to the camera; for bounce rays, the MIS share of the bounce method
            if (scene.sunOn != 0 && dot(direction, scene.sunDirection.xyz) >= scene.sunDirection.w) {
                vec3 sunRadiance = scene.sunColor.rgb * scene.sunRadianceScale;
                // Its image through a portal is light-sampled only through one, and only with "Shadows" (as there)
                bool sunImaged = portalCrossings == 1 && scene.shadowsEnabled != 0;
                if (!reflectedOnce || (portalCrossings > 0 && !sunImaged)) {
                    ADD_LIGHT(throughput * sunRadiance);  // the camera sees it (maybe through glass), or portals
                } else if (sunImaged && CACHE_UPDATE_PASS != 0) {
                    // Update paths sample no light images: the bounce counts it fully, as the last surface's direct
                    // light (which image paths ending in its cell get from the image)
                    ADD_LIGHT_EXCEPT(throughput * sunRadiance, previousVertex);
                } else if (!throughGlass && scene.sunMis != 0) {
                    // the bounce-sampling share of the last surface's direct sunlight
                    ADD_LIGHT_EXCEPT(throughput * sunRadiance * misWeight(bouncePdf, scene.sunPdf), previousVertex);
                }
            }
            break;
        }
        tiltTowardsViewer(hit, direction);
        // Seen in mirrors through the RESTIR_PASS's stored hit: that pass wrote the guides (traceCameraRay)
        if (bounce == 0 && wantGuides && !(crossedPortal && intersection.crossings == 0) && !isFog(hit)) {
            storeSurfaceGuides(pixel, hit, direction, rayDirection, crossedPortal, hit.t, mat3(1.0), vec3(1.0));
            guidesRetrace = guideMirror(hit);
        }

        // Leaving a solid from the inside: the ray just travelled hit.t through it, losing light (Beer's law).
        if (hit.solid && !hit.frontFace) {
            throughput *= exp(-hit.absorption * hit.t * hit.objectScale);
        }

        // Light given off by the surface itself. Seen directly by the camera it always counts. Found by a bounce
        // ray, it is the "bounce sampling" half: with light sampling on, it shares the job (MIS) or leaves it
        // entirely to light sampling.
        if (any(greaterThan(hit.emissive, vec3(0.0)))) {
            float weight = 1.0;
            bool lightSampled = sampleLights && hit.lightIndex >= 0 && portalCrossings == 0;
            if (!lightSampled) {
                // only bounce rays find it (or the camera does)
            } else if (reflectedOnce && restirReflection) {
                weight = lightPickProbability(hit.lightIndex, reflectionPosition, reflectionNormal,
                                              reflectionTwoSided) > 0.0 ? 0.0 : 1.0;
            } else if (reflectedOnce && throughGlass) {
                weight = 0.0;
            } else if (reflectedOnce) {
                if (scene.emissiveSampling == EMISSIVE_LIGHT_SAMPLING) {
                    weight = 0.0;
                } else {
                    float cosLight = abs(dot(hit.geometricNormal, direction));
                    float pickProbability = lightPickProbability(hit.lightIndex, reflectionPosition, reflectionNormal,
                                                                 reflectionTwoSided);
                    weight = misWeight(bouncePdf, lightPdf(hit.lightIndex, pickProbability, reflectionPosition, hit.t,
                                                           cosLight));
                }
            }
            // Found by the bounce of a surface that also light-sampled it: part of that surface's direct light
            ADD_LIGHT_EXCEPT(throughput * hit.emissive * weight, reflectedOnce && lightSampled ? previousVertex : -1);
        }
        if (bounce == scene.maxBounces) {
            break;  // the final ray: only what it sees counts
        }

        // ReSTIR GI: the second surface of a GI pixel. Its glow (above) stays the first surface's; everything after
        // it is the sample's Lo.
        if (giState == 1) {
            giState = 3;
            if (restirGiSampleSurface(hit) && !crossedPortal) {  // reconnecting to it needs a straight line
                uint index = restirGiFreshIndex(pixel);
                giReservoirs[index].position = hit.position;
                giReservoirs[index].normal = encodeDirection(hit.geometricNormal);
                giReservoirs[index].W = 1.0 / bouncePdf;
                giReservoirs[index].M = 1.0;
                giReservoirs[index].age = GI_SEEN;
                giImageLight = radiance;
                radiance = vec3(0.0);
                throughput = vec3(1.0);
                giState = 2;
            }
        }

        // Path regularization ("blur caustics"). A caustic is light that reaches a matte surface via a shiny one,
        // like the sun reflected by the helmet onto the floor. From the floor it is only found when a random
        // bounce hits the shiny surface AND its mirror direction hits the tiny sun: very rarely, but then
        // hundreds of times brighter than the floor, so the image shows bright dots (fireflies) for a long time.
        // After a rough bounce, the exact shape of what a shiny surface reflects barely matters, so treat it as
        // at least half as rough as the roughest bounce before. The reflected light becomes a wide glow that
        // light sampling finds easily. Brightness stays the same (energy compensation); only sharp caustic
        // patterns are lost. What the camera sees directly or through mirrors is unaffected.
        if (scene.blurCaustics != 0) {
            hit.roughness = max(hit.roughness, 0.5 * pathRoughness);
        }

        // Radiance cache (see above). Update paths remember this surface; image paths that got here by a bounce
        // that spread out take the cell's indirect light, add this surface's direct light below and stop.
        if (cacheableSurface(hit)) {
            if (CACHE_UPDATE_PASS != 0) {
                if (cacheVertices < CACHE_MAX_VERTICES) {
                    uint slot, fingerprint;
                    float cellSize;
                    cacheCell(hit.position, hit.geometricNormal, slot, fingerprint, cellSize);
                    int entry = cacheFindOrInsert(slot, fingerprint);
                    if (entry >= 0) {
                        currentVertex = int(cacheVertices);
                        cacheEntries[cacheVertices] = entry;
                        // Channels that carry (almost) nothing can't tell how bright the light behind them is
                        cacheInverseThroughput[cacheVertices] = mix(vec3(0.0), 1.0 / max(throughput, vec3(1e-8)),
                                                                    greaterThan(throughput, vec3(1e-6)));
                        cacheLight[cacheVertices] = vec3(0.0);
                        cacheVertices++;
                    }
                }
            } else if (scene.cacheQuery != 0 && bounce >= 1 && previousLobeRough && !(giState == 2 && bounce == 1)) {
                // Not at a GI sample's second surface: its Lo would hold the cell's value of this frame, kept and
                // shared by the reuse for many frames and pixels. Where cells are noisy (light through openings),
                // the reuse also favours samples whose cell was momentarily bright: patches that came and went
                // (Sponza's side aisle). The path goes on and may end in the cache one surface later.
                uint slot, fingerprint;
                float cellSize;
                cacheCell(hit.position, hit.geometricNormal, slot, fingerprint, cellSize);
                int entry = hit.t >= CACHE_MIN_RAY_CELLS * cellSize ? cacheFind(slot, fingerprint) : -1;
                if (entry >= 0) {
                    vec4 cached = cacheValues[entry];
                    endInCache = cached.w >= scene.cacheMinWeight;
                    cachedLight = cached.rgb;
                }
            }
        }

        // Inside glass there is nothing to light-sample: lights are outside, behind the glass surface.
        bool leavingGlass = hit.solid && !hit.frontFace && hit.transmission > 0.0;
        // The first surface with ReSTIR DI: slot 2 takes the reservoir's sample instead of a glowing triangle,
        // the sky slot is left out, and the punctual ones if the reservoir has them (more than a few lights)
        bool restirVertex = bounce == 0 && usePrimaryHit && !isFog(hit)
                            && reservoirs[restirIndex(pixel, false)].light != RESTIR_NOT_USED;
        if (CACHE_UPDATE_PASS == 0 && bounce == 0 && usePrimaryHit && scene.restirGi != 0 && restirSurface(hit)
                && intersection.crossings == 0) {  // through portals no, in mirrors yes (see "Mirrors and ReSTIR")
            giState = 1;
        }
        if (!leavingGlass) {
            // Direct light: one shadow ray per kind of light (see LightSample). Slot 0: the sun, 1: the sky, 2: the
            // glowing triangles, 3 and up: the punctual lights, then the sun's and the punctual lights' images through
            // each portal end (portalLightImage). One loop, so the shadow ray and the BRDF exist only
            // once in the compiled shader. In world space: a shading frame would take 9 more registers across the
            // shadow rays. Shadow rays start slightly off the surface so they don't hit the surface they start on,
            // along the real triangle plane's normal (the smooth normal can point a bit into the surface).
            clampDepth = giState == 2 ? 0u : reflections + 1;  // light this surface reflects
            // (none at a scatter point in the fog: the stretches before take the lamps' light, see fogLampLight)
            uint lightSlots = (restirVertex && scene.restirPunctualCandidates > 0) || (isFog(hit) && CACHE_UPDATE_PASS == 0)
                              ? 3 : 3 + punctualLightSamples();
            uint imageSlots = CACHE_UPDATE_PASS != 0 ? 0 : portalCount() * (1 + punctualLightSamples());
            [[dont_unroll]] for (uint slot = 0; slot < lightSlots + imageSlots; slot++) {
                LightSample s = noLightSample();
                int imageEnd = -1;  // the portal end this slot's light is seen through
                if (slot == 0) {
                    // A random point on the sun's disc. Points near a shadow edge see only part of the disc, so
                    // averaged over many samples the shadow edge becomes soft (penumbra). The disc delivers
                    // PI * sunColor in total, so a white matte surface (BRDF 1 / PI) facing the sun looks exactly
                    // sunColor bright. (none when the sun is switched off: its color is then 0)
                    if (scene.sunOn != 0) {
                        s.direction = randomDirectionInCone(scene.sunDirection.xyz, scene.sunDirection.w,
                                                            pathSample(bounce, SAMPLE_SUN, seed).xy);
                        s.distance = SKY_DISTANCE;
                        s.light = PI * scene.sunColor.rgb;
                        s.pdf = scene.sunPdf;
                        s.mis = scene.sunMis != 0 ? MIS_UNLESS_GLASS : MIS_NONE;
                        s.shadowed = scene.shadowsEnabled != 0;  // "Shadows" is about the sun
                    }
                } else if (slot == 1) {
                    // A direction picked by the sky's brightness. Behind solid glass no bounce ray counts it (as for
                    // the sun); behind thin panes they do. Ending in the cache, the cache has the bounce rays' share
                    // (see the miss above), so this stays the MIS share.
                    if (scene.environmentSampling != 0 && !restirVertex) {
                        float skyPdf;
                        s.direction = sampleEnvironment(pathSample(bounce, SAMPLE_SKY, seed), skyPdf);
                        if (skyPdf > 0.0) {
                            s.distance = SKY_DISTANCE;
                            s.light = environmentLight(s.direction) / skyPdf;
                            s.pdf = skyPdf;
                            s.mis = MIS_UNLESS_SOLID;
                            s.shadowed = true;
                        }
                    }
                } else if (slot == 2) {
                    if (restirVertex) {
                        s = restirReservoirSample(pixel, hit.position);
                    } else if (sampleLights) {
                        s = sampleEmissiveLight(hit, hit.normal, hit.position,
                                                pathSample(bounce, SAMPLE_EMISSIVE, seed).xyz);
                    }
                } else if (slot < lightSlots) {
                    s = samplePunctualLight(slot - 3, hit.position, seed);
                } else {
                    uint image = slot - lightSlots;
                    imageEnd = int(image % portalCount());
                    s = portalLightImage(uint(imageEnd), image / portalCount(), hit.position, seed);
                }
                if (all(equal(s.light, vec3(0.0)))) {
                    continue;
                }

                // In front of the surface, or behind a thin one that lets light through (diffuse transmission).
                // The shading normal and the real triangle must agree on the side.
                float cosLight = dot(hit.normal, s.direction);
                float side = dot(hit.geometricNormal, s.direction);
                bool behind = cosLight < 0.0 && side < 0.0 && hit.diffuseTransmission > 0.0;
                if (!((cosLight > 0.0 && side > 0.0) || behind)) {
                    continue;
                }
                float pdfBounce;  // how likely the bounce sampling would have picked this direction
                vec3 contribution;
                if (isFog(hit)) {
                    pdfBounce = fogPhase(dot(direction, s.direction), materials[hit.meshIndex].fogForward);
                    contribution = s.light * pdfBounce;
                } else {
                    contribution = s.light * evaluateBrdfWorld(hit, hit.normal, -direction, s.direction, pdfBounce)
                                   * abs(cosLight);
                }
                if (all(equal(contribution, vec3(0.0)))) {
                    continue;  // a dark spot of an emissive texture, or a direction the surface doesn't reflect into
                }
                bool crossedGlass = false, crossedSolidGlass = false;
                vec3 transmittance = vec3(1.0);
                if (s.shadowed) {
                    vec3 shadowOrigin = shadowRayStart(hit, behind, s);
                    transmittance = shadowTransmittance(shadowOrigin, s.direction, s.distance, imageEnd, seed, media,
                                                        crossedGlass, crossedSolidGlass);
                    // The reservoir's sample is blocked: kept with W = 0, so every sample handed on to the next
                    // frame is known to be seen from its own surface (restirTemporal counts on that)
                    if (restirVertex && slot == 2 && all(equal(transmittance, vec3(0.0)))) {
                        reservoirs[restirIndex(pixel, false)].W = 0.0;
                    }
                }
                // Behind glass, bounce rays don't find the light (they are bent), so the shadow ray counts it fully.
                // Ending in the cache, no bounce ray looks for it either.
                float lightWeight = 1.0;
                if (s.mis == MIS_UNLESS_GLASS && !crossedGlass && !endInCache) {
                    lightWeight = misWeight(s.pdf, pdfBounce);
                } else if (s.mis == MIS_UNLESS_SOLID && !crossedSolidGlass) {
                    lightWeight = misWeight(s.pdf, pdfBounce);
                }
                ADD_LIGHT_EXCEPT(throughput * transmittance * contribution * lightWeight, currentVertex);
            }

            if (endInCache) {
                // all the light reflected here that came via other surfaces
                radiance += clampBounceLight(throughput * cachedLight, giState == 2 ? 0u : reflections + 2);
                break;
            }
        }

        ShadingFrame frame = makeShadingFrame(hit.normal);
        vec3 v = toLocal(frame, -direction);
        vec3 l;
        vec3 weight = vec3(1.0);
        float lobeRoughness = hit.roughness;
        bool transmitted = false;
        bool specularLobe = true;
        vec4 bounceRandom = pathSample(bounce, SAMPLE_BOUNCE, seed);  // xyz: the direction, w: Russian roulette
        if (isFog(hit)) {
            // On from the fog in a direction picked by its phase function: weight 1 (phase / pdf)
            l = toLocal(frame, sampleFogDirection(direction, materials[hit.meshIndex].fogForward, bounceRandom.xy, bouncePdf));
            lobeRoughness = 1.0;
            specularLobe = false;
        } else if (leavingGlass) {
            if (!sampleGlassExit(hit, v, bounceRandom.xyz, l)) {
                break;
            }
            transmitted = true;  // in or out, the path stays "through glass" for the light rules above
        } else if (restirVertex && scene.restirBrdfCandidates > 0 && scene.accumulate == 0 && FOG == 0) {
            // Picked and traced already: the ReSTIR pass's BRDF candidate (same sampling, its own random numbers).
            // Not when accumulating: the bounce then shares its direction with the light choice, which changes how
            // the noise averages out over frames (Sponza: the same single-frame error, but 29% more after 8 frames,
            // 13% after 64, equal after 512; no bias). Under DLSS it is as good or better, and saves a ray.
            BounceHit stored = bounceHits[primaryHitIndex(pixel)];
            if (stored.meshIndex == BOUNCE_NONE) {
                break;
            }
            sharedBounce = true;
            l = toLocal(frame, stored.direction);
            weight = vec3(unpackHalf2x16(stored.weightRG), unpackHalf2x16(stored.weightBRoughness).x);
            bouncePdf = stored.pdf;
            lobeRoughness = float((stored.weightBRoughness >> 16) & 0xFFu) / 255.0;
            transmitted = (stored.weightBRoughness & (1u << 24)) != 0u;
            specularLobe = (stored.weightBRoughness & (2u << 24)) != 0u;
        } else {
            // Indirect light: continue the path in a direction picked by the surface's reflection (mostly where
            // it reflects the most light), or through it. The throughput is multiplied by BRDF * cos / pdf.
            if (!sampleBrdf(hit, v, bounceRandom.xyz, l, weight, bouncePdf, lobeRoughness, transmitted, specularLobe)) {
                break;
            }
        }
        pathRoughness = max(pathRoughness, lobeRoughness);
        // The cone at the new ray's start: as wide as it was when it got here; a rough lobe spreads it by about
        // its width (2 * GGX alpha; the diffuse layer counts as roughness 1, so after it textures read small levels)
        coneWidth += coneSpread * hit.t;
        coneSpread += 2.0 * ggxAlpha(lobeRoughness);
        previousLobeRough = !transmitted && lobeRoughness >= CACHE_ROUGHNESS;
        if (bounce == 0 && wantGuides) {
            firstBounceSpecular = specularLobe && !guideMirror(hit);  // a mirror: storeMirrorGuides wrote it
        }
        direction = sharedBounce && bounce == 0 ? bounceHits[primaryHitIndex(pixel)].direction : toWorld(frame, l);
        // Around the smooth normal, a direction can still end up on the wrong side of the actual triangle.
        // Such a path ends: on the real surface, this light would be blocked.
        bool throughSurface = l.z < 0.0;
        float side = dot(direction, hit.geometricNormal);
        if (throughSurface ? side >= 0.0 : side <= 0.0) {
            break;
        }
        // Through the surface of a mesh with fog: into its fog or out of it (see "Fog"). Solid glass, and thin glass
        // too (a bubble of smoke: it doesn't bend the ray, but the fog is still inside)
        if (FOG != 0 && throughSurface && materials[hit.materialIndex].fogDensity > 0.0) {
            media = hit.frontFace ? enterMedium(media, hit.instanceIndex) : leaveMedium(media, hit.instanceIndex);
        }
        throughput *= weight;
        // Continue from just off the surface, on the side the new ray goes to.
        origin = offsetRay(hit.position, throughSurface ? -hit.geometricNormal : hit.geometricNormal);
        if (transmitted) {
            throughGlass = true;
            throughSolidGlass = throughSolidGlass || hit.solid;
        } else {
            throughGlass = false;
            throughSolidGlass = false;
            portalCrossings = 0;
            reflectedOnce = true;
            reflections++;
            restirReflection = restirVertex;
            reflectionPdf = bouncePdf;
            reflectionPosition = hit.position;
            reflectionNormal = hit.normal;
            reflectionTwoSided = hit.diffuseTransmission > 0.0;
        }

        // Russian roulette: after a few bounces, randomly stop paths that carry little light and
        // boost the survivors by the same factor, so on average the result stays the same.
        // A throughput above 1 (sample weights can exceed 1) always survives: dividing by a chance above 1 would
        // take light away.
        // Not after a mirror reflection: such a path is cheap and goes the same way every frame, so stopping it at
        // random would be the only noise in what the mirror shows. Between colored mirrors (a red and a green wall
        // facing each other) the throughput drops fast, and the few survivors, boosted 10x and more, made the
        // nested reflections speckled. Max bounces still ends such paths.
        bool mirrorBounce = specularLobe && lobeRoughness < MIRROR_ROUGHNESS;
        if (bounce >= 2 && !mirrorBounce) {
            float survive = min(max(throughput.r, max(throughput.g, throughput.b)), 1.0);
            if (bounceRandom.w >= survive) {
                break;
            }
            throughput /= survive;
        }
    }

    // ReSTIR GI: the sample's Lo, or no sample. Every pixel writes its fresh reservoir every frame; a GI pixel that
    // found no sample still counts one try (M = 1).
    if (CACHE_UPDATE_PASS == 0 && usePrimaryHit && scene.restirGi != 0) {
        uint index = restirGiFreshIndex(pixel);
        if (giState == 2) {
            // Optionally limited (RTXDI does): a rare very bright sample, reused, would stand out over a patch
            float brightness = luminance(radiance);
            if (scene.restirGiRadianceClamp > 0.0 && brightness > scene.restirGiRadianceClamp) {
                radiance *= scene.restirGiRadianceClamp / brightness;
            }
            giReservoirs[index].radiance = radiance;
            radiance = giImageLight;
        } else {
            giReservoirs[index].W = 0.0;
            giReservoirs[index].M = giState == 0 ? 0.0 : 1.0;
            giReservoirs[index].age = 0;
        }
    }

    // Update paths: hand each surface's light to its cache entry (averaged in cache_resolve.comp)
    if (CACHE_UPDATE_PASS != 0) {
        for (uint i = 0; i < cacheVertices; i++) {
            vec3 light = min(cacheLight[i], vec3(CACHE_MAX_RADIANCE));
            if (any(isnan(light)) || any(isinf(light))) {
                continue;
            }
            atomicAdd(cacheAccumulators[cacheEntries[i]].x, light.r);
            atomicAdd(cacheAccumulators[cacheEntries[i]].y, light.g);
            atomicAdd(cacheAccumulators[cacheEntries[i]].z, light.b);
            atomicAdd(cacheAccumulators[cacheEntries[i]].w, 1.0);
        }
    }
#undef ADD_LIGHT
#undef ADD_LIGHT_EXCEPT
    return radiance;
}

vec3 cameraRayDirection(vec2 pixelPosition, ivec2 size) {
    vec2 uv = (pixelPosition + scene.jitter) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;  // [-1, 1]; image y goes down, camera up goes up, hence the minus below
    return normalize(scene.cameraForward.xyz
                     + ndc.x * scene.tanHalfFov * scene.aspectRatio * scene.cameraRight.xyz
                     - ndc.y * scene.tanHalfFov * scene.cameraUp.xyz);
}

// A stable, distinct color per number
vec3 randomColor(uint value) {
    uint h = pcgHash(value + 1u);
    return vec3(h & 0xFFu, (h >> 8) & 0xFFu, (h >> 16) & 0xFFu) / 255.0;
}

// Shows one property of the first surface hit, to check that the mesh and material data arrive correctly.
vec3 debugColor(vec3 direction, inout uint seed) {
    Hit hit = traceClosest(scene.cameraPosition.xyz, direction, seed, 0.0, scene.pixelSpreadAngle);
    if (!hit.found) {
        return vec3(0.0);
    }
    switch (scene.debugView) {
        case 1: return hit.normal * 0.5 + 0.5;  // x -> red, y -> green, z -> blue
        case 2: return vec3(fract(hit.uv), 0.0);
        case 3: return randomColor(hit.meshIndex);
        case 4: return randomColor(hit.materialIndex);
        // linear values, shown without exposure or tone mapping; the blit to the sRGB swapchain makes them look right
        case 5: return hit.albedo;
        case 6: return vec3(hit.metallic);
        case 7: return vec3(hit.roughness);
        case 8: return vec3(hit.transmission);
        case 9: return hit.emissive;
        case 10: return hit.tangent * 0.5 + 0.5;
        case 11: {
            // The cached (indirect) light where the camera looks (cells of surfaces that can't be cached are black)
            if (!cacheableSurface(hit)) {
                return vec3(0.0);
            }
            uint slot, fingerprint;
            float cellSize;
            cacheCell(hit.position, hit.geometricNormal, slot, fingerprint, cellSize);
            int entry = cacheFind(slot, fingerprint);
            if (entry < 0) {
                return vec3(1.0, 0.0, 1.0);
            }
            vec4 cached = cacheValues[entry];
            return cached.w >= scene.cacheMinWeight ? cached.rgb : vec3(0.3, 0.0, 0.0);
        }
    }
    return vec3(1.0, 0.0, 1.0);
}

// Radiance cache update pass: one full-length path from a random pixel of each tile; only the cache gets written.
void updateCache() {
    ivec2 size = imageSize(radianceImage);
    uint tile = scene.cacheUpdateTile;
    uint seed = pcgHash(gl_GlobalInvocationID.x + pcgHash(gl_GlobalInvocationID.y + pcgHash(scene.frameIndex ^ 0x5bd1e995u)));
    vec2 position = vec2(gl_GlobalInvocationID.xy * tile) + vec2(randomFloat(seed), randomFloat(seed)) * float(tile);
    if (position.x >= float(size.x) || position.y >= float(size.y)) {
        return;
    }
    tracePath(scene.cameraPosition.xyz, cameraRayDirection(position, size), seed, false, false);
}

// The start of a pixel's random numbers in this frame
uint pixelSeed(ivec2 pixel) {
    return pcgHash(uint(pixel.x) + pcgHash(uint(pixel.y) + pcgHash(scene.frameIndex)));
}

// Spread samples randomly over the pixel (anti-aliasing). A single sample without accumulation
// goes through the pixel center, otherwise edges would flicker from frame to frame.
vec3 sampleCameraRay(ivec2 pixel, ivec2 size, inout uint seed) {
    bool randomOffset = scene.samplesPerPixel > 1 || scene.accumulate != 0;
    vec2 offset = randomOffset ? pathSample(0u, SAMPLE_CAMERA, seed).xy - 0.5 : vec2(0.0);
    return cameraRayDirection(vec2(pixel) + 0.5 + offset, size);
}

// Whether a reservoir's sample is seen from a surface (a shadow ray; through glass counts as seen)
bool restirVisible(Reservoir r, Hit hit, inout uint seed) {
    float toSolidAngle;
    LightSample s = restirLightSample(r.light, r.point, hit.position, toSolidAngle);
    bool behind = dot(hit.geometricNormal, s.direction) < 0.0;
    vec3 shadowOrigin = shadowRayStart(hit, behind, s);
    bool crossedGlass, crossedSolidGlass;
    vec3 transmittance = shadowTransmittance(shadowOrigin, s.direction, s.distance, -1, seed, OUTSIDE, crossedGlass,
                                             crossedSolidGlass);
    return any(greaterThan(transmittance, vec3(0.0)));
}

// The same surface point in last frame's image (ReSTIR DI's and GI's temporal reuse): where it was (the object's
// motion, last frame's camera), and a stored surface there that matches. gi: look for a GI reservoir instead of a DI
// one. False if there is none.
bool restirFindPrevious(Hit hit, vec4 previousPosition, bool gi, bool shuffle, inout uint seed, out uint previousIndex,
                        out Hit previousHit, out vec3 previousV) {
    previousIndex = 0;
    previousV = vec3(0.0, 0.0, 1.0);
    if ((scene.previousViewProjection * previousPosition).w <= 0.0) {
        return false;  // behind last frame's camera
    }
    ivec2 reprojected = ivec2(floor(projectToPixel(scene.previousViewProjection, previousPosition)));
    // Last frame's view depth of this point (clip w), to compare with the stored surfaces'
    float expectedDepth = (scene.previousViewProjection * previousPosition).w;
    ivec2 size = imageSize(radianceImage);

    // A matching surface of last frame: the reprojected pixel, or if that one doesn't match (something else was
    // there, or a different part of a bumpy surface), one of up to 8 random pixels within 2 of it (as RTXDI).
    // Matching: shading normals within 60 degrees, view depths within 10%, as RTXDI. A stricter test rejects
    // history in a scattered pattern on normal-mapped surfaces, and pixels with long and short histories next to
    // each other look patchy.
    for (int attempt = 0; attempt < 9; attempt++) {
        ivec2 candidate = reprojected;
        if (attempt == 0) {
            // Permutation sampling (as RTXDI): every frame the whole image takes its history from pixels shuffled
            // within 4 x 4 blocks (shift by this frame's offset, mirror within the block, shift back), so every
            // reservoir is still used once. Without it a pixel keeps its sample for many frames, and so its error,
            // moving with the surface: a denoiser takes error that doesn't change for detail. DLSS painted it
            // into the image (smudges like brush strokes, trails behind moving edges).
            if (shuffle) {
                ivec2 offset = ivec2(scene.restirPermutation & 3u, (scene.restirPermutation >> 2) & 3u);
                candidate = ((candidate + offset) ^ ivec2(3)) - offset;
            }
        } else {
            candidate += ivec2(round((vec2(randomFloat(seed), randomFloat(seed)) - 0.5) * 4.0));
        }
        if (any(lessThan(candidate, ivec2(0))) || any(greaterThanEqual(candidate, size))) {
            continue;  // off last frame's image
        }
        uint index = restirIndex(candidate, true);
        if (gi ? giReservoirs[index].M == 0.0 : reservoirs[index].light == RESTIR_NOT_USED) {
            continue;
        }
        RestirSurface stored = restirSurfaces[index];
        Hit surface = unpackRestirSurface(stored);
        float depth = (scene.previousViewProjection * vec4(stored.seenAt, 1.0)).w;
        if (dot(surface.normal, hit.normal) >= 0.5 && abs(depth - expectedDepth) <= 0.1 * max(depth, expectedDepth)) {
            previousIndex = index;
            previousHit = surface;
            previousV = restirSurfaceView(stored);  // last frame's view
            return true;
        }
    }
    return false;
}

// Last frame's reservoir of the same surface point (where it was on last frame's image), merged into r, which holds
// this frame's candidates. Both reservoirs' samples are resampled for this surface with the generalized balance
// heuristic: a sample's MIS weight is its reservoir's M times its target there, over the sum of that over both
// surfaces (Lin et al. 2022). Last frame's surface comes from its stored copy, and its view direction from last
// frame's camera. Targets ignore what blocks the light. That's a bias: a sample this frame's surface sees but last
// frame's doesn't (last frame's ray hit elsewhere in the pixel, close to a shadow's edge) gets a share of its MIS
// weight for last frame's surface, which could never have produced it: too dark near shadow edges (Sponza with the
// sky: 3.7%, taking history from up to 3 pixels away). With restirTemporal = 2 (the default), both targets at last
// frame's surface include whether it sees the sample. This frame's sample needs a shadow ray from there. Last
// frame's own sample doesn't: it may come from older frames, but the image pass tested it from that surface and
// set W = 0 if blocked (without that test the merge came out too bright: Sponza +2.6%). Then the weights add up to
// 1 for every sample either surface can produce: no bias.
Reservoir restirTemporal(Reservoir r, Hit hit, vec3 v, vec4 previousPoint, inout uint seed) {
    if (scene.restirTemporal == 0 || scene.restirHistoryValid == 0) {
        return r;
    }
    uint previousIndex;
    Hit previousHit;
    vec3 previousV;
    if (!restirFindPrevious(hit, previousPoint, false, (scene.restirPermutation & 16u) != 0u, seed, previousIndex,
                            previousHit, previousV)) {
        return r;
    }
    Reservoir previous = reservoirs[previousIndex];
    float previousM = min(previous.M, scene.restirMaxHistory * r.M);

    // Targets of both samples at both surfaces
    float currentHere = restirTargetOf(r, hit, v);
    float currentThere = restirTargetOf(r, previousHit, previousV);
    if (scene.restirTemporal == 2 && currentThere > 0.0 && r.W > 0.0 && !restirVisible(r, previousHit, seed)) {
        currentThere = 0.0;
    }
    float previousHere = restirTargetOf(previous, hit, v);
    // Last frame's own sample needs no ray: the image pass tested it from that surface and set W = 0 if blocked
    float previousThere = previous.W > 0.0 ? restirTargetOf(previous, previousHit, previousV) : 0.0;
    float currentSum = r.M * currentHere + previousM * currentThere;
    float previousSum = r.M * previousHere + previousM * previousThere;
    float currentWeight = currentSum > 0.0 ? r.M * currentHere / currentSum * currentHere * r.W : 0.0;
    float previousWeight = previousSum > 0.0 ? previousM * previousThere / previousSum * previousHere * previous.W : 0.0;

    float weightSum = currentWeight + previousWeight;
    float keptTarget = currentHere;
    if (randomFloat(seed) * weightSum < previousWeight) {
        r.light = previous.light;
        r.point = previous.point;
        keptTarget = previousHere;
    }
    r.M += previousM;
    r.W = keptTarget > 0.0 ? weightSum / keptTarget : 0.0;
    return r;
}

// RESTIR_PASS: the first camera ray of each pixel, with the same random numbers the image pass will use, then
// (ReSTIR DI) the candidates of its first surface. Runs for ReSTIR DI or GI; with GI only, the reservoirs say
// "not used" and the image pass samples the lights as usual.
void restirPass(ivec2 pixel, ivec2 size) {
    uint seed = pixelSeed(pixel);
    startPathSamples(pixel, 0u);
    vec3 cameraDirection = sampleCameraRay(pixel, size, seed);
    vec3 direction = cameraDirection;
    Intersection intersection;
    Hit hit;
    vec3 tint;
    float travelled;
    bool throughPortal;
    bool found = traceCameraRay(pixel, direction, seed, intersection, hit, tint, travelled, throughPortal);
    storePrimaryHit(pixel, found, intersection, seed, throughPortal, travelled, direction, tint);
    found = found && !throughPortal;  // seen through a portal: no ReSTIR (see PRIMARY_THROUGH_PORTAL)

    Reservoir reservoir;
    reservoir.light = RESTIR_NOT_USED;
    reservoir.point = 0;
    reservoir.W = 0.0;
    reservoir.M = 0.0;
    if (found) {
        // The same surface the image pass will see (see tracePath's first bounce). Where the camera sees it, and
        // where that was last frame (as restirPreviousPoint).
        vec3 seenAt = travelled > 0.0 ? scene.cameraPosition.xyz + cameraDirection * (travelled + hit.t) : hit.position;
        vec4 previousPoint = travelled > 0.0 ? vec4(seenAt, 1.0)
                                             : instances[hit.instanceIndex].motion * vec4(hit.position, 1.0);
        if (restirSurface(hit) && scene.restirDi != 0) {
            // Random numbers of their own: the image pass goes on with the pixel's (its bounce directions must
            // not depend on which light was picked)
            uint candidateSeed = pcgHash(seed ^ 0x9e3779b9u);
            reservoir = restirCandidates(hit, -direction, candidateSeed);
            // Visibility reuse: a blocked sample gets W = 0, so it isn't passed on to the next frame (or neighbors).
            // Before the merge, not after: tested only after it, a blocked fresh candidate could win over a visible
            // history sample, and that history would be lost (part C3: 1.7-3.7x the single-frame error)
            if (reservoir.W > 0.0) {
                vec3 surfacePoint = hit.position;
                float toSolidAngle;
                LightSample s = restirLightSample(reservoir.light, reservoir.point, surfacePoint, toSolidAngle);
                bool behind = dot(hit.geometricNormal, s.direction) < 0.0;
                vec3 shadowOrigin = shadowRayStart(hit, behind, s);
                bool crossedGlass, crossedSolidGlass;
                vec3 transmittance = shadowTransmittance(shadowOrigin, s.direction, s.distance, -1, candidateSeed, OUTSIDE,
                                                         crossedGlass, crossedSolidGlass);
                if (all(equal(transmittance, vec3(0.0)))) {
                    reservoir.W = 0.0;
                }
            }
            reservoir = restirTemporal(reservoir, hit, -direction, previousPoint, candidateSeed);
        }
        if (restirSurface(hit)) {
            restirSurfaces[restirIndex(pixel, false)] = packRestirSurface(hit, seenAt, -direction);
        }
    }
    reservoirs[restirSpatialOn() ? restirTemporalIndex(pixel) : restirIndex(pixel, false)] = reservoir;
}

// The number of candidates a reservoir starts with (its M before any reuse)
float restirFreshCount() {
    return float(scene.restirTriangleCandidates + scene.restirPunctualCandidates + scene.restirSkyCandidates
                 + scene.restirBrdfCandidates);
}

// A neighbor of the spatial pass: the n-th point of the R2 sequence (Roberts 2018) in a disc of the radius,
// shifted by the pixel's random start (per pixel and frame). Evenly spread, few duplicates; (0, 0) for none.
ivec2 restirNeighborOffset(uint n, vec2 start, float radius) {
    vec2 u = fract(start + float(n + 1) * vec2(0.7548776662, 0.5698402910));
    float angle = 2.0 * PI * u.y;
    return ivec2(round(radius * sqrt(u.x) * vec2(cos(angle), sin(angle))));
}

// The canonical sample's MIS weight (see restirSpatial) with visibility: a neighbor whose surface doesn't see the
// sample could never have produced it (its own sample was dropped if blocked), so its comparison goes wholly to the
// canonical reservoir. One shadow ray per neighbor whose target there isn't 0.
float restirSpatialCanonicalMis(Reservoir canonical, RestirLightPoint canonicalPoint, float canonicalHere,
                                float canonicalM, float mSum, ivec2 pixel, vec2 start, uint used, uint wanted,
                                inout uint seed) {
    float mis = 0.0;
    for (uint n = 0; n < wanted; n++) {
        if ((used & (1u << n)) == 0u) {
            continue;
        }
        ivec2 neighbor = pixel + restirNeighborOffset(n, start, scene.restirSpatialRadius);
        float M = reservoirs[restirTemporalIndex(neighbor)].M;
        RestirSurface stored = restirSurfaces[restirIndex(neighbor, false)];
        Hit surface = unpackRestirSurface(stored);
        float canonicalThere = restirTargetAt(canonicalPoint, surface, restirSurfaceView(stored));
        if (canonicalThere > 0.0 && !restirVisible(canonical, surface, seed)) {
            canonicalThere = 0.0;
        }
        mis += (M + canonicalM) / mSum * canonicalM * canonicalHere / (M * canonicalThere + canonicalM * canonicalHere);
    }
    return mis;
}

// RESTIR_PASS = 2: spatial reuse. The pixel's reservoir (after the temporal merge) and those of a few pixels nearby,
// resampled for this pixel's surface. A neighbor is used if its surface is like this one: as in restirTemporal
// (shading normals within 60 degrees, view depths within 10%), plus roughness within 0.25 (a glossy and a rough
// surface want different lights). A rejected one isn't replaced: the cost stays fixed. Pixels that found no history
// (just uncovered) take more neighbors (restirDisocclusionNeighbors).
//
// MIS: pairwise (Bitterli 2022; Lin et al. 2022). Instead of comparing every reservoir with every other one (the
// generalized balance heuristic of restirTemporal: (k + 1)^2 targets), each of the k neighbors is compared only with
// the pixel's own ("canonical") reservoir c. With p_j the target at reservoir j's surface and M_j its count:
//     neighbor i's sample x:  m_i(x) = s_i * M_i p_i(x) / (M_i p_i(x) + M_c/k p_c(x))
//     the canonical sample:   m_c(x) = sum over i of s_i * M_c/k p_c(x) / (M_i p_i(x) + M_c/k p_c(x))
// with s_i = (M_i + M_c/k) / (M_c + the sum of the M_i). They add up to 1 for every x, and with equal targets each
// reservoir's weight is its share of the M, as with the balance heuristic. 3k + 1 targets (of k + 1 samples, each
// looked up once: restirLightPoint). All surfaces are this
// frame's, seen by this frame's camera.
//
// Targets ignore what blocks the light. That's a bias near shadows: a neighbor that can't see the canonical sample
// still takes a share of its MIS weight, as if it could have produced it (Sponza with the sky: 1.6% too dark with
// neighbors within 3 pixels, 4.7% within 10, 9.7% within 30). With restirSpatialVisibility the kept sample's MIS
// weight includes visibility, and W is scaled by its weight with visibility / without. Picking with the weights
// without visibility is fine: the result's expected value is the sum over the reservoirs of (weight with
// visibility) * (light) / (target), whichever way they are picked, as long as no weight with visibility is > 0 where
// the one without is 0. The weights with visibility: each target times whether its surface sees the sample. A kept
// neighbor sample needs no ray from here (if this surface doesn't see it, the image pass's shadow ray finds no light
// whatever its weight), but one from the neighbor's surface: a sample from that pixel's history was tested from last
// frame's surface, not this one (assuming it seen made Sponza 1.9% too bright). The kept canonical sample needs a ray
// from each neighbor (restirSpatialCanonicalMis).
void restirSpatial(ivec2 pixel, ivec2 size) {
    uint ownIndex = restirIndex(pixel, false);
    Reservoir canonical = reservoirs[restirTemporalIndex(pixel)];
    if (canonical.light == RESTIR_NOT_USED) {
        reservoirs[ownIndex] = canonical;
        return;
    }
    RestirSurface own = restirSurfaces[ownIndex];
    Hit hit = unpackRestirSurface(own);
    vec3 v = restirSurfaceView(own);
    float depth = restirSurfaceDepth(own);
    uint seed = pcgHash(pixelSeed(pixel) ^ 0x2545f491u);
    vec2 start = vec2(randomFloat(seed), randomFloat(seed));
    bool disoccluded = canonical.M <= restirFreshCount() + 0.5;
    uint wanted = min(disoccluded ? max(scene.restirDisocclusionNeighbors, scene.restirSpatialNeighbors)
                                  : scene.restirSpatialNeighbors, 16u);

    // First which neighbors are used, and their M: the weights need k and the sum of the M
    uint used = 0;
    float k = 0.0;
    float mSum = canonical.M;
    for (uint n = 0; n < wanted; n++) {
        ivec2 neighbor = pixel + restirNeighborOffset(n, start, scene.restirSpatialRadius);
        if (neighbor == pixel || any(lessThan(neighbor, ivec2(0))) || any(greaterThanEqual(neighbor, size))) {
            continue;
        }
        Reservoir r = reservoirs[restirTemporalIndex(neighbor)];
        if (r.light == RESTIR_NOT_USED) {
            continue;
        }
        RestirSurface stored = restirSurfaces[restirIndex(neighbor, false)];
        Hit surface = unpackRestirSurface(stored);
        float neighborDepth = restirSurfaceDepth(stored);
        if (dot(surface.normal, hit.normal) >= 0.5 && abs(neighborDepth - depth) <= 0.1 * max(neighborDepth, depth)
                && abs(surface.roughness - hit.roughness) <= 0.25) {
            used |= 1u << n;
            k += 1.0;
            mSum += r.M;
        }
    }
    if (k == 0.0) {
        reservoirs[ownIndex] = canonical;
        return;
    }

    float canonicalM = canonical.M / k;  // the canonical reservoir's count in each comparison
    RestirLightPoint canonicalPoint = restirLightPoint(canonical);
    float canonicalHere = canonical.W > 0.0 ? restirTargetAt(canonicalPoint, hit, v) : 0.0;
    float canonicalMis = 0.0;
    float weightSum = 0.0;
    Reservoir result = canonical;
    float keptTarget = canonicalHere;
    uint keptNeighbor = 0xFFFFFFFFu;
    for (uint n = 0; n < wanted; n++) {
        if ((used & (1u << n)) == 0u) {
            continue;
        }
        ivec2 neighbor = pixel + restirNeighborOffset(n, start, scene.restirSpatialRadius);
        Reservoir r = reservoirs[restirTemporalIndex(neighbor)];
        RestirSurface stored = restirSurfaces[restirIndex(neighbor, false)];
        Hit surface = unpackRestirSurface(stored);
        vec3 neighborV = restirSurfaceView(stored);
        float share = (r.M + canonicalM) / mSum;
        // The canonical sample's weight for this comparison
        if (canonicalHere > 0.0) {
            float canonicalThere = restirTargetAt(canonicalPoint, surface, neighborV);
            canonicalMis += share * canonicalM * canonicalHere / (r.M * canonicalThere + canonicalM * canonicalHere);
        }
        // The neighbor's sample
        if (r.W > 0.0) {
            RestirLightPoint point = restirLightPoint(r);
            float here = restirTargetAt(point, hit, v);
            if (here > 0.0) {
                float there = restirTargetAt(point, surface, neighborV);
                float denominator = r.M * there + canonicalM * here;
                float weight = denominator > 0.0 ? share * r.M * there / denominator * here * r.W : 0.0;
                weightSum += weight;
                if (randomFloat(seed) * weightSum < weight) {
                    result.light = r.light;
                    result.point = r.point;
                    keptTarget = here;
                    keptNeighbor = n;
                }
            }
        }
    }
    float canonicalWeight = canonicalMis * canonicalHere * canonical.W;
    weightSum += canonicalWeight;
    float correction = 1.0;  // the kept sample's MIS weight with visibility / without
    if (randomFloat(seed) * weightSum < canonicalWeight) {
        result.light = canonical.light;
        result.point = canonical.point;
        keptTarget = canonicalHere;
        if (scene.restirSpatialVisibility != 0) {
            correction = restirSpatialCanonicalMis(canonical, canonicalPoint, canonicalHere, canonicalM, mSum, pixel,
                                                   start, used, wanted, seed) / canonicalMis;
        }
    } else if (scene.restirSpatialVisibility != 0 && keptNeighbor != 0xFFFFFFFFu) {
        // A kept neighbor sample: its own surface may not see it. Then that reservoir's weight for it is 0.
        ivec2 neighbor = pixel + restirNeighborOffset(keptNeighbor, start, scene.restirSpatialRadius);
        if (!restirVisible(result, unpackRestirSurface(restirSurfaces[restirIndex(neighbor, false)]), seed)) {
            correction = 0.0;
        }
    }
    result.W = keptTarget > 0.0 && weightSum > 0.0 ? weightSum * correction / keptTarget : 0.0;
    result.M = mSum;
    reservoirs[ownIndex] = result;
}

// How large x2 looks from x1, per unit of its area: cos at x2 / distance^2 (0 if x1 is behind x2)
float restirGiGeometry(vec3 x1, GiReservoir r) {
    vec3 toFirst = x1 - r.position;
    float distanceSquared = dot(toFirst, toFirst);
    return max(dot(decodeDirection(r.normal), toFirst), 0.0) * inversesqrt(distanceSquared) / distanceSquared;
}

// The target of a GI sample at a first surface seen from direction v: luminance(BRDF * cos * Lo), with the light
// loop's rules (restirTarget). 0 if the surface would see x2 from behind.
float restirGiTarget(Hit hit, vec3 v, GiReservoir r) {
    vec3 toSample = r.position - hit.position;
    LightSample s = noLightSample();
    s.direction = normalize(toSample);
    if (dot(decodeDirection(r.normal), s.direction) >= 0.0) {
        return 0.0;
    }
    s.light = r.radiance;
    float brdfPdf;
    return restirTarget(hit, v, s, brdfPdf);
}

// Last frame's GI reservoir of the same surface point merged into r, this frame's fresh sample, as ReSTIR DI's
// (restirTemporal): generalized balance heuristic, each target taken at the other surface and converted to this
// surface's measure with the Jacobian (see "ReSTIR GI"). Without visibility in the targets (RTXDI's default,
// "basic"), a fresh sample last frame's surface can't see still gives it a share of its MIS weight: light lost
// where the two see different things. Last frame's surface is the same point but up to 3 pixels away (shuffle,
// fallback search), so near edges and far away they often do: Sponza's side aisle, lit through gaps, came out 6%
// too dark (whole image, Accumulation). With restirGiTemporalVisibility, as DI's: a ray from last frame's surface
// to the fresh sample. Last frame's own sample needs none: shading dropped it (W = 0) if its surface didn't see it.
bool restirGiVisible(Hit hit, vec3 x2, uint x2Normal, inout uint seed);
GiReservoir restirGiTemporal(GiReservoir r, ivec2 pixel) {
    RestirSurface own = restirSurfaces[restirIndex(pixel, false)];
    Hit hit = unpackRestirSurface(own);
    uint seed = pcgHash(pixelSeed(pixel) ^ 0x68e31da4u);
    uint previousIndex;
    Hit previousHit;
    vec3 previousV;
    if (!restirFindPrevious(hit, restirPreviousPoint(own, primaryHits[primaryHitIndex(pixel)].instanceIndex), true,
                            scene.restirGiPermutation != 0, seed, previousIndex, previousHit, previousV)) {
        return r;
    }
    GiReservoir previous = giReservoirs[previousIndex];
    if ((previous.age & 0xFFFFu) >= scene.restirGiMaxAge) {
        return r;  // held long enough (its Lo may be out of date too)
    }
    vec3 v = restirSurfaceView(own);
    float previousM = min(previous.M, scene.restirGiMaxHistory * r.M);

    // Targets of both samples at both surfaces, per solid angle at this one
    float currentHere = 0.0, currentThere = 0.0;
    if (r.W > 0.0) {
        currentHere = restirGiTarget(hit, v, r);
        float geometry = restirGiGeometry(hit.position, r);
        currentThere = geometry > 0.0
                       ? restirGiTarget(previousHit, previousV, r) * restirGiGeometry(previousHit.position, r) / geometry
                       : 0.0;
        if (scene.restirGiTemporalVisibility != 0 && currentThere > 0.0
                && !restirGiVisible(previousHit, r.position, r.normal, seed)) {
            currentThere = 0.0;
        }
    }
    float previousHere = 0.0, previousThere = 0.0, jacobian = 1.0;
    if (previous.W > 0.0) {
        float geometry = restirGiGeometry(previousHit.position, previous);
        jacobian = geometry > 0.0 ? restirGiGeometry(hit.position, previous) / geometry : 0.0;
        if (jacobian >= 0.1 && jacobian <= 10.0) {
            previousHere = restirGiTarget(hit, v, previous);
            previousThere = restirGiTarget(previousHit, previousV, previous) / jacobian;
        }
    }
    float currentSum = r.M * currentHere + previousM * currentThere;
    float previousSum = r.M * previousHere + previousM * previousThere;
    float currentWeight = currentSum > 0.0 ? r.M * currentHere / currentSum * currentHere * r.W : 0.0;
    float previousWeight = previousSum > 0.0 ? previousM * previousThere / previousSum * previousHere * previous.W
                                               * clamp(jacobian, 1.0 / 3.0, 3.0) : 0.0;

    float weightSum = currentWeight + previousWeight;
    float keptTarget = currentHere;
    if (randomFloat(seed) * weightSum < previousWeight) {
        r.position = previous.position;
        r.normal = previous.normal;
        r.radiance = previous.radiance;
        r.age = (previous.age & 0xFFFFu) + 1u;
        keptTarget = previousHere;
    }
    r.M += previousM;
    r.W = keptTarget > 0.0 ? weightSum / keptTarget : 0.0;
    return r;
}

// Whether ReSTIR GI's spatial pass runs
bool restirGiSpatialOn() {
    return scene.restirGiSpatialNeighbors + scene.restirGiDisocclusionNeighbors > 0;
}

shared float giBoilingWeights[64];  // one per thread of the 8 x 8 group (restirGiTemporalPass)

// RESTIR_PASS = 4: ReSTIR GI's temporal reuse, from the image pass's fresh samples to this frame's reservoirs (or,
// for the spatial pass, back in place of the fresh ones: each pixel only reads its own). inside: the thread has a
// pixel (the group's other threads still take part in the boiling filter).
//
// Boiling filter (RTXDI's): a reservoir whose sample brings far more light (target * W) than the average of the
// group's (8 x 8 pixels, those with light) is emptied. Without it, one lucky bright sample spreads over its
// neighbors and is passed on for many frames: a blotch that grows and then vanishes ("boiling"). Dropped when it
// brings more than 10 / strength - 9 times the average (strength 0.2: 41 x). Takes light away: little where light
// is spread evenly (0.1-0.2%), a lot where it all comes as rare bright samples (Sponza's side aisle, lit through
// gaps: 9%, and the dropping made it flicker). Off by default.
void restirGiTemporalPass(ivec2 pixel, bool inside) {
    uint freshIndex = restirGiFreshIndex(pixel);
    GiReservoir r;
    r.W = 0.0;
    r.M = 0.0;
    if (inside) {
        r = giReservoirs[freshIndex];
        if (r.M > 0.0 && scene.restirGiTemporal != 0 && scene.restirGiHistoryValid != 0) {
            r = restirGiTemporal(r, pixel);
        }
    }
    if (scene.restirGiBoilingFilter > 0.0) {
        float weight = 0.0;
        if (r.W > 0.0) {
            RestirSurface own = restirSurfaces[restirIndex(pixel, false)];
            weight = restirGiTarget(unpackRestirSurface(own), restirSurfaceView(own), r) * r.W;
        }
        giBoilingWeights[gl_LocalInvocationIndex] = weight;
        barrier();
        float sum = 0.0;
        float count = 0.0;
        for (uint i = 0; i < 64u; i++) {
            float w = giBoilingWeights[i];
            sum += w;
            count += w > 0.0 ? 1.0 : 0.0;
        }
        if (weight > sum / max(count, 1.0) * (10.0 / clamp(scene.restirGiBoilingFilter, 1e-6, 1.0) - 9.0)) {
            r.W = 0.0;
        }
    }
    if (inside) {
        giReservoirs[restirGiSpatialOn() ? freshIndex : restirIndex(pixel, false)] = r;
    }
}

// Whether a first surface sees a GI sample's x2 (geometric normal x2Normal, octahedral). Glass blocks it: a bounce
// ray that hits glass gives no sample (the path goes on through it and counts that light itself), so x2 behind glass
// is not one this surface could have.
bool restirGiVisible(Hit hit, vec3 x2, uint x2Normal, inout uint seed) {
    float side = dot(x2 - hit.position, hit.geometricNormal);
    vec3 origin = offsetRay(hit.position, side < 0.0 ? -hit.geometricNormal : hit.geometricNormal);
    vec3 toSample = x2 - origin;
    float distance = length(toSample);
    vec3 direction = toSample / distance;
    vec3 n2 = decodeDirection(x2Normal);
    float stop = distance - stopShortOf(x2, n2, dot(n2, direction));
    if (stop <= 0.0) {
        return true;  // closer than the rounding error: nothing fits in between
    }
    if (portalBetween(origin, direction, stop)) {
        return false;
    }
    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, tlas, gl_RayFlagsTerminateOnFirstHitEXT | PATH_RAY_FLAGS, 0xFF, origin, 0.0, direction, stop);
    traverse(rayQuery, seed, false, uvec4(~0u));
    return rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionNoneEXT;
}

// A neighbor's surface for the GI spatial pass: as DI's test (normals within 60 degrees, view depths within 10%,
// roughness within 0.25), and as RTXDI's, diffuse albedos (luminance) within 0.25: the target weighs a sample by
// the surface's BRDF, so a dark and a bright surface prefer different ones.
bool restirGiSimilar(Hit hit, float depth, RestirSurface stored) {
    Hit surface = unpackRestirSurface(stored);
    float surfaceDepth = restirSurfaceDepth(stored);
    return dot(surface.normal, hit.normal) >= 0.5 && abs(surfaceDepth - depth) <= 0.1 * max(surfaceDepth, depth)
           && abs(surface.roughness - hit.roughness) <= 0.25
           && abs(luminance(surface.albedo) - luminance(hit.albedo)) <= 0.25;
}

// A GI sample's area-measure target at a surface: target * G. Pairwise MIS compares these: x2 is the same point
// whichever surface it is seen from, so per unit of x2's area all surfaces' targets are in the same measure.
float restirGiAreaTarget(Hit hit, vec3 v, GiReservoir r) {
    float geometry = restirGiGeometry(hit.position, r);
    return geometry > 0.0 ? restirGiTarget(hit, v, r) * geometry : 0.0;
}

// The canonical sample's MIS weight (see restirGiSpatial) with visibility: a neighbor whose surface doesn't see x2
// could never have produced it. A ray from each neighbor whose target isn't 0.
float restirGiSpatialCanonicalMis(GiReservoir canonical, float canonicalArea, float canonicalM, float mSum,
                                  ivec2 pixel, vec2 start, uint used, uint wanted, inout uint seed) {
    float mis = 0.0;
    for (uint n = 0; n < wanted; n++) {
        if ((used & (1u << n)) == 0u) {
            continue;
        }
        ivec2 neighbor = pixel + restirNeighborOffset(n, start, scene.restirGiSpatialRadius);
        float M = giReservoirs[restirGiFreshIndex(neighbor)].M;
        RestirSurface stored = restirSurfaces[restirIndex(neighbor, false)];
        Hit surface = unpackRestirSurface(stored);
        float there = restirGiAreaTarget(surface, restirSurfaceView(stored), canonical);
        if (there > 0.0 && !restirGiVisible(surface, canonical.position, canonical.normal, seed)) {
            there = 0.0;
        }
        mis += (M + canonicalM) / mSum * canonicalM * canonicalArea / (M * there + canonicalM * canonicalArea);
    }
    return mis;
}

// RESTIR_PASS = 5: ReSTIR GI's spatial reuse, as ReSTIR DI's (restirSpatial: pairwise MIS, the same neighbor
// pattern, more neighbors for pixels without history), with the targets compared per unit of x2's area
// (restirGiAreaTarget) and a neighbor's sample moved to this surface with its Jacobian (skipped outside 1/10..10,
// clamped to 1/3..3, as in restirGiTemporal). Targets ignore visibility (RTXDI's "basic"); the kept sample gets a
// visibility ray when shaded. With restirGiSpatialVisibility, as DI's: the kept sample's MIS weight with
// visibility / without (rays from the neighbors' surfaces).
void restirGiSpatial(ivec2 pixel, ivec2 size) {
    uint ownIndex = restirIndex(pixel, false);
    GiReservoir canonical = giReservoirs[restirGiFreshIndex(pixel)];
    if (canonical.M == 0.0) {
        giReservoirs[ownIndex] = canonical;
        return;
    }
    RestirSurface own = restirSurfaces[ownIndex];
    Hit hit = unpackRestirSurface(own);
    vec3 v = restirSurfaceView(own);
    float depth = restirSurfaceDepth(own);
    uint seed = pcgHash(pixelSeed(pixel) ^ 0x3c6ef372u);
    vec2 start = vec2(randomFloat(seed), randomFloat(seed));
    bool disoccluded = canonical.M <= 1.5;
    uint wanted = min(disoccluded ? max(scene.restirGiDisocclusionNeighbors, scene.restirGiSpatialNeighbors)
                                  : scene.restirGiSpatialNeighbors, 16u);

    // First which neighbors are used, and their M
    uint used = 0;
    float k = 0.0;
    float mSum = canonical.M;
    for (uint n = 0; n < wanted; n++) {
        ivec2 neighbor = pixel + restirNeighborOffset(n, start, scene.restirGiSpatialRadius);
        if (neighbor == pixel || any(lessThan(neighbor, ivec2(0))) || any(greaterThanEqual(neighbor, size))) {
            continue;
        }
        float M = giReservoirs[restirGiFreshIndex(neighbor)].M;
        if (M == 0.0) {
            continue;
        }
        if (restirGiSimilar(hit, depth, restirSurfaces[restirIndex(neighbor, false)])) {
            used |= 1u << n;
            k += 1.0;
            mSum += M;
        }
    }
    if (k == 0.0) {
        giReservoirs[ownIndex] = canonical;
        return;
    }

    float canonicalM = canonical.M / k;
    float canonicalHere = canonical.W > 0.0 ? restirGiTarget(hit, v, canonical) : 0.0;
    float canonicalArea = canonicalHere * restirGiGeometry(hit.position, canonical);
    float canonicalMis = 0.0;
    float weightSum = 0.0;
    GiReservoir result = canonical;
    float keptTarget = canonicalHere;
    uint keptNeighbor = 0xFFFFFFFFu;
    for (uint n = 0; n < wanted; n++) {
        if ((used & (1u << n)) == 0u) {
            continue;
        }
        ivec2 neighbor = pixel + restirNeighborOffset(n, start, scene.restirGiSpatialRadius);
        GiReservoir r = giReservoirs[restirGiFreshIndex(neighbor)];
        RestirSurface stored = restirSurfaces[restirIndex(neighbor, false)];
        Hit surface = unpackRestirSurface(stored);
        vec3 neighborV = restirSurfaceView(stored);
        float share = (r.M + canonicalM) / mSum;
        if (canonicalArea > 0.0) {
            float canonicalThere = restirGiAreaTarget(surface, neighborV, canonical);
            canonicalMis += share * canonicalM * canonicalArea / (r.M * canonicalThere + canonicalM * canonicalArea);
        }
        if (r.W > 0.0) {
            float geometryThere = restirGiGeometry(surface.position, r);
            float geometryHere = restirGiGeometry(hit.position, r);
            float jacobian = geometryThere > 0.0 ? geometryHere / geometryThere : 0.0;
            if (jacobian >= 0.1 && jacobian <= 10.0) {
                float here = restirGiTarget(hit, v, r);
                if (here > 0.0) {
                    float hereArea = here * geometryHere;
                    float thereArea = restirGiTarget(surface, neighborV, r) * geometryThere;
                    float denominator = r.M * thereArea + canonicalM * hereArea;
                    float weight = denominator > 0.0 ? share * r.M * thereArea / denominator * here * r.W
                                                       * clamp(jacobian, 1.0 / 3.0, 3.0) : 0.0;
                    weightSum += weight;
                    if (randomFloat(seed) * weightSum < weight) {
                        result.position = r.position;
                        result.normal = r.normal;
                        result.radiance = r.radiance;
                        result.age = r.age & 0xFFFFu;
                        keptTarget = here;
                        keptNeighbor = (r.age & GI_SEEN) != 0u ? 0xFFFFFFFEu : n;  // seen there: no ray needed
                    }
                }
            }
        }
    }
    float canonicalWeight = canonicalMis * canonicalHere * canonical.W;
    weightSum += canonicalWeight;
    float correction = 1.0;
    if (randomFloat(seed) * weightSum < canonicalWeight) {
        result.position = canonical.position;
        result.normal = canonical.normal;
        result.radiance = canonical.radiance;
        result.age = canonical.age;
        keptTarget = canonicalHere;
        if (scene.restirGiSpatialVisibility != 0) {
            correction = restirGiSpatialCanonicalMis(canonical, canonicalArea, canonicalM, mSum, pixel, start, used,
                                                     wanted, seed) / canonicalMis;
        }
    } else if (scene.restirGiSpatialVisibility != 0 && keptNeighbor < 0xFFFFFFFEu) {
        // A kept neighbor sample: its own surface may not see it (from that pixel's history)
        ivec2 neighbor = pixel + restirNeighborOffset(keptNeighbor, start, scene.restirGiSpatialRadius);
        if (!restirGiVisible(unpackRestirSurface(restirSurfaces[restirIndex(neighbor, false)]), result.position,
                             result.normal, seed)) {
            correction = 0.0;
        }
    }
    result.W = keptTarget > 0.0 && weightSum > 0.0 ? weightSum * correction / keptTarget : 0.0;
    result.M = mSum;
    giReservoirs[ownIndex] = result;
}

// RESTIR_PASS = 3: ReSTIR GI's shading. Adds the pixel's kept GI sample to the image: BRDF(x1) * cos * Lo * W. The
// first surface is rebuilt from the stored camera ray's hit exactly as the image pass had it (its textures at full
// precision; the packed RestirSurface would round the albedo and roughness). A sample from another pixel or frame
// gets a visibility ray; if blocked, it adds nothing and is dropped (W = 0), so the next frame doesn't reuse it.
void restirGiShade(ivec2 pixel, ivec2 size) {
    uint index = restirIndex(pixel, false);
    GiReservoir r = giReservoirs[index];
    if (!(r.W > 0.0)) {
        return;
    }
    uint seed = pixelSeed(pixel);
    startPathSamples(pixel, 0u);
    vec3 direction = sampleCameraRay(pixel, size, seed);
    Intersection intersection;
    vec3 tint;
    if (!loadPrimaryHit(pixel, seed, intersection, direction, tint)) {
        return;
    }
    Hit hit = hitFromIntersection(intersection, direction, 0.0, scene.pixelSpreadAngle);
    tiltTowardsViewer(hit, direction);
    if ((r.age & GI_SEEN) == 0u && !restirGiVisible(hit, r.position, r.normal, seed)) {
        giReservoirs[index].W = 0.0;
        return;
    }
    // From where the bounce ray started: off the surface, on the side it went to
    float side = dot(r.position - hit.position, hit.geometricNormal);
    vec3 l = normalize(r.position - offsetRay(hit.position, side < 0.0 ? -hit.geometricNormal : hit.geometricNormal));
    float pdf;
    vec3 light = evaluateBrdfWorld(hit, hit.normal, -direction, l, pdf) * abs(dot(hit.normal, l)) * r.radiance * r.W
                 * tint;
    if (FOG != 0) {
        // The image pass's camera ray gets to the surface with the fog's transmittance; scattered, its path has no GI.
        // (Up to just before the surface: a shadow ray would count it as blocking)
        bool crossedGlass, crossedSolidGlass;
        light *= shadowTransmittance(scene.cameraPosition.xyz, direction, intersection.t * 0.999, -1, seed,
                                     mediumAt(scene.cameraPosition.xyz), crossedGlass, crossedSolidGlass);
    }
    // As the image pass's: one of samplesPerPixel paths, and the running average when accumulating
    light /= float(scene.samplesPerPixel);
    if (scene.accumulate != 0 && scene.accumulatedFrames > 0) {
        light /= float(scene.accumulatedFrames + 1);
    }
    if (any(isnan(light)) || any(isinf(light))) {
        return;
    }
    imageStore(radianceImage, pixel, imageLoad(radianceImage, pixel) + vec4(light, 0.0));
}

// Debug view "ReSTIR light": the kind of light each pixel's sample is on. Glowing triangle: orange, punctual light:
// purple, sky: blue, none found: dark red, blocked (W = 0, set by the image pass's shadow ray): black. Grey: no ReSTIR.
vec3 restirDebugLight(ivec2 pixel) {
    if (scene.restirDi == 0) {
        return vec3(0.05);
    }
    Reservoir r = reservoirs[restirIndex(pixel, false)];
    if (r.light == RESTIR_NOT_USED) {
        return vec3(0.05);
    }
    uint kind = r.light >> 30;
    if (kind == LIGHT_KIND_NONE) {
        return vec3(0.3, 0.0, 0.0);
    }
    if (!(r.W > 0.0)) {
        return vec3(0.0);
    }
    return kind == LIGHT_KIND_TRIANGLE ? vec3(1.0, 0.5, 0.1) : kind == LIGHT_KIND_PUNCTUAL ? vec3(0.7, 0.2, 1.0)
                                                                                         : vec3(0.2, 0.5, 1.0);
}

// Debug view "ReSTIR M": how many candidates each pixel's reservoir stands for, relative to one frame's (log scale):
// red = this frame's only (no history, no neighbors), through yellow and green to blue = 64 x. Grey: no ReSTIR there.
vec3 restirDebugM(ivec2 pixel) {
    if (scene.restirDi == 0) {
        return vec3(0.05);
    }
    Reservoir r = reservoirs[restirIndex(pixel, false)];
    if (r.light == RESTIR_NOT_USED) {
        return vec3(0.05);
    }
    float t = clamp(log2(max(r.M, 1.0) / max(restirFreshCount(), 1.0)) / 6.0, 0.0, 1.0);
    return clamp(abs(fract(t * 0.66 + vec3(0.0, 2.0, 1.0) / 3.0) * 6.0 - 3.0) - 1.0, 0.0, 1.0);  // hue: red to blue
}

void main() {
    if (CACHE_UPDATE_PASS != 0) {
        updateCache();
        return;
    }
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(radianceImage);
    if (RESTIR_PASS == 4) {
        restirGiTemporalPass(pixel, pixel.x < size.x && pixel.y < size.y);  // all threads: a group barrier inside
        return;
    }
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;  // the last tiles can stick out past the image edge
    }
    if (RESTIR_PASS == 1) {
        restirPass(pixel, size);
        return;
    }
    if (RESTIR_PASS == 2) {
        restirSpatial(pixel, size);
        return;
    }
    if (RESTIR_PASS == 3) {
        restirGiShade(pixel, size);
        return;
    }
    if (RESTIR_PASS == 5) {
        restirGiSpatial(pixel, size);
        return;
    }

    uint seed = pixelSeed(pixel);

    if (scene.debugView == 12 || scene.debugView == 13) {
        imageStore(radianceImage, pixel, vec4(scene.debugView == 12 ? restirDebugM(pixel) : restirDebugLight(pixel), 1.0));
        return;
    }
    if (scene.debugView != 0) {
        vec3 color = debugColor(cameraRayDirection(vec2(pixel) + 0.5, size), seed);
        imageStore(radianceImage, pixel, vec4(color, 1.0));
        return;
    }

    vec3 color = vec3(0.0);
    float fogAmount = 0.0;
    for (uint s = 0; s < scene.samplesPerPixel; s++) {
        startPathSamples(pixel, s);
        vec3 direction = sampleCameraRay(pixel, size, seed);
        // DLSS gets one sample per pixel anyway: the first path writes the guides. The RESTIR_PASS traced the
        // first sample's camera ray.
        cameraRayFog = 0.0;
        color += tracePath(scene.cameraPosition.xyz, direction, seed, s == 0,
                           s == 0 && (scene.restirDi != 0 || scene.restirGi != 0));
        fogAmount += cameraRayFog;
    }
    if (guidesRetrace) {
        // the first sample's camera ray again (as above)
        uint guideSeed = pixelSeed(pixel);
        startPathSamples(pixel, 0u);
        vec3 direction = sampleCameraRay(pixel, size, guideSeed);
        storeMirrorGuides(pixel, direction, guideSeed);
    }
    color /= float(scene.samplesPerPixel);
    fogAmount /= float(scene.samplesPerPixel);

    // Running average: the n-th frame gets weight 1/(n+1), so every frame counts equally.
    if (scene.accumulate != 0 && scene.accumulatedFrames > 0) {
        vec3 previous = imageLoad(radianceImage, pixel).rgb;
        color = mix(previous, color, 1.0 / float(scene.accumulatedFrames + 1));
        fogAmount = mix(imageLoad(fogAmountImage, pixel).r, fogAmount, 1.0 / float(scene.accumulatedFrames + 1));
    }
    imageStore(fogAmountImage, pixel, vec4(fogAmount));
    // Stays linear and unbounded. Exposure and tone mapping only affect the displayed image (display.comp),
    // so changing them does not restart accumulation.
    imageStore(radianceImage, pixel, vec4(color, 1.0));
}
