#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_image_load_formatted : require  // hdrImage: no format qualifier

// Display pass: exposure and tone mapping. Turns the linear HDR image (path traced, or DLSS's output) into the
// 8-bit image that gets blitted to the swapchain. Kept out of the trace shader so that whatever sits between
// the two (DLSS) gets linear, unbounded input. One thread per output pixel, in 8x8 tiles.
//
// Also draws the guide debug views: the DLSS input images exactly as the trace shader wrote them.
layout(local_size_x = 8, local_size_y = 8) in;

// The radiance image (RGBA32F) or DLSS's output (RGBA16F): read without a format qualifier
layout(binding = 0) uniform readonly image2D hdrImage;
layout(binding = 1, rgba8) uniform writeonly image2D displayImage;
// Automatic exposure, measured by exposure.comp from this frame's HDR image just before this pass
// (only the multiplier is needed here; the histograms before it are skipped: 2 x 256 uints)
layout(binding = 2, scalar) readonly buffer ExposureState {
    uint exposureHistograms[512];
    float measuredExposure;
};
// DLSS inputs, render size (see the trace shader)
layout(binding = 3, r32f) uniform readonly image2D linearDepthImage;
layout(binding = 4, rg16f) uniform readonly image2D motionVectorImage;
layout(binding = 5, rgba16f) uniform readonly image2D diffuseAlbedoImage;
layout(binding = 6, rgba16f) uniform readonly image2D specularAlbedoImage;
layout(binding = 7, rgba16f) uniform readonly image2D normalRoughnessImage;
layout(binding = 8, r16f) uniform readonly image2D specularHitDistanceImage;
layout(binding = 9, rgba16f) uniform readonly image2D historyImage;  // last frame's diffuse albedo
layout(binding = 10, rgba32f) uniform readonly image2D radianceImage;  // the trace shader's output, render size; alpha: fog

// Must match DisplayPushConstants in Renderer.h
layout(push_constant) uniform DisplaySettings {
    float exposure;     // manual multiplier, or the compensation (2^stops) on top of the measured exposure
    uint autoExposure;  // 1 = also multiply by measuredExposure
    uint toneMapping;   // 0 = clamp, 1 = ACES filmic curve
    uint view;          // what to show, see the constants below
    float farDistance;  // the depth of sky pixels
    float grainStrength;  // fog grain: 0 = off, else how far it moves a pixel's brightness (see fogGrain)
    float grainSize;      // in output pixels
    uint frame;           // a new grain pattern every frame
    ivec4 outlineRect;    // the editor's selection: where selectionMask was written (x0, y0, x1, y1); empty: none
} display;

// The editor's selection (shaders/selection.comp): 1 where the first surface is selected, inside outlineRect
layout(binding = 11, r8) uniform readonly image2D selectionMask;

// Must match DisplayView in Renderer.h
const uint VIEW_COLOR = 0;
const uint VIEW_PASS_THROUGH = 1;  // a trace shader debug view: values as they are
const uint VIEW_DEPTH = 2;
const uint VIEW_MOTION_VECTORS = 3;
const uint VIEW_DIFFUSE_ALBEDO = 4;
const uint VIEW_SPECULAR_ALBEDO = 5;
const uint VIEW_NORMALS = 6;
const uint VIEW_ROUGHNESS = 7;
const uint VIEW_SPECULAR_HIT_DISTANCE = 8;
const uint VIEW_REPROJECTION_ERROR = 9;

// Squeezes unbounded brightness into [0, 1] with a film-like S-curve instead of clipping it.
// (Krzysztof Narkowicz's fit of the ACES curve)
vec3 toneMapACES(vec3 x) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Distances of any size as a grey level: 1 m -> 0.17, 5 m -> 0.5, 50 m -> 0.9. The sky (far) shows light blue.
vec3 distanceColor(float d) {
    if (d >= display.farDistance) {
        return vec3(0.4, 0.6, 1.0);
    }
    return vec3(d / (d + 5.0));
}

// Last frame's diffuse albedo at a (fractional) pixel position, blended between the 4 nearest pixels
vec3 sampleHistory(vec2 position, ivec2 size) {
    vec2 p = position - 0.5;
    ivec2 i = ivec2(floor(p));
    vec2 f = p - vec2(i);
    ivec2 last = size - 1;
    vec3 c00 = imageLoad(historyImage, clamp(i, ivec2(0), last)).rgb;
    vec3 c10 = imageLoad(historyImage, clamp(i + ivec2(1, 0), ivec2(0), last)).rgb;
    vec3 c01 = imageLoad(historyImage, clamp(i + ivec2(0, 1), ivec2(0), last)).rgb;
    vec3 c11 = imageLoad(historyImage, clamp(i + ivec2(1, 1), ivec2(0), last)).rgb;
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

vec3 guideColor(ivec2 pixel) {
    switch (display.view) {
        case VIEW_DEPTH:
            return distanceColor(imageLoad(linearDepthImage, pixel).r);
        case VIEW_MOTION_VECTORS: {
            // Grey = not moving. Red/green: moved left/up since the last frame (the point was further right/down
            // before), full color at 16 pixels per frame.
            vec2 motion = imageLoad(motionVectorImage, pixel).rg;
            return vec3(0.5 + motion / 32.0, 0.5);
        }
        case VIEW_DIFFUSE_ALBEDO:
            return imageLoad(diffuseAlbedoImage, pixel).rgb;
        case VIEW_SPECULAR_ALBEDO:
            return imageLoad(specularAlbedoImage, pixel).rgb;
        case VIEW_NORMALS:
            return imageLoad(normalRoughnessImage, pixel).rgb * 0.5 + 0.5;
        case VIEW_ROUGHNESS:
            return vec3(imageLoad(normalRoughnessImage, pixel).a);
        case VIEW_SPECULAR_HIT_DISTANCE: {
            float d = imageLoad(specularHitDistanceImage, pixel).r;
            return d > 0.0 ? distanceColor(d) : vec3(0.0);  // black: unknown (the diffuse layer was picked)
        }
        case VIEW_REPROJECTION_ERROR: {
            // Where this point was last frame, according to the motion vectors; last frame's albedo there should
            // be this frame's albedo. Off-screen last frame: blue. Mismatch: bright (4x the difference).
            ivec2 size = imageSize(diffuseAlbedoImage);
            vec2 previous = vec2(pixel) + 0.5 + imageLoad(motionVectorImage, pixel).rg;
            if (any(lessThan(previous, vec2(0.0))) || any(greaterThanEqual(previous, vec2(size)))) {
                return vec3(0.0, 0.0, 0.5);
            }
            vec3 current = imageLoad(diffuseAlbedoImage, pixel).rgb;
            return abs(sampleHistory(previous, size) - current) * 4.0;
        }
    }
    return vec3(1.0, 0.0, 1.0);
}

uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// How much fog the camera sees around an output pixel: the radiance image's alpha (a share of camera rays,
// each 0 or 1 in a frame of the DLSS modes), averaged over 5x5 render pixels so the grain fades in smoothly.
float fogAmountAround(ivec2 renderPixel) {
    ivec2 last = imageSize(radianceImage) - 1;
    float sum = 0.0;
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            sum += imageLoad(radianceImage, clamp(renderPixel + ivec2(x, y), ivec2(0), last)).a;
        }
    }
    return sum / 25.0;
}

// Fog grain: a look, not light. DLSS removes the path tracer's noise, which in fog looked like film grain; this adds
// grain back where the camera sees fog, after DLSS and tone mapping. A new random pattern every frame, in cells of
// grainSize output pixels, as a brightness change of up to +-grainStrength (more often small: two random numbers
// added), the same for the three colors.
vec3 fogGrain(vec3 color, ivec2 pixel, ivec2 renderPixel) {
    float fog = fogAmountAround(renderPixel);
    if (fog <= 0.0) {
        return color;
    }
    uvec2 cell = uvec2(vec2(pixel) / display.grainSize);
    uint h = hash(cell.x ^ hash(cell.y ^ hash(display.frame)));
    float noise = float(h & 0xFFFFu) / 65535.0 + float(h >> 16) / 65535.0 - 1.0;  // -1..1, peaked at 0
    return clamp(color * (1.0 + display.grainStrength * fog * noise), 0.0, 1.0);
}

float selectedAt(ivec2 pixel) {
    ivec4 r = display.outlineRect;
    if (pixel.x < r.x || pixel.y < r.y || pixel.x >= r.z || pixel.y >= r.w) {
        return 0.0;
    }
    return imageLoad(selectionMask, pixel).r;
}

// The selection's outline: 2 pixels wide just outside the selected pixels (none: 0)
float outlineAt(ivec2 pixel) {
    ivec4 r = display.outlineRect;
    if (r.x >= r.z || pixel.x < r.x - 2 || pixel.y < r.y - 2 || pixel.x >= r.z + 2 || pixel.y >= r.w + 2 ||
        selectedAt(pixel) > 0.5) {
        return 0.0;
    }
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            if (abs(x) + abs(y) <= 2 && (x != 0 || y != 0) && selectedAt(pixel + ivec2(x, y)) > 0.5) {
                return 1.0;
            }
        }
    }
    return 0.0;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(displayImage);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;  // the last tiles can stick out past the image edge
    }

    // Render-size images (DLSS inputs, debug views): the render pixel this output pixel falls into
    ivec2 renderPixel = pixel * imageSize(radianceImage) / size;
    vec3 color;
    if (display.view >= VIEW_DEPTH) {
        color = guideColor(renderPixel);
    } else if (display.view == VIEW_PASS_THROUGH) {
        color = imageLoad(radianceImage, renderPixel).rgb;
    } else {
        // DLSS output or the radiance image, both at output size here
        color = imageLoad(hdrImage, pixel).rgb;
        color = color * display.exposure * (display.autoExposure != 0 ? measuredExposure : 1.0);
        if (display.toneMapping != 0) {
            color = toneMapACES(color);
        }
        if (display.grainStrength > 0.0) {
            color = fogGrain(color, pixel, renderPixel);
        }
    }
    if (outlineAt(pixel) > 0.0) {
        color = vec3(1.0, 0.33, 0.02);  // orange (linear)
    }
    // Linear values; values above 1 are clamped when stored as 8 bit. The blit to the sRGB swapchain encodes them.
    imageStore(displayImage, pixel, vec4(color, 1.0));
}
